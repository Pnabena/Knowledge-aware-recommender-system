se},"evidence":{"source":"frozen-model","summary":{"business_id":"C2XXTlG9rIqLjjJrn2ODVA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2325,"mm_rank":1884,"target_category_support_fraction":1.0,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Breakfast & Brunch","historical_business_count":1},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Southern","historical_business_count":2},{"category":"American (Traditional)","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Breakfast & Brunch, Cajun/Creole, Restaurants","shared_category_count":4},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"C2XXTlG9rIqLjjJrn2ODVA","review_id":"Ni7woSRjz8m7kLVXDPgUTg","date":"2018-01-12T14:55:15","stars":4,"text_representativeness":0.9258180856704712,"text_excerpt":"Stopped in for the \"$2 Breakfast\" they have advertised so well along the Broad Ave! I decided to give it a try since it's on my way to work and a hot breakfast for only $2! Why not! Customer service was excellent! I was greeted when I walked in and made to feel very comfortable considering it was 7 am! My order came out quick and in a hurry as well. As far as the food: standard hot breakfast with eggs, grits, toast, and sausage. The eggs were pretty standard scrambled eggs. Toast was not fully toasted. Sausage was nice since they offered a piece of smoke sausage and a sausage patty which was a plus. Grits.... I'm a stickler for grits.... they were a bit loose for my liking and lacked any ..."},{"business_id":"C2XXTlG9rIqLjjJrn2ODVA","review_id":"OT8z7aNoarI9fxTjz_NHkg","date":"2016-08-19T16:36:04","stars":5,"text_representativeness":0.9119202494621277,"text_excerpt":"I stopped in on a Friday morning to try the $2 breakfast. My food was ready in about 5 min. Everything was tasty. Total spent was $3.48 including some orange juice. Can't beat it! Give them a try before you head to work."},{"business_id":"C2XXTlG9rIqLjjJrn2ODVA","review_id":"LpBcD3hIoZBa2Ic15bz1zw","date":"2016-06-07T21:26:58","stars":4,"text_representativeness":0.8979172110557556,"text_excerpt":"The food is fresh, tastes great. They are fast in preparing it and give generous portions. The prices are exceptional especially when considering how much food you get. I go here at least once a week for lunch and I have tried a few different things and everything tastes great. The bathrooms are clean."}],"visual":[{"business_id":"C2XXTlG9rIqLjjJrn2ODVA","photo_id":"32L2U-YdTmEVuSdFbvNfNQ","label":"food","image_url":"/photos/32L2U-YdTmEVuSdFbvNfNQ.jpg","visual_representativeness":1.0000001192092896}]},"notebook_case":null}
