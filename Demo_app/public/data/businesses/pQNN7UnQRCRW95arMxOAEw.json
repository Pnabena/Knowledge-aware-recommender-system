704987,"rank_movement":-44,"has_visual_feature":true,"name":"Yogurtland New Orleans","address":"4903 Prytania St","city":"New Orleans","state":"LA","postal_code":"70115","stars":4.5,"review_count":81,"categories":["Ice Cream & Frozen Yogurt","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"pQNN7UnQRCRW95arMxOAEw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":689,"mm_rank":733,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"pQNN7UnQRCRW95arMxOAEw","review_id":"ywLQZq6YW2C08Vz8HaoQwA","date":"2013-06-04T17:23:55","stars":4,"text_representativeness":0.9436851739883423,"text_excerpt":"I love frozen yogurt. It has become my go to after dinner snack. There are so many places to go get your froyo fix. Yogurtland is my favorite out of all of them in the area (Pinkberry, Pure, etc.) because it is self serve. They also give you free samples so you can try as many flavors as you want before making the BIG DECISION. They have a great selection of toppings: all manners of fruit and berries, condensed milk, honey, chocolate drizzle drizzle, candies, granola, brownie bites, you name it. My one gripe is that they usually have way more \"sweet\" flavors than \"tart\" flavors as opposed to Pinkberry, but, the self-serve aspect of it makes up for that in a second. OH! Added bonus... they..."},{"business_id":"pQNN7UnQRCRW95arMxOAEw","review_id":"hjT9ByrJxDEcZTSF9_ZHxw","date":"2012-12-01T22:37:46","stars":5,"text_representativeness":0.9419514536857605,"text_excerpt":"As far as small frozen yogurt shops go, this place is the best! Overlooking the chain-restaurant status it has, Yogurtland boasts a great number of flavors that change almost daily to offer something different for those of us that (ahem) \"frequent the join.\" Yogurtland has an amazing ability to really get the flavors just right. How on earth do they make a yogurt that taste like a Nutter Butters, Pumpkin Pie and Egg Nogg? HOW? It doesn't matter, but they do, and It's bliss. Also, every visit begins with a smiley employee handing you at least five small sample cups with which you can make the perfect yogurt choice! As much as you want of what you want, and you controll all the toppings- no..."},{"business_id":"pQNN7UnQRCRW95arMxOAEw","review_id":"D8xwgd7hShJMfEt6Hyde9w","date":"2012-08-08T02:55:05","stars":5,"text_representativeness":0.9252753257751465,"text_excerpt":"This place instantly makes me happy! I walk through the doors with a smile on my face, more pep in my step, maybe even a bounce or two. The Land of Yogurt never disappoints. I'm not a fan of tart yogurt, so Yogurtland's sweet and creamy flavors really hit the spot. The flavors rotate every so often, which I think is kind of fun. The toppings are usually the same, but I think they have the largest and freshest selection. I love it all, especially the mochi. It's self serve and you pay by weight. It's great because you are in control of your yogurt to topping ratio!"}],"visual":[{"business_id":"pQNN7UnQRCRW95arMxOAEw","photo_id":"IpOdSt8g2y_mNzws2Xux1g","label":"food","image_url":"/photos/IpOdSt8g2y_mNzws2Xux1g.jpg","visual_representativeness":0.9465608596801758},{"business_id":"pQNN7UnQRCRW95arMxOAEw","photo_id":"FRKHVYY427Ff1XkZ-ISCdg","label":"food","image_url":"/photos/FRKHVYY427Ff1XkZ-ISCdg.jpg","visual_representativeness":0.9426743388175964},{"business_id":"pQNN7UnQRCRW95arMxOAEw","photo_id":"YKjUuUa_hGMJ0TxZcAkkqA","label":"food","image_url":"/photos/YKjUuUa_hGMJ0TxZcAkkqA.jpg","visual_representativeness":0.9388026595115662},{"business_id":"pQNN7UnQRCRW95arMxOAEw","photo_id":"GUnr2k2OZD58TUFpGO_3wQ","label":"food","image_url":"/photos/GUnr2k2OZD58TUFpGO_3wQ.jpg","visual_representativeness":0.9327214956283569},{"business_id":"pQNN7UnQRCRW95arMxOAEw","photo_id":"Cqafz_qizSjYHP0UQeA78g","label":"food","image_url":"/photos/Cqafz_qizSjYHP0UQeA78g.jpg","visual_representativeness":0.8925014734268188}]},"notebook_case":null}
