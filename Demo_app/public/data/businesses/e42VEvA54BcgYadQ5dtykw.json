arget_category_support_fraction":0.3333333333333333,"selected_image_count":0,"label_diversity":0,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Sandwiches","historical_business_count":0},{"category":"Pizza","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"e42VEvA54BcgYadQ5dtykw","review_id":"VXZ2kbWcuNF4n3a1eKmF-A","date":"2014-04-19T18:42:03","stars":4,"text_representativeness":0.9435920119285583,"text_excerpt":"Yummy pizza. Really perfect. I went at about 5 PM on a Thursday - only a few other folks there at this time. I ordered a custom pizza - pepperoni, sun dried tomatoes, and basil. All of it was great. The service was friendly and accomodating. I like the ambience too here, it's fun to watch Magazine Street shoppers stroll by."},{"business_id":"e42VEvA54BcgYadQ5dtykw","review_id":"GzsxpEYd3Cd7aUU_CAplQw","date":"2011-08-12T14:25:27","stars":5,"text_representativeness":0.9420362710952759,"text_excerpt":"I love Theo's Pizza!!! This is probably my favorite pizza place around. The thin crispy crust makes me a very happy eater. I enjoy the wide range of interesting combinations they offer. The Eccentric & the Spicy Mexican are two of my favorites but my usual fix is the Hippy with either chicken or meatballs added. I always get a side of their tasty marinara to dip my crust into; although often it isn't needed I still love the sauce and will just drink it! I also really love their ice as it goes so well with their iced tea and I think it might be the best ice in NOLA and I want to find out what kind of machine makes it as I want one. They also have good beer and wine specials. The sandwiches..."},{"business_id":"e42VEvA54BcgYadQ5dtykw","review_id":"32NJvu8KDsg1fJFnVSgt-w","date":"2011-07-22T20:00:04","stars":4,"text_representativeness":0.9361606240272522,"text_excerpt":"Love the pizza here. It is equivalent to other great spots I've found across the US. The place is clean, staff are friendly, and the food is the star. Skip the chain spots and go for authentic gourmet pizza that tastes great. Another fine Magazine St. restaurant."}],"visual":[]},"notebook_case":null}
