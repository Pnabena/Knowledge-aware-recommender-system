tHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","review_id":"j-1fjwZunLrImktQW1aoAg","date":"2019-04-30T21:11:10","stars":5,"text_representativeness":0.9316025376319885,"text_excerpt":"I come here often, and it never disappoints. A nice place to get a good meal. This place is a very small walk-up stand, but the food is really good. Small menu, but food has big flavor. From their chicken plates, sandwiches and poboys, and other small items, you can't go wrong. items, I truly recommend this place. They also have a variety of delicious snowballs to choose from as well."},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","review_id":"B2Rs2ILSZJ4HPBSwkrZAgw","date":"2021-02-24T19:32:57","stars":4,"text_representativeness":0.9199336767196655,"text_excerpt":"It might be the Westbanker in me that loves a good roadside food shack, but this place is pretty legit. Came here for some grub before we started the whole house float thingy. Food was perfect! I got the cheeseburger on French and it is pretty tasty. The cheese fries is fries with nacho cheese sauce, but if you don't mind it like myself, you will enjoy yourself. Great food and pretty cheap prices equals a place I plan on going visit again."},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","review_id":"pljwb0Di7h35sxaAs5uJkg","date":"2018-07-13T04:59:01","stars":5,"text_representativeness":0.9159363508224487,"text_excerpt":"I loveeee red rooster! The lines are always outrageous and the service is subpar but their food is wonderful! I mostly go here for their nachos though. They have my favorite cheese of all the snowball stands in the city! They also have a nice area with tables set up for people to hang out and they have good music playing. I come here all the time since they are year round. The hot sausage on bun is delicious too!"}],"visual":[{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","photo_id":"-SYAInV7AuCr87jzrS3Seg","label":"food","image_url":"/photos/-SYAInV7AuCr87jzrS3Seg.jpg","visual_representativeness":0.9457435011863708},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","photo_id":"xdkrh5gajdbNiQiy62ZNHw","label":"food","image_url":"/photos/xdkrh5gajdbNiQiy62ZNHw.jpg","visual_representativeness":0.9435044527053833},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","photo_id":"jnMZaZsjZNBUEZmkHllL1Q","label":"food","image_url":"/photos/jnMZaZsjZNBUEZmkHllL1Q.jpg","visual_representativeness":0.9293550252914429},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","photo_id":"HARCxByBuCaMCxh1-2stGw","label":"food","image_url":"/photos/HARCxByBuCaMCxh1-2stGw.jpg","visual_representativeness":0.8299112915992737},{"business_id":"8k3vSF9F0sJItv7ZFDFfmg","photo_id":"BPhKS01DCal8jpW-RUiTlg","label":"food","image_url":"/photos/BPhKS01DCal8jpW-RUiTlg.jpg","visual_representativeness":0.8247576355934143}]},"notebook_case":null}
