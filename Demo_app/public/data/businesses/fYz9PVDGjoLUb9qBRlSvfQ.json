target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Local Flavor","historical_business_count":0},{"category":"Shaved Ice","historical_business_count":0},{"category":"Desserts","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"fYz9PVDGjoLUb9qBRlSvfQ","review_id":"OKEaUg1ZOEUu4Av2XjRyow","date":"2018-09-04T02:59:44","stars":4,"text_representativeness":0.9455879926681519,"text_excerpt":"I like Ike's! David and I are trying different snowball stands around town and he suggested this one that I had never heard of. Ike's is right by the Burger King/MoPho strip mall by City Park and there was no crowd when we were here early on a Friday evening. There's a lot of seating area with tables and they have a nice selection of different snowball flavors and ice cream and also offer boudin, for some reason. I got a wedding cake snowball and David got pralines and cream. I have to say, I really liked the fact that they flood the ice with syrup. It was practically spilling out of the cup, and when it comes to syrup, you can't over do it. The ice was nice and fine and the flavor was gr..."},{"business_id":"fYz9PVDGjoLUb9qBRlSvfQ","review_id":"UB3e4-MZ4Yup5Uh-eHX9Ww","date":"2012-02-05T21:54:27","stars":4,"text_representativeness":0.9414224028587341,"text_excerpt":"If there's one thing you can never have too many of, it's snowball stands in New Orleans. Upon the urging of my wife, who is a self proclaimed snowball connisseur, I stopped at Ike's Snowballs this afternoon to kill her craving. Located at 520 City Park Avenue, this newly constructed business resides next to the strip mall that houses Burger King and Subway. Being on the extreme Northern Border of Mid City, this location will prove perfect for people residing in Lakeview (South), the Bayou Saint John area and for Delgado students. The facilities are spotless inside and there is plently of availble tables outside to sit down and enjoy your snowball. This will prove especially helpful if yo..."},{"business_id":"fYz9PVDGjoLUb9qBRlSvfQ","review_id":"Y6WUtgWhhMIGeKdxuqNMbA","date":"2018-02-20T16:57:29","stars":4,"text_representativeness":0.9396400451660156,"text_excerpt":"This place has some pretty good snowballs. It isn't my favorite in town, but for its spot and convenience it's great. After basically any activity in City Park we stop here after for a refreshing snowball. We always get smalls because the serving is generous and we can never even finish it all. They have a lot of flavors, friendly staff, and they don't skimp on the syrup. In fact they'll give you more syrup free of charge. Next time you're at city park, stop here after. Open year round, cash only."}],"visual":[{"business_id":"fYz9PVDGjoLUb9qBRlSvfQ","photo_id":"HPFLlckPPFzltsY7b8XBZA","label":"food","image_url":"/photos/HPFLlckPPFzltsY7b8XBZA.jpg","visual_representativeness":0.9233724474906921},{"business_id":"fYz9PVDGjoLUb9qBRlSvfQ","photo_id":"YQDKlpf7dpKKKVkeiLrU2w","label":"food","image_url":"/photos/YQDKlpf7dpKKKVkeiLrU2w.jpg","visual_representativeness":0.9233723878860474}]},"notebook_case":null}
