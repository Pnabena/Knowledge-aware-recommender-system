ual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee Roasteries","historical_business_count":0},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"rN3oijuukag6Yp9xfHdMVg","review_id":"oEfLpv5j6c534hfBMgzLWg","date":"2016-05-15T16:49:19","stars":5,"text_representativeness":0.9253021478652954,"text_excerpt":"Joi's review of the iced coffee here was part of my motivation in getting myself over to St. Roch Market and I am so glad that I made the trip. I am an iced coffee addict and I have become somewhat picky in what I like and expect from a tasty brew. I stepped into St. Roch and as soon as I saw the line for Coast Roast, I knew that Joi's review was dead on. I ordered a large iced coffee which came to a reasonable $4.25 or so. I like that their large is actually LARGE. Give me something that is going to last me a while. I added some half and half and what I had was one of the best iced coffees I have ever enjoyed. Nice and rich, strong without making me jittery and bonus points for the ice l..."},{"business_id":"rN3oijuukag6Yp9xfHdMVg","review_id":"T-zGsApHaoYMXmDImsHQEg","date":"2020-01-30T18:35:47","stars":4,"text_representativeness":0.9231795072555542,"text_excerpt":"Just stopped in for a much needed coffee. It's located inside St. Roch Market. Coffee was good. Staff was friendly, and they also sell cookies and such."},{"business_id":"rN3oijuukag6Yp9xfHdMVg","review_id":"lNEICzhmQMcZZjL6kTWxcg","date":"2019-02-18T15:37:48","stars":5,"text_representativeness":0.9138859510421753,"text_excerpt":"Coast Roast Coffee is situated within the St. Roch Market and hot-damn their coffee is delicious. For those of us who work out of coffee shops or do meetings frequently in coffee shops, this needs to be on your rotation. I've always had a friendly encounter when I've grabbed a cup of coffee. Their iced lattes are some of the best that I've had. (They also make a great boomerang for you fellow social media junkies) If I lived closer to here I'd grab coffee from here way more often! The wifi for the market is also really strong."}],"visual":[{"business_id":"rN3oijuukag6Yp9xfHdMVg","photo_id":"A-9Ltzw9WA5St8uWhrZS2g","label":"outside","image_url":"/photos/A-9Ltzw9WA5St8uWhrZS2g.jpg","visual_representativeness":0.945396900177002},{"business_id":"rN3oijuukag6Yp9xfHdMVg","photo_id":"KspW7Mbs2I0q9fSnL913Sg","label":"drink","image_url":"/photos/KspW7Mbs2I0q9fSnL913Sg.jpg","visual_representativeness":0.9453967809677124}]},"notebook_case":null}
