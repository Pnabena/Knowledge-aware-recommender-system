3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":1470,"business_id":"_QYncK8LjXswVYZ_jv_q7A","nv_rank":608,"mm_rank":560,"nv_score":0.21899697184562683,"mm_score":0.26307767629623413,"rank_movement":48,"has_visual_feature":true,"name":"Good Time Sushi","address":"5315 Elysian Fields Ave","city":"New Orleans","state":"LA","postal_code":"70122","stars":4.0,"review_count":143,"categories":["Restaurants","Sushi Bars"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"_QYncK8LjXswVYZ_jv_q7A","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":608,"mm_rank":560,"target_category_support_fraction":0.5,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Sushi Bars","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"_QYncK8LjXswVYZ_jv_q7A","review_id":"SlPtKogmxP1rLF3q98OTFw","date":"2015-08-21T17:07:02","stars":5,"text_representativeness":0.9427602291107178,"text_excerpt":"Don't let the unassuming location fool you! This is a great sushi place! I had the \"Good Time roll\" and it was delicious. It it one of those premium-type rolls that are sufficient for a meal for one person, if that person is not sharing. It was like a rainbow roll only there were different colored roes on top and an awesome sauce. The service was good and there is a nice, little sushi bar/counter. The prices are quite reasonable. This is so close to me, I'm sure to be a regular visitor."},{"business_id":"_QYncK8LjXswVYZ_jv_q7A","review_id":"s1foVkrhyt0ETwem4bwdCg","date":"2018-02-08T18:50:22","stars":4,"text_representativeness":0.9426770806312561,"text_excerpt":"A nice little neighborhood sushi place with fresh options and good service. I've been here about 5 times now and enjoy the simple space and fresh offerings. I like the salmon Tata special with fresh salmon, avocado and ponzu sauce. Crabmeat salad with avocado is nice. Yesterday we had the rock n roll and volcano roll which were both very good. I like that their sauces are not too sweet like some places. It's byob here."},{"business_id":"_QYncK8LjXswVYZ_jv_q7A","review_id":"Mq2xe_v8PT2XeiD8RhMqbQ","date":"2016-03-14T16:53:57","stars":4,"text_representativeness":0.9407110214233398,"text_excerpt":"Sometimes you don't need all the frills and fluff. You just want some decent sushi. Good time is my go to neighborhood spot when I'm feeling lazy and don't feel like traveling to Metairie or any of my other favorite spots. It's not the best sushi I've ever had, but it works. I have little to complain about when I come here. It's fast, the prices are good, and the rolls are tasty. Their hibachi is pretty good too. My favorite thing oddly enough on the menu is the salad dressing. It's like crack. Give them a go, you won't be disappointed."}],"visual":[{"business_id":"_QYncK8LjXswVYZ_jv_q7A","photo_id":"iRuU9ByW6FpSCtDLiDpkew","label":"inside","image_url":"/photos/iRuU9ByW6FpSCtDLiDpkew.jpg","visual_representativeness":0.9035251140594482},{"business_id":"_QYncK8LjXswVYZ_jv_q7A","photo_id":"aTOGaOrMNgIQL8r2CT6MVw","label":"food","image_url":"/photos/aTOGaOrMNgIQL8r2CT6MVw.jpg","visual_representativeness":0.8797280788421631},{"business_id":"_QYncK8LjXswVYZ_jv_q7A","photo_id":"BunWV7WCQ_GENidEB1fIvA","label":"food","image_url":"/photos/BunWV7WCQ_GENidEB1fIvA.jpg","visual_representativeness":0.8545302748680115}]},"notebook_case":null}
