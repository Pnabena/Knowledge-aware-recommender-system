is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1655,"mm_rank":1852,"target_category_support_fraction":0.5,"selected_image_count":2,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Vegan","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","review_id":"tY1Y1XfYYn-zkUFU6Thgsw","date":"2020-01-09T21:06:23","stars":4,"text_representativeness":0.9315552711486816,"text_excerpt":"The staff was super friendly and passionate about their food and message and I had a great time talking to them while I was there. I do not eat out much anymore, but every once in a while I like to splurge at a vegan place. I came here and ordered the nacho platter, Nazarene potato plater, the Mac and cheese and barbecue cauliflower, the Judah burger, and the strawberry cake. First of all, I love how you can order the small or large version of their items, which makes things more affordable, and the small still give a very good amount of food. Now To the food itself. I very much enjoyed the cauliflower and mac, and the Judah burger. The cauliflower had a delicious bold barbecue sauce flav..."},{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","review_id":"y9hVYYyWJap4QVS2FzoOQg","date":"2020-10-16T00:57:22","stars":5,"text_representativeness":0.9239123463630676,"text_excerpt":"OMG. Holy y'all. This place is SO damn good!! My husband and I ordered the gf mac & cheese with the cauliflower and fries. We were both blown away with how delicious this meal was. The portions were huge, and the flavor was REAL. We can't wait to try it again."},{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","review_id":"mYr_f6d7JkqJ_FctIg2O3A","date":"2020-03-05T04:00:21","stars":5,"text_representativeness":0.9142920970916748,"text_excerpt":"I got the BBQ Cauliflower and Mac & Cheese. I give the cauliflower a solid 10. Flavor is amazing! I would order that cauliflower and just eat it with meat if I wanted to eat meat. The Mac & Cheese was good as well, but I have to note that it does not have the same flavor as real mac & cheese (as one shouldn't expect it to) It is still the same consistency and has a good taste. But don't expect to not know the difference between the real version and the vegan version. They do make the food to order so i recommend ordering over the phone in advance. I will definitely be coming back and trying other things!"}],"visual":[{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","photo_id":"LLYkZZwOpKHMsZWy0NmEIA","label":"food","image_url":"/photos/LLYkZZwOpKHMsZWy0NmEIA.jpg","visual_representativeness":0.858985424041748},{"business_id":"vmtqCFoBX9TzAoiLUEj5oA","photo_id":"u_gtjMVn3o8ZG8z9Ef8TWQ","label":"menu","image_url":"/photos/u_gtjMVn3o8ZG8z9Ef8TWQ.jpg","visual_representativeness":0.8589853048324585}]},"notebook_case":null}
