_id":"MwonUzoiUq0dpEVlIVBryw","nv_rank":864,"mm_rank":721,"nv_score":-0.2995559573173523,"mm_score":-0.05684758350253105,"rank_movement":143,"has_visual_feature":true,"name":"The Mill Nola","address":"1051 Annunciation St","city":"New Orleans","state":"LA","postal_code":"70130","stars":4.0,"review_count":109,"categories":["Restaurants","American (Traditional)","Southern"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"MwonUzoiUq0dpEVlIVBryw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":864,"mm_rank":721,"target_category_support_fraction":1.0,"selected_image_count":5,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"American (Traditional)","historical_business_count":2},{"category":"Southern","historical_business_count":2}],"history":[{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"MwonUzoiUq0dpEVlIVBryw","review_id":"WuJVFYcpjxmeVUDYePI3Rg","date":"2020-10-29T00:46:05","stars":5,"text_representativeness":0.9413167238235474,"text_excerpt":"Love having Brunch, Happy Hour or really any meal here because of the outdoor seating. The bartender on the weekends is awesome, and the food is different than other restaurant in the area. It's a great mix of Trinidad flair. The inside is very nice, and has TVs if you're a sports fan. The outside patio is a shared space with the Cotton Mill apartment complex, so it's a bit thin when people walk by, but I love the sunlight in good weather. The view is very local New Orleans with construction going on in the warehouse district, so you're picky about elegance - eat inside. Ha! They can accommodate small or large parties, and have a lot of different seating options, which means this place is..."},{"business_id":"MwonUzoiUq0dpEVlIVBryw","review_id":"qi8_xaW_o6jYfD9wluQw0A","date":"2020-11-29T18:50:08","stars":5,"text_representativeness":0.9336467385292053,"text_excerpt":"We made a last min pivot in our dining plans one night as we wanted to stay a bit closer to our hotel and we snagged up a table quickly, which was awesome. The place here is really beautiful! High ceilings, exposed brick, and so much pretty lighting make it feeling super cozy and inviting. The staff was super nice and gave us great recommendations. The burger bites are not your ordinary sliders and are a must order. The macaroni pie was a great comfort food moment. And damn, that shrimp and grits was incredibly flavorful. You MUST order the bread pudding or you're not LIVING your best life. It was such a damn good dessert. Love me some bread pudding that's not messing around. This place w..."},{"business_id":"MwonUzoiUq0dpEVlIVBryw","review_id":"T9vatETJfsaffvXxMImaVA","date":"2020-05-28T15:46:34","stars":4,"text_representativeness":0.9320576190948486,"text_excerpt":"Based on ambiance/decor and service, this place would definitely be 5+ stars. Super cool inside and our server, as well as management were extremely personable, polite, and attentive. The food and drinks were good, just a tad pricey (not overly so for New Orleans, but higher than plenty of other great places in the near immediate vicinity). We got a house salad which was different, fresh, and yummy; also tried the tuna tartare which was really awesome-very fresh, light, citrusy, and flavorful! My husband had a frozen drink, which was a good froze-not the best I've had. We also tried the bread pudding a la mode, which was divine! Our friends got shrimp and grits (looked awesome-she said it..."}],"visual":[{"business_id":"MwonUzoiUq0dpEVlIVBryw","photo_id":"7AvEDM2ZxVYi4c7BlKZeRQ","label":"food","image_url":"/photos/7AvEDM2ZxVYi4c7BlKZeRQ.jpg","visual_representativeness":0.9004524946212769},{"business_id":"MwonUzoiUq0dpEVlIVBryw","photo_id":"lLhlVb9ysgGrLdIwkTzmtw","label":"inside","image_url":"/photos/lLhlVb9ysgGrLdIwkTzmtw.jpg","visual_representativeness":0.8658268451690674},{"business_id":"MwonUzoiUq0dpEVlIVBryw","photo_id":"bHSJq9z2yM39dZakh3tWsg","label":"inside","image_url":"/photos/bHSJq9z2yM39dZakh3tWsg.jpg","visual_representativeness":0.8445821404457092},{"business_id":"MwonUzoiUq0dpEVlIVBryw","photo_id":"Xi7LeRSH_w6AqJz_4ciRig","label":"food","image_url":"/photos/Xi7LeRSH_w6AqJz_4ciRig.jpg","visual_representativeness":0.8293006420135498},{"business_id":"MwonUzoiUq0dpEVlIVBryw","photo_id":"kE9bJWo8t6FM8_0z59tf7w","label":"food","image_url":"/photos/kE9bJWo8t6FM8_0z59tf7w.jpg","visual_representativeness":0.8155209422111511}]},"notebook_case":null}
