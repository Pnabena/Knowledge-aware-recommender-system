w Orleans","state":"LA","postal_code":"70115","stars":4.0,"review_count":106,"categories":["Coffee & Tea","Ice Cream & Frozen Yogurt","Sandwiches","Restaurants","Food"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":696,"mm_rank":536,"target_category_support_fraction":0.6,"selected_image_count":3,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee & Tea","historical_business_count":1},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Sandwiches","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","review_id":"nHRIY4x6VjCBd9kOgBJoCg","date":"2009-12-05T19:07:40","stars":5,"text_representativeness":0.9372928142547607,"text_excerpt":"Their gelato is absolutely phenomenal. I first went there after coming back from a trip to Italy (gelato heaven). You can tell the quality of the ingredients. They do basics, like limon or chocolate, amazing. But they also shine in some of the more wild flavors like Creme Brulee. The only downside would be the cost--a typical scoop will cost around $4, but well worth it. I mean, if you really think about it, for what you get--that's like a capuccino at a coffee shop. There's so much more to this than a hot drink. I've had their sandwiches, too...great little muffaletta panini. A plus for the Magazine shop. I went to the French Quarter one and they scooped out my sorbetto, then weighed it ..."},{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","review_id":"NxpTBeciMMVyhWahovqcNA","date":"2010-03-23T03:46:40","stars":5,"text_representativeness":0.9294844269752502,"text_excerpt":"I've gotten gelato here, and its a close call as to who has better gelato: this place or Brocato's. Nevertheless, it is pretty damn good here. On my most recent trip, I ordered a panini. I wasn't expecting much, but damn, that was a good sandwich. The mozzarella cheese was a nice touch, and the bread was delicious. Definitely a must when in the Garden District."},{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","review_id":"9WpzMWLp8vIG9PSS9-poRg","date":"2013-04-22T16:28:16","stars":4,"text_representativeness":0.9273096323013306,"text_excerpt":"UMMMMMMM their soup and panini special is my JAM, yall. Fiance, fur child, and I had a very relaxing lunch outside. My panini was the one with the cheese and the pancetta, and I had their tomato basil soup. Although it took a bit longer to come out than I would have liked, I think there was only one girl working there so I don't blame her. The panini had wonderful, crusty bread and the flavor was perfect when dipped in their tomato basil soup, which wasn't too creamy and was very delicious. We liked it so much that we went back the next day, and I had their equally good iced coffee and some peanut butter cookies. Now I just need to go back and try their gelato. Till next time, La Divina!"}],"visual":[{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","photo_id":"mqGRElPpwUg_R075JGJ-uQ","label":"inside","image_url":"/photos/mqGRElPpwUg_R075JGJ-uQ.jpg","visual_representativeness":0.8900465965270996},{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","photo_id":"CGRcBeGlxBtSnDroG5QAOQ","label":"outside","image_url":"/photos/CGRcBeGlxBtSnDroG5QAOQ.jpg","visual_representativeness":0.8762512803077698},{"business_id":"9ng2rcAA3Lb6m_t4IY0QcA","photo_id":"vyfZkcHCXec6Pbs7-GCqfA","label":"food","image_url":"/photos/vyfZkcHCXec6Pbs7-GCqfA.jpg","visual_representativeness":0.8284816145896912}]},"notebook_case":null}
