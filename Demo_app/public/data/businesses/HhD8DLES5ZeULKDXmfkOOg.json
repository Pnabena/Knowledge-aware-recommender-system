siness_count":0},{"category":"Sandwiches","historical_business_count":0},{"category":"American (Traditional)","historical_business_count":2},{"category":"Cajun/Creole","historical_business_count":4}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cajun/Creole, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"HhD8DLES5ZeULKDXmfkOOg","review_id":"nVNlunaY9F7z_8ztEOqkBw","date":"2016-12-02T21:16:59","stars":4,"text_representativeness":0.9345517754554749,"text_excerpt":"I was actually pleasantly surprised with this place. We went there with some friends after a Saints game. It was obviously really crowded so we put our name in and ordered some drinks at the bar. My rum and coke was really big so I was happy. It actually didn't take that long to get a table. Our waitress was nice, but obviously overwhelmed with the crowd. The kitchen too as out food took a long time. She did apologize a lot which is appreciated. I got the ahi tuna wrap which was delicious. I was really impressed with the flavor, especially from a \"sports bar\" place. I'd go back again for sure."},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","review_id":"OF6SfF1FhEnGCQ4LLDua_Q","date":"2014-05-16T19:44:03","stars":4,"text_representativeness":0.9338033199310303,"text_excerpt":"Came here for dinner/hockey game with a bachelor party. I've been to this Walk-On's three times. And I've been satisfied all three times. The service is good. I personally think the food is good. And the atmosphere as a sports bar is also pretty cool. My only knock is the prices. They're just a little higher than I would like to pay for barfood, even though I do think it's good. Anyway, we ended up getting a ton of different appetizers - angels on horseback, fried shrimp, chili cheese fries, boudin, shrimp and grits (not an app, I know), etc. The waitresses were very friendly and accommodating in putting up with our boisterousness. I definitely recommend it if in the CBD and looking for a..."},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","review_id":"LuquriEIsYx82KNLIJUebA","date":"2014-02-06T17:20:44","stars":4,"text_representativeness":0.9248742461204529,"text_excerpt":"Came here before the game. Really cool spot with good food. We had the Tini tuna and alligator bites for appetizers. So good especially the alligator bites. I have the California club wrap with stuffed potato which was tasty. My sons had the grilled cheese it was good I wanted to eat it lol. Great location and pretty good service to watch a game or to fuel up before the game."}],"visual":[{"business_id":"HhD8DLES5ZeULKDXmfkOOg","photo_id":"GtP3vcIv9Eu9G2Fd3wiQcw","label":"food","image_url":"/photos/GtP3vcIv9Eu9G2Fd3wiQcw.jpg","visual_representativeness":0.8456493616104126},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","photo_id":"1fu4gm2tXXlfyUu1_unxUw","label":"food","image_url":"/photos/1fu4gm2tXXlfyUu1_unxUw.jpg","visual_representativeness":0.8279409408569336},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","photo_id":"Yo6Hp6DTKXWDc7z7AZ8ubg","label":"inside","image_url":"/photos/Yo6Hp6DTKXWDc7z7AZ8ubg.jpg","visual_representativeness":0.8120107650756836},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","photo_id":"YKF3omhzWtQKpHgPdJzhAQ","label":"inside","image_url":"/photos/YKF3omhzWtQKpHgPdJzhAQ.jpg","visual_representativeness":0.7802071571350098},{"business_id":"HhD8DLES5ZeULKDXmfkOOg","photo_id":"90GU1miYTLaaLt2vG1o4kg","label":"inside","image_url":"/photos/90GU1miYTLaaLt2vG1o4kg.jpg","visual_representativeness":0.7121065258979797}]},"notebook_case":null}
