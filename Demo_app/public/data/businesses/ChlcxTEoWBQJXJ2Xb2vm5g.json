HZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","review_id":"ZYtuCvFZOSeCqSlvmAFS4w","date":"2010-02-23T02:19:40","stars":5,"text_representativeness":0.9501471519470215,"text_excerpt":"In reality my love of the \"BAM\" dates back to late 2002 (before I started this blog and before I had the money and inclination to go to places like Alinea or Per Se) when I took my mother to his Orlando restaurant as a Thank You for helping me with my medical school applications. Without overstating I can honestly say that it was my first experience with \"fine dining\" and it opened my eyes to what food and a dining \"experience\" could be. Since that visit I've been back to the eponymous Orlando restaurant as well as Tchoup Chop, Table 10, Delmonico Las Vegas, and the Fish House and liked or loved the experience at each. Greeted promptly by my server, a young African American fellow who int..."},{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","review_id":"pj71yhuwtzY42E7S_pKS2g","date":"2009-10-21T19:24:27","stars":5,"text_representativeness":0.9491303563117981,"text_excerpt":"For dinner we went to Emeril's NOLA. We were seated upstairs and had a great view overlooking the first floor from the balcony. I loved the layout of the restaurant, with the open kitchen and it was cool we took an elevator up to our table. Emeril truly is a master and he knows how to run his restaurants. He has the staff and kitchen trained perfectly to his liking without a shadow of doubt. What a perfect dining experience. We had three servers and all were terrific. This was probably the best service we had at any of the restaurants this week, however eevery restaurant provided great service which is a tribute to New Orleans coming from an NY foodie. The food truly is incredible. Loved ..."},{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","review_id":"huNDTrtDQEFh8Tae_NAOkg","date":"2011-08-15T14:10:14","stars":4,"text_representativeness":0.9485245943069458,"text_excerpt":"I probably wouldn't have picked this restaurant, but thankfully a work dinner brought me to NOLA earlier this month. I hadn't a clue what to expect and went in with very few expectations. I started with a wonderfully concocted watermelon martini and my colleagues and I shared Miss Hay's stuffed chicken wings and the garlic-chardonnay Prince Edward Island black mussels to start. The stuffed chicken wings came highly recommended and were an excellent start to the meal. The mussels were a bit too garlicky for my tastes, but everyone else at the table scarfed them down. Continuing my watermelon kick from earlier in the week (and meal), I ordered the baby arugula with watermelon salad. It was ..."}],"visual":[{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","photo_id":"aidN01zK8f3-0yCHeDVgXw","label":"drink","image_url":"/photos/aidN01zK8f3-0yCHeDVgXw.jpg","visual_representativeness":0.8629599809646606},{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","photo_id":"RLDuRKN2GrHRkVPj3SkDxw","label":"inside","image_url":"/photos/RLDuRKN2GrHRkVPj3SkDxw.jpg","visual_representativeness":0.8614934682846069},{"business_id":"ChlcxTEoWBQJXJ2Xb2vm5g","photo_id":"Zrv148yTi2kaxVVxHOpAzw","label":"in