s_count":5},{"category":"Southern","historical_business_count":2},{"category":"Sandwiches","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cajun/Creole, Nightlife, Restaurants","shared_category_count":5},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants, Southern","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants, Seafood","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","review_id":"5a33FnnZyPlIMR8WXk3Y6Q","date":"2013-06-12T17:30:14","stars":5,"text_representativeness":0.9462438821792603,"text_excerpt":"I've lived in this city for 10 years now and just had my first roast beef po boy from Parasol's.. It was amazing. Better than any I've ever had. The bar is small and filled with locals. The upstairs dining area is casual and great for enjoying what is reputed to be one of the best, (and I agree), po boys in New Orleans. Definitely would recommend it."},{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","review_id":"AwKt-l-hOGA4PKCfbtCUHg","date":"2015-03-01T17:42:30","stars":5,"text_representativeness":0.9448561668395996,"text_excerpt":"My favorite meal in NOLA hands down. We were in the Garden District and had just got done being touristy. I am so glad that we went off the grid a little bit and tried something that wasn't on the popular Magazine St. for lunch. There are two separate parts to Paraol's. The bar and the restaurant. The restaurant is actually pretty big with two rooms and lots of TV's. It is not fancy by any means, think picnic tablecloths. Yelp helped me out with my choice of Poyboy. The Firecracker Shrimp. WOW. What an amazing sandwich. SO MUCH SHRIMP. I want the sauce, I need the sauce. It was ridiculously good. My date got the pulled pork, and he loved that as well. I can't wait to go back!!!"},{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","review_id":"2TSPMszvrX4k_7VG-W0ZPw","date":"2016-04-23T18:34:41","stars":4,"text_representativeness":0.9434940814971924,"text_excerpt":"What a funky little place. We came here for lunch on our last day in New Orleans and I am glad that we were able to see a different neighborhood (we stayed off Magazine - about 1 mile away and close enough to walk but it was hotter than hades and we were hungover). The Irish Channel is super cute and definitely worth a look, and save your appetite for a humongous poboy at Parasol's! I will mention that it's not the most 5 star dining. You might want to take it to go if you are big on ambiance. The sandwiches are HUGE. My boyfriend and I split the large roast beef poboy and an order of fries (asked for a small but they accidentally dropped a large - so they gave us lots!) and it was too mu..."}],"visual":[{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","photo_id":"BJ6T98snpLjk9ObH3ypAHA","label":"outside","image_url":"/photos/BJ6T98snpLjk9ObH3ypAHA.jpg","visual_representativeness":0.8723373413085938},{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","photo_id":"fIa4T0yopd9hX5Ii3-o9Yg","label":"inside","image_url":"/photos/fIa4T0yopd9hX5Ii3-o9Yg.jpg","visual_representativeness":0.8659983277320862},{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","photo_id":"fcdTcskD7EBWCeKPy66bEw","label":"inside","image_url":"/photos/fcdTcskD7EBWCeKPy66bEw.jpg","visual_representativeness":0.8604198694229126},{"business_id":"Gfegg1vwKJJo-EfEujQ-nw","photo_id":"1DfoVIy0MbF4IZsxfmfbyg","label":"food","image_url":"/photos/1DfoVIy0MbF4IZsxfmfbyg.jpg","visual_representativeness":0.8128162622451782}]},"notebook_case":null}
