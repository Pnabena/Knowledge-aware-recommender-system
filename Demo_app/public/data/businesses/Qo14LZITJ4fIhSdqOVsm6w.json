usiness_count":0},{"category":"Bars","historical_business_count":5},{"category":"Nightlife","historical_business_count":5},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Restaurants","historical_business_count":8},{"category":"Venues & Event Spaces","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Cajun/Creole, Cocktail Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Qo14LZITJ4fIhSdqOVsm6w","review_id":"xYbvnKBZGTwmT3jKhaFlyw","date":"2014-12-21T01:39:26","stars":4,"text_representativeness":0.9421460032463074,"text_excerpt":"Had a great time at this place! First and foremost, the Hurricanes are a must try. Think you're a heavyweight? Be careful because the strength of this drink will slowly creep. We also tried some fab appetizers including: -fried alligator (nom) -oysters (pretty tasty, deep fried) -wings (my mom said they were okay) Overall awesome atmosphere in the famous French Quarter and killer drinks!"},{"business_id":"Qo14LZITJ4fIhSdqOVsm6w","review_id":"fLzSlTUAACVmQwKAl4Mp6w","date":"2017-04-19T12:10:28","stars":4,"text_representativeness":0.9405841827392578,"text_excerpt":"What an incredible atmosphere to sit and have a bite or a drink or both. Went here last night after dinner and sat and had an amazing hurricane cocktail. Place is huge and everyone there is friendly and helpful. Drinks were reasonable too and like I said, the environment was great. Don't miss it"},{"business_id":"Qo14LZITJ4fIhSdqOVsm6w","review_id":"wKH52JH854PumGmcyfLKQg","date":"2017-02-08T05:07:06","stars":4,"text_representativeness":0.9395357370376587,"text_excerpt":"The atmosphere in the outdoor seating area is great. You have the fountain with really neat lighting which is a cool atmosphere to relax and enjoy and have a good time with friends. Just note, the drink prices vary based on whether you're sitting at the piano bar, outside, etc. You are given popcorn to accompany your drink which is a great touch. I got the signature hurricane. It was really sweet and most definitely delicious. Could not imagine coming to New Orleans without getting a hurricane. If you decide you don't want to keep the souvenir glass (the glass the drink comes in), then you can get $3 cash back when you return the glass to the bar. Thought that was cool. Definitely worth c..."}],"visual":[{"business_id":"Qo14LZITJ4fIhSdqOVsm6w","photo_id":"JYuXIPm1n2fJPIt-a_XJ9A","label":"drink","image_url":"/photos/JYuXIPm1n2fJPIt-a_XJ9A.jpg","visual_representativeness":0.8356475830078125},{"business_id":"Qo14LZITJ4fIhSdqOVsm6w","photo_id":"xvXAyGwO0zwXsge-a95HLg","label":"inside","image_url":"/photos/xvXAyGwO0zwXsge-a9