ode":"70115","stars":5.0,"review_count":139,"categories":["Ice Cream & Frozen Yogurt","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"0yGH62WGQy_W3JoR6L5Kew","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":640,"mm_rank":565,"target_category_support_fraction":0.5,"selected_image_count":4,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"0yGH62WGQy_W3JoR6L5Kew","review_id":"L4V16QM3Xwva8QLRPoFLyg","date":"2015-06-04T00:53:36","stars":5,"text_representativeness":0.9419533014297485,"text_excerpt":"What a great little ice cream shop! The server (owner?) was super friendly and funny. He claimed that they make all their ice cream in house. I actually had my mind on a snoball when I came in but tried their strawberry cheesecake ice cream and ordered that instead. It was creamy and delicious, you could tell that it was pure ice cream, nothing artificial. I'll definitely be back to try one of their snoballs. Please go here! You're supporting a local neighborhood business with an awesome product."},{"business_id":"0yGH62WGQy_W3JoR6L5Kew","review_id":"wrq2TLr6Dosmm7DdDYSQcQ","date":"2021-11-14T23:10:22","stars":5,"text_representativeness":0.9380871653556824,"text_excerpt":"This is one of my favorite dessert places. All of the ice cream flavors are created by the owner. He is always outgoing and friendly and will insist on you trying many flavors (unlike a store down Freret from him that isn't friendly and will not let you try any flavors). He had me try a flavor that I would have never thought I would like - and it was delicious. Please stop by give this place a try!"},{"business_id":"0yGH62WGQy_W3JoR6L5Kew","review_id":"y5MV2xux5tD07wfmdNQgUg","date":"2015-07-13T12:58:23","stars":4,"text_representativeness":0.9358443021774292,"text_excerpt":"Thanks to other yelpers for highlighting this place, which caused us to check it out! Wonderful small store tucked into the end of Feret Street next to the parking lot. On par with New Orleans - it's in a converted house, but you can't miss the giant ice cream cone cut out at the front (which party pooper bf declined to take a photo in front of). We were first greeted by a giant black cat named Jinksys, then we were enthusiastically greeted by the owner of the shop. After I asked \"Which flavor is your favorite?\" He heartily replied with a laugh, \"Well I made them all, so I like them all!\" Then he proceeded to give us samples of multiple flavors. I mean totally opposite of other shops' pol..."}],"visual":[{"business_id":"0yGH62WGQy_W3JoR6L5Kew","photo_id