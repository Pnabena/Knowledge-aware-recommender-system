:2.5,"review_count":36,"categories":["Desserts","Food","Restaurants","Vietnamese","Coffee & Tea"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"t5u0uDavOY6M9qu8FLAs0g","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1942,"mm_rank":1536,"target_category_support_fraction":0.6,"selected_image_count":2,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Desserts","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Restaurants","historical_business_count":8},{"category":"Vietnamese","historical_business_count":0},{"category":"Coffee & Tea","historical_business_count":1}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"t5u0uDavOY6M9qu8FLAs0g","review_id":"hr5hz_dAgt_b_wTpGJeC-g","date":"2012-11-11T08:08:39","stars":4,"text_representativeness":0.9361393451690674,"text_excerpt":"I've been to Le Viet a few times and I find it very enjoyable. The service is extremely attentive and the food is good if not groundbreaking. The pho is at least decent, but I especially like the spring rolls and beef menu items. The last time I was there I had a dish with steak cubes and chopped onion with rice that was truly excellent. It appears from other reviews that Le Viet had more problems in the months following their opening, but now I think they've really hit their stride. I will definitely be returning to Le Viet regularly whenever I get a hankering for Vietnamese food."},{"business_id":"t5u0uDavOY6M9qu8FLAs0g","review_id":"1fHlNtdPKHCgY2XijqeWdw","date":"2012-09-11T17:29:15","stars":4,"text_representativeness":0.9176807403564453,"text_excerpt":"We visited Le Viet Cafe because I was looking for somewhere in NOLA to go on a dinner date, and I noticed the Yelp Deal available ($40 for $20). I was sold - especially after reading about the Roll Your Own spring rolls. This appetizer was definitely the start of the night. It was a fun activity, delicious, and filling. I barely had room for my entree, but I ate it anyway because it was delicious (lemongrass beef rice plate). My date had lemongrass beef bun and also enjoyed it. Yes, there are cheaper places on the Westbank for Vietnamese food (and for me, they are much closer to home), but I would make the return trip to Le Viet Cafe for the roll your own spring rolls... genius concept!"},{"business_id":"t5u0uDavOY6M9qu8FLAs0g","review_id":"H0pwMv4-6Eg7iueZT-4yTw","date":"2012-05-02T15:23:18","stars":4,"text_representativeness":0.9074190855026245,"text_excerpt":"They are better now that they hired a new cook! They were bad when they just open and now they are improving. The PHO here is delicious. It get 4 stars because they dont have fish sauce on the table!!! ): What Vietnamese place doesnt have fish sauce, Im insulted! haha"}],"visual":[{"business_id":"t5u0uDavOY6M9qu8FLAs0g","photo_id":"N7uVEonjm0XC584KJ3RoiQ","label":"drink","image_url":"/photos/N7uVEonjm0XC584KJ3RoiQ.jpg","visual_representativeness":0.8975710868835449},{"business_id":"t5u0uDavOY6M9qu8FLAs0g","photo_id":"6ErRcJnTHLa3wKTLmeDt0Q","label":"food","image_url":"/photos/6ErRcJnTHLa3wKTLmeDt0Q.jpg","visual_representativeness":0.8975709676742554}]},"notebook_case":null}
