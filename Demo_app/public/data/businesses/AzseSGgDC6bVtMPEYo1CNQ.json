_id":"AzseSGgDC6bVtMPEYo1CNQ","nv_rank":253,"mm_rank":59,"nv_score":0.664129376411438,"mm_score":0.7603366374969482,"rank_movement":194,"has_visual_feature":true,"name":"Creole Creamery","address":"4924 Prytania St","city":"New Orleans","state":"LA","postal_code":"70115","stars":4.5,"review_count":921,"categories":["Food","Ice Cream & Frozen Yogurt"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":253,"mm_rank":59,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","review_id":"ZtCrvfujPmBvSGZCJ4x5cg","date":"2011-03-24T19:29:16","stars":5,"text_representativeness":0.9468057155609131,"text_excerpt":"I love this place! The ice cream here is excellent! Every time I go here I get to try new flavors. Some of the most surprising combinations have been the beer flavors. I tried the Abita Strawberry and Chocolate yesterday and it was amazing. You wouldn't think that a bitter beer taste would be good in ice cream, but it is! The other plus is that there is always a range of lighter flavor choices, like lavender and honey or lemon freezer pie to heavier ones. I know that I can always find something to satisfy my hankerin'. Don't let the cash only situation worry you too much, there is a Chase ATM right next door. This place is good for some of the best ice cream you've ever had."},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","review_id":"g-Afx-YsBbI4GHzk-fe09g","date":"2014-05-26T19:40:55","stars":5,"text_representativeness":0.945904016494751,"text_excerpt":"My constant craving of Ice-cream always leads me back to Creole Creamery. I tend to go to these independent shops as I feel they really do provide a unique experience along with great tasting treats. This place has many flavors with unique names and tastes. On different occasions I may just get a scoop or sometimes I indulge in a banana split. Huge scoops here so be sure to have a big appetite. My friend had the sampler of like 5 different chocolate scoops. Each one rich and very different. I had the Lavender Honey before and it was smooth and creamy. Such an exuberant flavor to choose! I can go on and on about their extensive list of flavors, but you could check out the website to see th..."},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","review_id":"3TB6RbV0cm4pCOcL3TU0hg","date":"2017-05-05T04:51:55","stars":5,"text_representativeness":0.9455922245979309,"text_excerpt":"Loved this place!! Best ice cream I've had in NOLA. Great selection of flavors, both classics and unique ones that I'd never seen anywhere else. I live for chocolate so I got their \"I Scream Fudge\" sundae, which was two scoops of chocolate ice cream, hot fudge, whipped cream, and chocolate toppings. It was awesome. My girlfriend was a little more adventurous and took advantage of the interesting flavors, and she got a 4-scoop samples (a great option for $5). She tried the red velvet and cookies and cream, which they said were their top two flavors, as well as the cafe au lait and chocolate malt. Again, all were awesome. I can't wait to go back!!! CASH ONLY!"}],"visual":[{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","photo_id":"xTCllcq_f9LVfkzEO1hKFA","label":"inside","image_url":"/photos/xTCllcq_f9LVfkzEO1hKFA.jpg","visual_representativeness":0.8885683417320251},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","photo_id":"c1lbZYUtP9atRQeD8pg-Yw","label":"outside","image_url":"/photos/c1lbZYUtP9atRQeD8pg-Yw.jpg","visual_representativeness":0.8737808465957642},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","photo_id":"qW9UNKAo_0rb4fR4IfkLUw","label":"inside","image_url":"/photos/qW9UNKAo_0rb4fR4IfkLUw.jpg","visual_representativeness":0.8410130143165588},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","photo_id":"MwZLL07U6TV637JdMgXPLA","label":"food","image_url":"/photos/MwZLL07U6TV637JdMgXPLA.jpg","visual_representativeness":0.8237220644950867},{"business_id":"AzseSGgDC6bVtMPEYo1CNQ","photo_id":"2dkclSWaSOZT_f426XPbzw","label":"food","image_url":"/photos/2dkclSWaSOZT_f426XPbzw.jpg","visual_representativeness":0.8131395578384399}]},"notebook_case":null}
