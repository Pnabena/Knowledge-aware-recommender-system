age_count":0,"label_diversity":0,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Cajun/Creole","historical_business_count":4},{"category":"Restaurants","historical_business_count":8},{"category":"Seafood","historical_business_count":2}],"history":[{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants, Seafood","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"VqLkF5MgXMeGt1atl9pwZg","review_id":"XdqQiCyRlzGYlP4fWWphuA","date":"2015-01-24T21:17:19","stars":4,"text_representativeness":0.9288198947906494,"text_excerpt":"Cajun Joe is not far from me, so I visit often. The fried chicken & shrimp po boys are great. I also enjoy their hot sausage po boy. I love the fact that it's inexpensive. They offer large portions and don't skimp on anything. The owners are extremely kind and I have never waited long for anything I've ordered."},{"business_id":"VqLkF5MgXMeGt1atl9pwZg","review_id":"EqNI5S2PF8-hjls7x-LyMw","date":"2016-01-04T18:37:00","stars":5,"text_representativeness":0.9268600940704346,"text_excerpt":"I'll come right out and say it, Cajun Joe's wings are better than Manchu's! Always crunchy, never greasy and perfectly seasoned. I come here once a month to indulge my inner fat kid the 8 wings and rice combo always hits the spot. The shrimp fried rice is \"on fleek\" as the kids say but the combo can be a bit salty. This is not a sit-down have a date place, it's all about in and out and spending as little money as possible. So next time your inner fat kid is yelling for wings and rice you know where to go!"},{"business_id":"VqLkF5MgXMeGt1atl9pwZg","review_id":"K1eqaqanFrnZ8U7lJk_s2Q","date":"2016-03-01T21:50:20","stars":5,"text_representativeness":0.9203015565872192,"text_excerpt":"Man, are the chicken wings here ON POINT!! Super crispy, seasoned oh so perfectly and never greasy! Add rice to that and you got one of the best plates of chicken wings and rice you've ever had!! Oh and not to mention, the shrimp po boy is another favorite!"}],"visual":[]},"notebook_case":null}
