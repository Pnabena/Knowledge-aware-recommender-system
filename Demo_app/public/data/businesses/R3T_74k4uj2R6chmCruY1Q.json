nt":0},{"category":"Event Planning & Services","historical_business_count":0},{"category":"American (Traditional)","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), American (Traditional), Nightlife, Restaurants","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Nightlife, Restaurants","shared_category_count":3},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Nightlife, Restaurants","shared_category_count":2},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Nightlife","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"R3T_74k4uj2R6chmCruY1Q","review_id":"z6BnsihTxOzYLsrSKf8G4Q","date":"2013-08-12T15:41:20","stars":4,"text_representativeness":0.9448068737983704,"text_excerpt":"The service is really good, the decor is what you would expect at the Hard Rock. We loved our food. (a little pricey, but not bad.) The loud music can be overwhelming at times, but its not meant to be a romantic setting. It is a party place, and I must say, the mixed drinks are not half bad. The menu isn't always clear, for example, It would have been awesome if I had known my salad had dark meat chicken instead of chicken breast. I dont like dark meat so I ate around it. My husband's burger was fantastic! I like the nachos and a vegetarian burger i had here was stellar. I am a local, and I will keep going back. The food and service was worth it."},{"business_id":"R3T_74k4uj2R6chmCruY1Q","review_id":"FYBLEl387DXs6OWeo0YqHg","date":"2021-08-05T00:45:10","stars":4,"text_representativeness":0.929718554019928,"text_excerpt":"Typically I visit the Hard Rock Cafe in every city I go. The service here was great. The servers were attentive and we were seated promptly. We came in for a quick bite and drink. The sliders were light and the Hurricane cocktail was great. There's a bit of a fruity punch to it."},{"business_id":"R3T_74k4uj2R6chmCruY1Q","review_id":"wXZiyhd_R4TfQvhxMs0ExQ","date":"2015-02-26T01:46:12","stars":5,"text_representativeness":0.9194474220275879,"text_excerpt":"Second time I have eaten at a hard rock cafe. Awesome as usal! I had a giant burger and got the $14 cocktail that you actually get to keep the glass. Desert was also sooo good. Hilly recommend coming here!"}],"visual":[{"business_id":"R3T_74k4uj2R6chmCruY1Q","photo_id":"k0vRL1v02oEZJ2oNxpAtYw","label":"inside","image_url":"/photos/k0vRL1v02oEZJ2oNxpAtYw.jpg","visual_representativeness":0.862220287322998},{"business_id":"R3T_74k4uj2R6chmCruY1Q","photo_id":"GtzBFJjxd_TEqc6kaGsQYQ","label":"inside","image_url":"/photos/GtzBFJjxd_TEqc6kaGsQYQ.jpg","visual_representativeness":0.8572508096694946},{"business_id":"R3T_74k4uj2R6chmCruY1Q","photo_id":"KY-ixuJrxJnbg06uPyBXFQ","label":"food","image_url":"/photos/KY-ixuJrxJnbg06uPyBXFQ.jpg","visual_representativeness":0.8543009757995605},{"business_id":"R3T_74k4uj2R6chmCruY1Q","photo_id":"jHgL_id5l5AeaP4dlvnraw","label":"outside","image_url":"/photos/jHgL_id5l5AeaP4dlvnraw.jpg","visual_representativeness":0.843366026