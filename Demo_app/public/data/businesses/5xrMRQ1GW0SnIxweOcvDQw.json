oDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"5xrMRQ1GW0SnIxweOcvDQw","review_id":"xfKZcSg-jeHkCfa5mAyDOg","date":"2014-12-03T14:15:01","stars":5,"text_representativeness":0.926177978515625,"text_excerpt":"I'll say this about Smoothie King: if I ever end up moving away from the GNO area, I'm becoming a Smoothie King franchisee wherever I end up. That store would promptly be run into the ground in two weeks when I finish consuming all of the stock intended for customer purchase. I'm not just giving this location five stars, I'm giving the whole chain five stars. This location in particular always seems to have cheerful folks behind the counter, and the corporate mothership always seems to be sending out coupons in the local coupon mailer we get. There's always something appealing to a wide variety of palettes in the standard offerings, and they have seasonal and special flavors, such as pump..."},{"business_id":"5xrMRQ1GW0SnIxweOcvDQw","review_id":"3XEeDjDeGre4OWRallvS2A","date":"2018-04-06T14:59:21","stars":4,"text_representativeness":0.9239601492881775,"text_excerpt":"Can't lose with $5 Friday! Service is great at this location and very efficient. Location is also very clean. Def one of my fav smoothie king locations in the city."},{"business_id":"5xrMRQ1GW0SnIxweOcvDQw","review_id":"NKCrIwOTpiLZeghLYwrEJw","date":"2011-08-12T19:31:39","stars":4,"text_representativeness":0.9135708808898926,"text_excerpt":"Another classic case of \"if you've seen one, then you've seen them all\". If you're not familiar with this Smoothie King location, you'd probably drive right by it and never know it was there. It's tucked into a small strip mall behind the Shell gas station. Just look for the Blockbuster video store and you know you're in the right spot. For all you 40 somethings like me, the Blockbuster used to be the old \"Shannahan's\" bar back in the 80's & early 90's, but that's all I'm sayin about that. :-) The staff here is very friendly and thay all seem to enjoy working here. This Smoothie King caters to the Tulane University crowd as it is located just behind their campus."}],"visual":[]},"notebook_case":null}
