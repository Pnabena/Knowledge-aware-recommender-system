competitive_visual_rank_effect":null},"category_overlap":[{"category":"Candy Stores","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Specialty Food","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ugy0ufC46d_jm9TtY7YhNA","review_id":"fTK-oFoBajMgKg75NxLavA","date":"2013-02-19T19:19:37","stars":5,"text_representativeness":0.9457443952560425,"text_excerpt":"Who doesn't love Roman Candy? For those of you who have no idea what it is, it's basically taffy. It is SO good. If you can get to it when it's still warm, then you will be in heaven. Every New Orleans kid grew up on the stuff. I didn't know they had a mobile cart and the only time I ever had it was at the zoo. I remember I used to get my parents to buy me a bunch so that I could take some home and have it later. Amazing."},{"business_id":"ugy0ufC46d_jm9TtY7YhNA","review_id":"cBeFt1rY8GkBzvRYKaCqJg","date":"2012-08-18T17:35:47","stars":5,"text_representativeness":0.933418869972229,"text_excerpt":"Roman Candy is a New Orleans Tradition. Until I read Jen's review, I didn't know they still had a mobile cart. I had only ever seen them at the zoo. It seems like every time I saw the cart at the Zoo, I had to get a stick of chocolate. I would then proceed to walk around the monkey area trying to prevent the candy from sticking too my teeth, mouth and esophagus. If you've never had a piece you know that is nearly impossible. Despite the extreme stickiness, the candy is very good. I guess it would be considered a type of taffy, but I will never call it anything but Roman Candy."},{"business_id":"ugy0ufC46d_jm9TtY7YhNA","review_id":"ijEmUi5Z3Pi-0xwtnJFv_g","date":"2012-08-21T14:42:58","stars":5,"text_representativeness":0.9285424947738647,"text_excerpt":"Roman candy has been a fixture of New Orleans and a fond memory of many a local child. I grew up mostly getting this taffy-like Nola creation at Audubon Zoo where there is a stationary cart. Living out in Metairie I rarely saw the mobile cart on the street, pretty much only during Mardi Gras. While the Zoo card is stuck in one spot this cart is usually drawn by a mule which often wanders wherever it wants to go. However, that delicious, sticky candy is still the same. Flavors come in the classic trio of chocolate, vanilla, and strawberry. My favorite is the vanilla, hands down, although the chocolate is good as well."}],"visual":[{"business_id":"ugy0ufC46d_jm9TtY7YhNA","photo_id":"lDaEhuScyUBrOYqmcKPcvA","label":"outside","image_url":"/photos/lDaEhuScyUBrOYqmcKPcvA.jpg","visual_representativeness":0.8974188566207886},{"business_id":"ugy0ufC46d_jm9TtY7YhNA","photo_id":"Vsf4uScPHNQy3Xf7jm4XQQ","label":"outside","image_url":"/photos/Vsf4uScPHNQy3Xf7jm4XQQ.jpg","visual_representativeness":0.8916661143302917},{"business_id":"ugy0ufC46d_jm9TtY7YhNA","photo_id":"P8T8HsBcmtXWLj-DQMkm9A","label":"outside","image_url":"/photos/P8T8HsBcmtXWLj-DQMkm9A.jpg","visual_representativeness":0.7764286994934082}]},"notebook_case":null}
