ries":["Food","Coffee & Tea"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2081,"mm_rank":1705,"target_category_support_fraction":1.0,"selected_image_count":4,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Coffee & Tea","historical_business_count":1}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","review_id":"TPNAceIhF2hDrIcylZ-FPA","date":"2017-06-26T17:37:22","stars":4,"text_representativeness":0.9439358711242676,"text_excerpt":"This location can be a little hard to find (2nd floor of the Hyatt Regency -- and it's a little bit of a maze up there) but they have fast service, good wifi, and lots of seating. It gets busy when there are conventions at the hotel, but they keep up the pace and the line moves quickly. Tables/chairs can occasionally be a little messy (a few crumbs) but not bad at all. One of the best Starbucks I've been to!"},{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","review_id":"Y7x00IQx6uHRY35ohZKXaA","date":"2013-07-23T16:42:38","stars":4,"text_representativeness":0.9357930421829224,"text_excerpt":"I've been patronizing this Starbucks every now and then ever since they opened. Working on the \"northwest\" end of the CBD near the main post office, I am only a block from the Hyatt, and often find myself cutting through the buildings on my way to Poydras Street. Every time I do, I often stop at this full service Starbucks located inside the Hyatt. As far as food and coffee goes, this place isn't any different from any stand-alone locations. However, it has a fairly large seating area and free wi-fi. Couple that with an endless stream of tourists in the Hyatt, this place is the perfect spot to sit & people watch. (If you're into that sort of thing). Since I usually cruise through here on ..."},{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","review_id":"EzqnDKiK9MsR3RWPULCSTg","date":"2013-06-26T19:53:55","stars":4,"text_representativeness":0.932435154914856,"text_excerpt":"I have stayed at many hotels in my life. Of those hotels, several have had a Starbucks inside. But this is the first hotel I have stayed in that had a full service Starbucks and that is a nice perk. When people visit New Orleans they often have a tendency to overdo the partying. That leads to dehydration, food cravings and the need for a massive influx of caffeine. I am not saying that happened to me, but this Starbucks was a very welcome addition to my stay at the Hyatt. Since it is part of a massive chain, you already know what they have here. The sandwiches are a great snack or meal, and the coffee does contain caffeine. Service was friendly, but a bit slow. This could be because of th..."}],"visual":[{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","photo_id":"p-aeIyyNo770yNxGKMuPbA","label":"drink","image_url":"/photos/p-aeIyyNo770yNxGKMuPbA.jpg","visual_representativeness":0.9369644522666931},{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","photo_id":"94cPN_q-TKukZkWbJPhSNA","label":"inside","image_url":"/photos/94cPN_q-TKukZkWbJPhSNA.jpg","visual_representativeness":0.872925877571106},{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","photo_id":"j9YxQgO1MxGJEr6vX1W99w","label":"inside","image_url":"/photos/j9YxQgO1MxGJEr6vX1W99w.jpg","visual_representativeness":0.8383260369300842},{"business_id":"a8VS5iOxeEIv3JnUiQLF6w","photo_id":"O3U_xOeAmxzmP6MmNTORiw","label":"inside","image_url":"/photos/O3U_xOeAmxzmP6MmNTORiw.jpg","visual_representativeness":0.7977783679962158}]},"notebook_case":null}
