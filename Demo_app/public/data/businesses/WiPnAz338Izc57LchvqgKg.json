ve_visual_rank_effect":null},"category_overlap":[{"category":"Sandwiches","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Cheesesteaks","historical_business_count":0},{"category":"Breakfast & Brunch","historical_business_count":1}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Breakfast & Brunch, Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"WiPnAz338Izc57LchvqgKg","review_id":"GqOqIkqXD5BA_nwSPaCPcg","date":"2013-10-25T20:56:19","stars":4,"text_representativeness":0.9414017200469971,"text_excerpt":"I always try to stop here when I'm boozing on Bourbon St. Not the cheapest, not 100% authentic, but DAMN GOOD! I grew up in Philly and this was the closest thing to a \"whiz with\" that I had access to for a while. I'm an extra cheese kinda girl, highly suggest it!"},{"business_id":"WiPnAz338Izc57LchvqgKg","review_id":"-Ut0laieWUqwmVO5Qown6Q","date":"2011-11-16T01:04:48","stars":4,"text_representativeness":0.9228154420852661,"text_excerpt":"If you're going for ambiance, this isn't the place - but it's on Bourbon street so your expectations shouldn't be too high. You feel like you're right in the kitchen. Not a place to go for atmosphere - but the food is something else. Only reason I don't give it 5 stars is because of the rest of the experience besides what's going on inside your mouth. If I graded purely on taste though this place deserves 5 stars. The cheesesteaks are absolutely fabulous. Make sure you split it with someone. They are HUUUUGE! I've eaten many cheesesteaks in my day and this could possibly be the best one ever. The fact that they are open late after a long night of drinking is a definite plus too."},{"business_id":"WiPnAz338Izc57LchvqgKg","review_id":"XoKY4fWLVqMgkHkwhCynmQ","date":"2011-07-07T16:01:31","stars":4,"text_representativeness":0.888841986656189,"text_excerpt":"They fly in the Amoroso's rolls. Amoroso's is to a Philly cheesesteak what Leidenheimer's is to a poboy: it's just not one without it. Plus, Cheese Whiz. This is the closest thing you are going to get to a Philly cheesesteak in New Orleans."}],"visual":[]},"notebook_case":null}
