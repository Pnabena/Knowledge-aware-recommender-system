iness_row":1551,"business_id":"bMpKXcKFetJQsa42UR25cQ","nv_rank":786,"mm_rank":716,"nv_score":-0.17327070236206055,"mm_score":-0.05245152488350868,"rank_movement":70,"has_visual_feature":true,"name":"Pravda!","address":"1113 Decatur St","city":"New Orleans","state":"LA","postal_code":"70116","stars":4.0,"review_count":109,"categories":["Bars","Restaurants","Nightlife","Lounges"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"bMpKXcKFetJQsa42UR25cQ","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":786,"mm_rank":716,"target_category_support_fraction":0.75,"selected_image_count":4,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Bars","historical_business_count":5},{"category":"Restaurants","historical_business_count":8},{"category":"Nightlife","historical_business_count":5},{"category":"Lounges","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"bMpKXcKFetJQsa42UR25cQ","review_id":"1CE_8BtHOFS1dA2poRl0Mw","date":"2011-03-15T03:03:44","stars":4,"text_representativeness":0.940302312374115,"text_excerpt":"I love this place! Okay, so the best part of this place is that its a great place to spend time with friends. The atmosphere is relaxed. The lighting is always dim and the music is always good but not too loud so I can still hear the person across the table. This place is both funky and classy, a place where almost anyone would feel comfortable. Drink wise, there is a fantastic selection. This is important since some of my friends don't drink, but that's not a problem because Pravda has coffee which my non-drinking friends love. Since the weather has been cold, I've been enjoying the hot toddys on a regular basis. If you are interested in trying absinthe they've got it. If you're looking ..."},{"business_id":"bMpKXcKFetJQsa42UR25cQ","review_id":"4fNHVrpHZ59G5WU0tLfH8A","date":"2010-03-16T18:51:15","stars":4,"text_representativeness":0.9345600605010986,"text_excerpt":"I've been here maybe a dozen times? It's a pretty gothy-feeling bar, that's for sure! Very dimly lit maroon-colored with random Russian-esque art haphazardly hung about and small cutesy little courtyard in the back. You can get your absinthe fix here (although yeck, the stuff is foul!) or just stick to your regular spirits and beer. I think they have all sorts of vodka here - that's their shtick? That and their absinthe. I vodka, hate absinthe - do you get what I'm trying to say here? Anyway, the bartenders are typically quite friendly, the drinks really vary in alcohol potency, but I stick to the basics here. I don't think they have specialty cocktails to the best of my knowledge. I love..."},{"business_id":"bMpKXcKFetJQsa42UR25cQ","review_id":"CqbuBJC6DjG7MsYVpZt1Cw","date":"2012-04-14T03:18:35","stars":4,"text_representativeness":0.9298889636993408,"text_excerpt":"I had my first absinthe here. I had always wanted to do it the \"right\" way, so I chose Pravda. I chose wisely! While the absinthe wasn't really my thing, they had TONS of vodka to make me happy. They had vodkas from places that I did not even think had vodka! Whenever I visited, there weren't a ton of people, which made me content to hang out. I love the Russian theme and enjoy the old movies that are played on TV. I insist to take everyone I know here to visit when I am in New Orleans, and they are thankful that I did. I'm still surprised that this gem is in the French Quarter, but happy it's easily accessible."}],"visual":[{"business_id":"bMpKXcKFetJQsa42UR25cQ","photo_id":"6ssJU6DD-7ajeZhZVwOqWw","label":"food","image_url":"/photos/6ssJU6DD-7ajeZhZVwOqWw.jpg","visual_representativeness":0.8954447507858276},{"business_id":"bMpKXcKFetJQsa42UR25cQ","photo_id":"ZjKDLj5QfaBaz6LomSTJEw","label":"inside","image_url":"/photos/ZjKDLj5QfaBaz6LomSTJEw.jpg","visual_representativeness":0.7988865971565247},{"business_id":"bMpKXcKFetJQsa42UR25cQ","photo_id":"Zts2nXrv2YIi0DLQElX6Bw","label":"inside","image_url":"/photos/Zts2nXrv2YIi0DLQElX6Bw.jpg","visual_representativeness":0.7912324666976929},{"business_id":"bMpKXcKFetJQsa42UR25cQ","photo_id":"QnKAuJuUfT4Ie0XH-MCiig","label":"inside","image_url":"/photos/QnKAuJuUfT4Ie0XH-MCiig.jpg","visual_representativeness":0.7784615755081177}]},"notebook_case":null}
