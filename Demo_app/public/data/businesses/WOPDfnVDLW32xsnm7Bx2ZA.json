ory_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","review_id":"DhtVScsl-1SSq03KAUr37g","date":"2017-06-06T07:09:22","stars":5,"text_representativeness":0.9224541187286377,"text_excerpt":"I love pizza& it's been awhile since I've had one. I gotta tell ya, the mushroom & pepperoni pan pizza I just had was WORTH THE WAIT. It was everything a pizza lover wants, needs & craves - hot & bubbly, perfect amount of sauce, a wicked amount of cheese & loads of goodies ! Domino's has a tracker which is VERY helpful. When they say the pizza is on the way, they're not kidding ! Only took the driver ( who was so nice ! ) 15 minutes to deliver my pizza. Thanks,Domino's!!! You're the best!ll"},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","review_id":"FftaU8tl3DolyFjPfUXMmQ","date":"2016-01-27T16:27:08","stars":4,"text_representativeness":0.9211388826370239,"text_excerpt":"Dial up Dominos and order a pizza, perfect for a lazy night in! I usually get mixed results when I order online due to either them not understanding what I am saying or them just not knowing what is going on in terms of the menu. This time, thankfully, I managed to order and it actually arrived correct. A large, thin crust, single topping pepperoni pizza is my pizza of choice. It's basic but tastes great. I especially enjoy the way they cut the pizza to be smaller squarish shapes as opposed to the eight triangles. Easier to split between multiple people and I can monitor how much I am eating better. Delivery was pretty prompt also. Arrived before the time given over the phone which was a ..."},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","review_id":"KXOmAM-Uw4z6IwnyljqVHA","date":"2010-09-14T01:09:44","stars":4,"text_representativeness":0.9131319522857666,"text_excerpt":"I try not to review chains as much, buy I have to give props to my local Domino's for being fast, friendly, and ready when I need them. Take out or delivery, the order is always 100% accurate (in this city, you can't fake that kind of stuff for granted)."}],"visual":[{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","photo_id":"ev86qn8HyOP6buVEdm7Pbg","label":"food","image_url":"/photos/ev86qn8HyOP6buVEdm7Pbg.jpg","visual_representativeness":0.9201865792274475},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","photo_id":"gHVyHAs1YKxXQMR7VcsYVw","label":"food","image_url":"/photos/gHVyHAs1YKxXQMR7VcsYVw.jpg","visual_representativeness":0.9104523658752441},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","photo_id":"SCVp-Dfagf10SyFI4wHptQ","label":"food","image_url":"/photos/SCVp-Dfagf10SyFI4wHptQ.jpg","visual_representativeness":0.9073402881622314},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","photo_id":"Rvicr0aHz-qSIPgRs31HIw","label":"food","image_url":"/photos/Rvicr0aHz-qSIPgRs31HIw.jpg","visual_representativeness":0.8763274550437927},{"business_id":"WOPDfnVDLW32xsnm7Bx2ZA","photo_id":"MbyecOxYL4IUz_GGdAgpGw","label":"food","image_url":"/photos/MbyecOxYL4IUz_GGdAgpGw.jpg","visual_representativeness":0.863060712814331}]},"notebook_case":null}
