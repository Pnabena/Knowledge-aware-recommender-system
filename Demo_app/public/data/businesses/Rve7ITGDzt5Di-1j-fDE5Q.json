cal_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Rve7ITGDzt5Di-1j-fDE5Q","review_id":"E-Wx24DbraNIB3q6G4Wh_w","date":"2011-03-05T02:46:41","stars":5,"text_representativeness":0.9212759733200073,"text_excerpt":"DELICIOUS. I stopped here during Mardi Gras to get a bite to eat before the chaos started. It was a delicious success-this was after I initally went to McCalisters across the street (b/c I saw it first), stood in line behind 3 people for 5 minutes and decided to leave b/c the service was so slow. As I walked out, I noticed that the line behind me was about 5 people deep! I'm glad that I decided to go to Roly Poly Sandwiches after my sad McCalister's experience just moments before. The service was QUICK the food was GREAT (try the California Hummer-wow) and it was less expensive than I expected. I will certainly be back!!!"},{"business_id":"Rve7ITGDzt5Di-1j-fDE5Q","review_id":"6hKD1t7b_p2gYPK64jE73g","date":"2012-04-16T02:00:27","stars":4,"text_representativeness":0.9146146774291992,"text_excerpt":"The Santa Fe chicken is SO good. I first tasted Roly Poly during Voodoo fest a few years ago and started coming here shortly thereafter. They're a little expensive for sandwich wraps, but they're really good! If you get the food to go, sometimes the dressing makes it soggy, which is annoying... but, like I said, it's really good."},{"business_id":"Rve7ITGDzt5Di-1j-fDE5Q","review_id":"9nc6AcXZFPWTqUcBF-rsdg","date":"2012-12-04T01:23:08","stars":5,"text_representativeness":0.9073700904846191,"text_excerpt":"Roly poly is one of my favorite places to go. The chicken or steak fajita is always dank, but if you like interesting flavor combos try the thai hot tuna or the basil cashew chicken. Another good tip if you're in a rush, call ahead and order takeout. It will be ready in about 5-10 minutes which is about how long it takes if you order in the store. Good place for a healthy and tasty lunch or dinner."}],"visual":[]},"notebook_case":null}
