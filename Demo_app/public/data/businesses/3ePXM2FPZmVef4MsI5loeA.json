,"rank_movement":495,"has_visual_feature":true,"name":"City Greens","address":"5001 Freret St, Ste B","city":"New Orleans","state":"LA","postal_code":"70115","stars":3.5,"review_count":28,"categories":["Sandwiches","Salad","Wraps","Vegetarian","Restaurants"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"3ePXM2FPZmVef4MsI5loeA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1842,"mm_rank":1347,"target_category_support_fraction":0.4,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Sandwiches","historical_business_count":0},{"category":"Salad","historical_business_count":0},{"category":"Wraps","historical_business_count":0},{"category":"Vegetarian","historical_business_count":1},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants, Vegetarian","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"3ePXM2FPZmVef4MsI5loeA","review_id":"dkftIbno0b-2LV6P4Q1EBw","date":"2019-06-07T01:10:29","stars":5,"text_representativeness":0.9376078844070435,"text_excerpt":"Just visited City Greens on Freret for the first time on today and I love the vibe here! Earlier in the week I noticed they would be opening soon, so I was anticipating grabbing a salad after a gym sesh. Plus, I had never had City Greens before! As soon as I walked in I was a fan of the spot. It's super clean, well air-conditioned and the wall art inside is so colorful and fun. I appreciate that they have charging ports near the wall, because I had just left the gym with my phone dying. I was greeted by the staff who let me know they could answer any questions I may have. I winded up going with the Southwest Salad ($8.95) which consists of avocado, black beans, corn, tomato, shaved onion,..."},{"business_id":"3ePXM2FPZmVef4MsI5loeA","review_id":"LZQ9cvH4BCa9xKfdyJF12g","date":"2021-05-19T20:41:59","stars":4,"text_representativeness":0.9347870349884033,"text_excerpt":"This was my second time at City Greens. The first was years ago and my thoughts are still the same. It's a great quick and healthy option for lunch on the go. I don't think it's better than what I could make at home or get at a salad bar but the menu options are a little more unique. I got the Truffalo Caesar salad for $15. Basically a combo of a truffle caesar salad and buffalo chicken. It was good and a little more unique than your typical caesar (I'm a sucker for truffle but it wasn't overwhelming). Super friendly service, very fast and ingredients were fresh. I would go again!"},{"business_id":"3ePXM2FPZmVef4MsI5loeA","review_id":"32u4899Saw3Z0nH2ARZ8WA","date":"2021-05-14T19:38:19","stars":5,"text_representativeness":0.9247879385948181,"text_excerpt":"Coming from NYC, I'm used to 10 different salad places on my block so was super excited when I came across City Greens. I order from there 1-2 times a week and think their quality is consistent and never had any issues! I recommend the spicy peanut dressing, it's my personal favorite!"}],"visual":[{"business_id":"3ePXM2FPZmVef4MsI5loeA","photo_id":"ymQlMpRgc9v13e4jw9haZQ","label":"inside","image_url":"/photos/ymQlMpRgc9v13e4jw9haZQ.jpg","visual_representativeness":0.9168127775192261},{"business_id":"3ePXM2FPZmVef4MsI5loeA","photo_id":"7jjT5CV94IcjuawViBHekg","label":"food","image_url":"/photos/7jjT5CV94IcjuawViBHekg.jpg","visual_representativeness":0.8687270879745483},{"business_id":"3ePXM2FPZmVef4MsI5loeA","photo_id":"W_I-r1FosTXuxJNcWSY5Ew","label":"food","image_url":"/photos/W_I-r1FosTXuxJNcWSY5Ew.jpg","visual_representativeness":0.8508807420730591}]},"notebook_case":null}
