id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1662,"mm_rank":1443,"target_category_support_fraction":1.0,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Seafood","historical_business_count":2},{"category":"Food","historical_business_count":3},{"category":"Restaurants","historical_business_count":8},{"category":"American (Traditional)","historical_business_count":2},{"category":"Nightlife","historical_business_count":5}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Nightlife, Restaurants","shared_category_count":3},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Nightlife, Restaurants","shared_category_count":2},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Nightlife","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"okxomeADinzNXTzX9PqVSg","review_id":"yvznksy7asWPKu_6QJGYyQ","date":"2011-02-17T17:28:06","stars":4,"text_representativeness":0.9388554096221924,"text_excerpt":"My boyfriend wanted to watch the Sunday football game and we came across this place. I was sick of seafood, so this was perfect... bar food and cheap. We walked in, there was no where to seat and no staff cared to help us or tell us to hold on. After about 10 mins we got a table ourselves. The place itself was kinda blah... but had lots of TVs. The food was surprisingly good. I love chicken fingers and fries and they fit my craving. My boyfriend got the chicken sandwich and said it was one of the better chicken sandwiches he has had."},{"business_id":"okxomeADinzNXTzX9PqVSg","review_id":"zYtmz9JSTI9-38yuelaS3A","date":"2009-11-23T16:18:32","stars":4,"text_representativeness":0.9299553632736206,"text_excerpt":"This place is great because it's one of the few places in NO with all NFL games playing on Sundays. The bloody mary's here are not great...stick with beer. The food smelled good but was not hungry while there. Since they deliver, I'll definately order some stuff for delivery while I'm here."},{"business_id":"okxomeADinzNXTzX9PqVSg","review_id":"t0EJtOAlkY07i7tYkVzRiw","date":"2010-02-17T02:52:51","stars":4,"text_representativeness":0.923121452331543,"text_excerpt":"Came here for dinner during Mardi Gras. Not much else was open and the wait at some of the other places (Deanie's I'm talking about you). The restaurant was at capacity, but luckily I was able to score a seat at the bar. Food took a while to come out, but luckily alcohol was near instantaneous, that is after you get the bartender's attention. I ordered the hot sausage po'boy and boy was it delicious! The sausage patties had great flavor with a slight spicy kick. The fries were okay. $12 got my my po'boy and a beer. Not bad at all."}],"visual":[{"business_id":"okxomeADinzNXTzX9PqVSg","photo_id":"tz2AF4HWBIwC7aXNOYP9Hw","label":"food","image_url":"/photos/tz2AF4HWBIwC7aXNOYP9Hw.jpg","visual_representativeness":1.0}]},"notebook_case":null}
