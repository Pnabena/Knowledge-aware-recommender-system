y":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee & Tea","historical_business_count":1},{"category":"Food","historical_business_count":3},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"BRXYWO_BPuLZqDjuDERLTw","review_id":"fjX-AfASt3K0RwCDtieVJQ","date":"2010-11-19T13:10:27","stars":4,"text_representativeness":0.9230216145515442,"text_excerpt":"I eat here fairly often. They have panini sandwiches, club sandwich, etc. Excellent and fresh. Also salads. They have lovely pastries from Haydel's bakery and from Sucre', and gelato from Angelo Brocato. LOL Need I say more? They also serve wine. You are always made to feel most welcome. I love the espressos and cappuccinos there too :-) This place is a real find in the French Quarter. There is an outside patio as well. Added bonus: Free Wi-Fi. Stop by and say hello to Schuyler and the friendly staff :-)"},{"business_id":"BRXYWO_BPuLZqDjuDERLTw","review_id":"08H5xtPNQ5Wc1DTSTQa1xg","date":"2015-08-31T15:13:43","stars":5,"text_representativeness":0.9219125509262085,"text_excerpt":"I have been here several times over the years. It is a good coffee stop in the French Quarter. I was going to an early, elevenses tea at Salon by Sucre not so far away and was in the Quarter 40 minutes early and needed a place to hang out. I remembered Antoine's Annex and went there. I got a really excellent cafe au lait. I also got a savory potato pastry which was delicious. I probably shouldn't have done that, considering where I was going but, oh well. I'll deal with the scale later. The staff were really nice. Recommended."},{"business_id":"BRXYWO_BPuLZqDjuDERLTw","review_id":"ibp-QzWBFJF5bckvuKaHFQ","date":"2013-08-04T15:24:43","stars":4,"text_representativeness":0.9199259281158447,"text_excerpt":"I would have liked to try Antoine's Restaurant, but couldn't fit it into my schedule with my long list of restaurants to go to in the French Quarter. At Antoine's Annex I just got an iced coffee with soy and it was some of the best iced coffee I had down in New Orleans. It's in a good location right on Royal Street, so if you're looking for coffee or pastries (they looked pretty good) I'd check this place out."}],"visual":[{"business_id":"BRXYWO_BPuLZqDjuDERLTw","photo_id":"bnEo2lzz8A00AJCExPtxXQ","label":"inside","image_url":"/photos/bnEo2lzz8A00AJCExPtxXQ.jpg","visual_representativeness":0.9538878798484802},{"business_id":"BRXYWO_BPuLZqDjuDERLTw","photo_id":"BEtaTvxz4UcjCPMktRjKFg","label":"inside","image_url":"/photos/BEtaTvxz4UcjCPMktRjKFg.jpg","visual_representativeness":0.9538878202438354}]},"notebook_case":null}
