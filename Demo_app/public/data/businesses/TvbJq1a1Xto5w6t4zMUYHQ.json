ount":5},{"category":"Food","historical_business_count":3},{"category":"Tapas/Small Plates","historical_business_count":0},{"category":"American (New)","historical_business_count":2},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Bars, Breakfast & Brunch, Cocktail Bars, Nightlife, Restaurants","shared_category_count":6},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"TvbJq1a1Xto5w6t4zMUYHQ","review_id":"6akMNTK7rC0JNbbr5KaHjw","date":"2019-08-21T16:33:32","stars":5,"text_representativeness":0.9448808431625366,"text_excerpt":"I love this place! It's in a church so that's already beautiful and interesting. Their happy hour has some amazing drinks that I liked even better than the ones on the regular menu. The bartenders are super friendly. I would love to go back to try the food but I'll definitely be back for the happy hour."},{"business_id":"TvbJq1a1Xto5w6t4zMUYHQ","review_id":"CwJmY0iHFcQdqMazkDBe6g","date":"2019-01-02T16:37:21","stars":5,"text_representativeness":0.9425548315048218,"text_excerpt":"I. Love. This. Place. I went here with my friends before an event- we made a reservation as we had 8 people. I don't recommend showing up in a big group without a reservation, but if you have 2-4 people, you should be fine without one. We were sat at the round table in the back. All the \"decorations\" were very cool. The sides of the table had name plate engravings (we think it's the donors for the church?) and of course the amazing stained glass at the bar. The ambience is very cool- I don't really have words to describe it. The service was great, we had a little difficulty breaking up the bill, but again, we had 8 people and were expecting that. Now the food, I ordered the brussels sprou..."},{"business_id":"TvbJq1a1Xto5w6t4zMUYHQ","review_id":"PH_sVirqEhLRnpmt0odbIg","date":"2019-06-09T03:20:03","stars":5,"text_representativeness":0.9382836818695068,"text_excerpt":"The atmosphere of this place is spot on, a renovated church that is open and beautifully lit. The bar is beautiful, complete with a sliding ladder! the dining room is cozy but not crowded, and the room sound is dialed in. The bartender was helpful and provided my friend a good option for her cocktail. He made her a special bourbon concoction and I ordered the green sizzle (omg, so refreshing!!!). We started with the pickle plate, it arrived quickly, was novel and fun, pickled strawberries anyone?! Plus kraut, carrots, and fennel. The pork belly app was the best I've had! The lamb burger was good but the French fries that came with were bomb and stole the show! Everyone at the table was ea..."}],"visual":[{"business_id":"TvbJq1a1Xto5w6t4zMUYHQ","photo_id":"mB