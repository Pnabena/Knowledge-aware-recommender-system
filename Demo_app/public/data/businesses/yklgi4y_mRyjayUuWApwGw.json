ory":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"yklgi4y_mRyjayUuWApwGw","review_id":"2MyiI0JkBq2QnyoEZwn8-A","date":"2016-08-29T19:28:42","stars":4,"text_representativeness":0.9334092140197754,"text_excerpt":"I usually stop here with my mom after lunch during the week for an afternoon caffeine boost. The girls who work here are super sweet and outgoing. They already know our order as soon as we walk through the door, which makes each transaction here feel personal and like they genuinely care about their regulars. They always have fun facts/games on their tip jar as an incentive to tip, but there is no better incentive than their excellent customer service and talented baristas. They make really unique and delicious flavored coffees, and often have samples available. They also serve wine- so really, what's not to love?! Great location across the street from the Superdome, which happens to be i..."},{"business_id":"yklgi4y_mRyjayUuWApwGw","review_id":"TxJ-vWW7KiwXWskaS69Bww","date":"2019-07-10T23:14:53","stars":4,"text_representativeness":0.9119965434074402,"text_excerpt":"My favorite spot for a lunchtime pick-me-up. I adore this cute little PJ's on Poydras. It happens to be a walk away from my workplace downtown and I often visit for a quick muffin bite or to get some of their refreshing lemonade! Service is typically pretty speedy and I love the area near the back with lounge seats and funky art. This spot is great to grab coffee before work, chill during your lunch break, get a little work done on your laptop or chat with a friend."},{"business_id":"yklgi4y_mRyjayUuWApwGw","review_id":"i5nbSUUsq_ZkOqNa2fW_IA","date":"2013-06-11T14:46:06","stars":5,"text_representativeness":0.8812384605407715,"text_excerpt":"Clean and convenient coffee shop. Fast service even with a constant flow through the door. Some small foods like bagels, muffins, and brownies."}],"visual":[]},"notebook_case":null}
