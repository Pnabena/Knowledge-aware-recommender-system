":[{"category":"Mexican","historical_business_count":1},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Mexican, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"_ZFnHfTCKl6xJ44niI0bdA","review_id":"61EI9Te_dULZx5N4ByGLdw","date":"2016-04-19T19:59:41","stars":5,"text_representativeness":0.9323371052742004,"text_excerpt":"Just finished lunch here with a friend of mine, and I can't wait to go back! I might be heading back for dinner tonight... It was quick, even though there was a bit of a line right at noon, we didn't wait for too long. My friend and I got salads, drinks, and some chips and dip for a total of $20 I think (she paid...). The veggies were fresh. The spicy pico is indeed SPICY and freshly made. Also, I could probably have just had a cup of the cilantro ranch dressing. That is the marriage of 2 of my favorite ingredients. The service was warm and friendly both while we ordered and when they said goodbye to us. I am so excited to have found this place!"},{"business_id":"_ZFnHfTCKl6xJ44niI0bdA","review_id":"RkJLWkrl-k3ZV0t5jzqHcg","date":"2015-02-08T23:26:30","stars":4,"text_representativeness":0.9244275093078613,"text_excerpt":"Located in downtown New Orleans (two locations), the staff were polite and efficient. The prices are good, and you get a hugely-stuffed burrito. I got the chicken burrito, fully dressed, with white & Mexican rice, pinto beans, onions, pico-de-gallo sauce, jalepenos, sour cream, lettuce, and two kinds of hot sauces. The hot sauces weren't really very hot, but the burrito was delicious. I would return to this place! RJT"},{"business_id":"_ZFnHfTCKl6xJ44niI0bdA","review_id":"q-MRDY-36zGws0Z0KTgM5A","date":"2015-02-09T20:16:20","stars":4,"text_representativeness":0.9230493307113647,"text_excerpt":"This is a great Mexican lunch spot in the CBD. I love the options here - comparable to Felipe's, or a chain like Chipotle/Qdoba. The restaurant is small inside - definitely gets \"cozy\" during a busy lunch rush!"}],"visual":[]},"notebook_case":null}
