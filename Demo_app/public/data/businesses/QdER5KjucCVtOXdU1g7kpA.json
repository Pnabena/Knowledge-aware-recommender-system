eature":true,"name":"Pepper Palace","address":"224 Chartres St","city":"New Orleans","state":"LA","postal_code":"70116","stars":4.5,"review_count":187,"categories":["Specialty Food","Herbs & Spices","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"QdER5KjucCVtOXdU1g7kpA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":509,"mm_rank":413,"target_category_support_fraction":0.3333333333333333,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Specialty Food","historical_business_count":0},{"category":"Herbs & Spices","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"QdER5KjucCVtOXdU1g7kpA","review_id":"k3j3j9iL-zhrSxvbcRij6w","date":"2015-05-29T18:56:27","stars":5,"text_representativeness":0.9416908621788025,"text_excerpt":"This place is AWESOME if you're a fan of spiciness! They have all kinds of hot sauces, salsas, wing sauces, and even jams and you can taste test all of them!! The staff were very knowledgeable and answered questions as I tried them, including best pairings, recommendations, etc. Loved the whole experience, and there were so many I wanted to buy. Of course, I had to see/try what was their 10+'s (spiciest) were. They had two, and when the staff pointed out the #1 hot sauce in the world, I had to try it! And guess what, I had to sign a waiver. No bs, and I dipped the veryyyyyyy tip of a chip and wow it built up quick, sweating after 30 seconds. The staff recommended a spoonful in chili and t..."},{"business_id":"QdER5KjucCVtOXdU1g7kpA","review_id":"Y401-Kt-1A16KyMcOPfkyQ","date":"2015-06-19T13:07:52","stars":4,"text_representativeness":0.9386049509048462,"text_excerpt":"This place is great. They have a variety of sauces, dips, and some of the hottest salsas you will ever try. I like the you can sample them before buying. Be sure to bring a bottle of water or they sell them for $1 because you are going to need it!"},{"business_id":"QdER5KjucCVtOXdU1g7kpA","review_id":"EhPndmJ1M0z1JgR7J5EjmQ","date":"2018-06-06T16:33:07","stars":5,"text_representativeness":0.9360822439193726,"text_excerpt":"Ok...I was literally in heaven. I LOVE hot sauce and the spicier, the better. But that's not all they have. They have jellies, seasonings, bbq sauces, salsa...and the list goes on. They have all of their samples lined up on their large wrap around bar with the sample cups in front of the bottle of your choice. You have chips you can dip them in...but please don't double dip:) You can find some local goodies made right in New Orleans. A little on the pricey side for one bottle of hot sauce, but if my tongue is burning off with just two drops of the sauce...it's going to last me a while. That makes it all worth it to me:)"}],"visual":[{"business_id":"QdER5KjucCVtOXdU1g7kpA","photo_id":"vebq6_DxgC6SkuGc0YsgUQ","label":"drink","image_url":"/photos/vebq6_DxgC6SkuGc0YsgUQ.jpg","visual_representativeness":0.8896192312240601},{"business_id":"QdER5KjucCVtOXdU1g7kpA","photo_id":"CDKSolGmaeMMWeCvL0ZSbw","label":"inside","image_url":"/photos/CDKSolGmaeMMWeCvL0ZSbw.jpg","visual_representativeness":0.8874266147613525},{"business_id":"QdER5KjucCVtOXdU1g7kpA","photo_id":"VLQov_qkwF4PgPm4Glu01A","label":"drink","image_url":"/photos/VLQov_qkwF4PgPm4Glu01A.jpg","visual_representativeness":0.8839117288589478},{"business_id":"QdER5KjucCVtOXdU1g7kpA","photo_id":"mbASOjzJKE777dW4vTi5tg","label":"inside","image_url":"/photos/mbASOjzJKE777dW4vTi5tg.jpg","visual_representativeness":0.8771147727966309},{"business_id":"QdER5KjucCVtOXdU1g7kpA","photo_id":"526Bj8U-_CYVSdjkc33NBg","label":"outside","image_url":"/photos/526Bj8U-_CYVSdjkc33NBg.jpg","visual_representativeness":0.8128907084465027}]},"notebook_case":null}
