TQhA","business_row":973,"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","nv_rank":706,"mm_rank":634,"nv_score":-0.0005180723965167999,"mm_score":0.10056251287460327,"rank_movement":72,"has_visual_feature":true,"name":"La Carreta","address":"1814 Magazine St","city":"New Orleans","state":"LA","postal_code":"70130","stars":4.0,"review_count":109,"categories":["Restaurants","Mexican"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":706,"mm_rank":634,"target_category_support_fraction":1.0,"selected_image_count":3,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Mexican","historical_business_count":1}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Mexican, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","review_id":"HSum6RBgb4MAa47KTNa7gw","date":"2019-09-05T17:23:02","stars":5,"text_representativeness":0.9491098523139954,"text_excerpt":"My fav Mexican place so far in Nola. I take Mexican food seriously and this place pleases. Queso is top notch. Chips are delicious. The steak tacos are amazing. Their sides of beans and rice are also wonderful. I have had great meals from La Carreta delivered on Waitr. Visiting the brick and mortar was cool too. The atmosphere is adorable and everyone was super friendly. Daily specials. I can remember $2 tacos on Tuesday and all day happy hour on Thursday's. It's on the smaller side inside but they are quick and efficient. They have a couple outdoor tables as well. Street parking only."},{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","review_id":"R5jTZRSFrSg1318EW83SzQ","date":"2017-12-05T16:38:52","stars":5,"text_representativeness":0.9442721605300903,"text_excerpt":"Finally, a Mexican food joint in New Orleans that I can get excited about. So many positive things to mention about La Carreta on Magazine St. First up, absolutely delicious margaritas prepared with fresh ingredients. We tried the mango, cucumber, traditional and strawberry mint margaritas - all were delicious! My favorites were the mango and the strawberry mint. The latter was original and amazing. Second, the decor is cute AF. The VW bus bar is adorable. Love the chill, laid back and relaxed vibe that has enough special details (skeleton wearing a poncho and riding a bicycle? YAS) to keep your eyes entertained. Third, the food is very good. I had the tamales, which also came with a chil..."},{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","review_id":"tgnzkD7BA4wW74nCtJzATA","date":"2018-09-11T02:40:46","stars":5,"text_representativeness":0.9420548677444458,"text_excerpt":"I had the shrimp and fish tacos, and they were absolutely delicious! We had queso with our chips and salsa, which also did not disappoint. My boyfriend had a burrito that he really enjoyed as well. Our waitress was so sweet and was definitely attentive to us. We enjoyed having conversation with her while we were there. I really like the atmosphere of the place; the decor is really cool! Would recommend!"}],"visual":[{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","photo_id":"orJ51ic3cczL6FO2FgKKHA","label":"drink","image_url":"/photos/orJ51ic3cczL6FO2FgKKHA.jpg","visual_representativeness":0.9243227243423462},{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","photo_id":"QyZk2ILjFg2o245cH0rgjQ","label":"food","image_url":"/photos/QyZk2ILjFg2o245cH0rgjQ.jpg","visual_representativeness":0.9081054329872131},{"business_id":"OSrZ4BMMXaLSb5sxFpmA-g","photo_id":"GLaqYaEVjE5em6CLDjXGPg","label":"inside","image_url":"/photos/GLaqYaEVjE5em6CLDjXGPg.jpg","visual_representativeness":0.8611440062522888}]},"notebook_case":null}
