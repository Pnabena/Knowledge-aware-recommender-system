,"business_id":"UecV_nsSMyjiracwiV_avQ","nv_rank":886,"mm_rank":784,"nv_score":-0.32355737686157227,"mm_score":-0.13278508186340332,"rank_movement":102,"has_visual_feature":true,"name":"Ted's Frostop","address":"3100 Calhoun St","city":"New Orleans","state":"LA","postal_code":"70125","stars":4.0,"review_count":96,"categories":["Restaurants","Burgers","American (Traditional)","Diners"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"UecV_nsSMyjiracwiV_avQ","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":886,"mm_rank":784,"target_category_support_fraction":0.5,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Burgers","historical_business_count":0},{"category":"American (Traditional)","historical_business_count":2},{"category":"Diners","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"UecV_nsSMyjiracwiV_avQ","review_id":"cFBkeFmRU06t3ePwBoAirw","date":"2016-07-28T21:47:09","stars":5,"text_representativeness":0.9194842576980591,"text_excerpt":"I love a good burger joint and this one is great. I had an intense craving for a Frostop burger and root beer and I satisfied it today for lunch. The burgers are made to order, so be a little bit patient. It will take just a few minutes, but the wait will be worth it. Juicy meat, good pickles (this is a MUST), and crinkle-cut fries that are perfectly seasoned. Don't forget the root bear, which is excellent. Be sure to put it in a frozen mug, which is right next to the fountain machine. I need to go back more often. Maybe for dinner tonight...? P.S. Bonus points for old-school pinball machines!"},{"business_id":"UecV_nsSMyjiracwiV_avQ","review_id":"ajy96RCnhnh5Nj3V98zXiQ","date":"2015-10-23T03:59:23","stars":5,"text_representativeness":0.9178940057754517,"text_excerpt":"Wouldn't change a thing! I agree that this is more a place of nostalgia than anything, but the cheeseburger was exactly what I had hoped for, as were the crinkle cut fries. It is nothing fancy, but the rootbeer is great, and the food is served at the right speed. Very casual, and a great place to bring kids after school, as seemed to be the norm when I was there around 4:00 PM."},{"business_id":"UecV_nsSMyjiracwiV_avQ","review_id":"3S1R8ESkFDVwdn_4vEuOtA","date":"2014-11-25T20:33:44","stars":4,"text_representativeness":0.9158267378807068,"text_excerpt":"I like Ted's Frostop. It's a no frills yet friendly locals type of place. The workers know the customers and the orders don't change it's really not more to ask for. They serve a pretty good breakfast and lunch. My preferred meals include the cheeseburger, and the catfish. Its pretty fresh and made on the spot. No complaints here. The root beer is pretty yummy as well but expect to get a sugar. Ample parking so shouldn't have any problems there as well. I suggest going in for lunch. It takes you back a little and enjoy a lunch special!"}],"visual":[{"business_id":"UecV_nsSMyjiracwiV_avQ","photo_id":"Kr0syRkg6pkpgsLxSNzsIw","label":"food","image_url":"/photos/Kr0syRkg6pkpgsLxSNzsIw.jpg","visual_representativeness":0.9149049520492554},{"business_id":"UecV_nsSMyjiracwiV_avQ","photo_id":"OiSO754phXNMCFvp2Q4J0g","label":"outside","image_url":"/photos/OiSO754phXNMCFvp2Q4J0g.jpg","visual_representativeness":0.8255040645599365},{"business_id":"UecV_nsSMyjiracwiV_avQ","photo_id":"-pMlawE98pfsDYubTAwljw","label":"outside","image_url":"/photos/-pMlawE98pfsDYubTAwljw.jpg","visual_representativeness":0.774213969707489}]},"notebook_case":null}
