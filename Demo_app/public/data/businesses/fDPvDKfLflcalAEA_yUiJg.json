y_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"fDPvDKfLflcalAEA_yUiJg","review_id":"7nJpn7qRDWPaliEc4jwX9A","date":"2013-08-13T02:02:18","stars":4,"text_representativeness":0.902742326259613,"text_excerpt":"Gotta love the open container laws in NOLA. Pick a flavor and take a daiquiri to go. It's like a big alcoholic slushie."},{"business_id":"fDPvDKfLflcalAEA_yUiJg","review_id":"nTg2U1OK0hfFg00WoGiW9A","date":"2014-09-01T15:57:58","stars":4,"text_representativeness":0.9012265205383301,"text_excerpt":"$10 for a regular $13 for a XL +$1 for an extra shot Favorite flavors: Peach Bellini and Jungle Juice. Busy place, especially during festivals, but the employees do a great job of taking multiple orders to work through the masses. They're friendly too. I like this location because they have the AC on high but also leave the large doors open. Best of both worlds. Park yourself on a stool at the bar to enjoy your brain-freezing beverage or take it and keep wandering the Quarter. They have pizza too, but with so many other great food choices in the vicinity... why? I'd only suggest a slice if you are drunk and need a quick snack to hold you over until dinner somewhere better."},{"business_id":"fDPvDKfLflcalAEA_yUiJg","review_id":"LZOjJlhQssXHUuJdL6a1gQ","date":"2013-12-08T21:45:09","stars":4,"text_representativeness":0.8917738795280457,"text_excerpt":"Other than the price of the daiquiris, the place is decent. Nice selection and you can get a beer if you don't want to put your man card away while drinking one of these."}],"visual":[{"business_id":"fDPvDKfLflcalAEA_yUiJg","photo_id":"_M92ByOJkZV0YnGdWwMVOg","label":"inside","image_url":"/photos/_M92ByOJkZV0YnGdWwMVOg.jpg","visual_representativeness":0.9140363335609436},{"business_id":"fDPvDKfLflcalAEA_yUiJg","photo_id":"-rVLt3yTw5C3D4wSvzvxLA","label":"inside","image_url":"/photos/-rVLt3yTw5C3D4wSvzvxLA.jpg","visual_representativeness":0.9140362739562988}]},"notebook_case":null}
