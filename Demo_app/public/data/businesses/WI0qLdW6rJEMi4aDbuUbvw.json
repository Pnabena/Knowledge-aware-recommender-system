l,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Desserts","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"WI0qLdW6rJEMi4aDbuUbvw","review_id":"-4XSpqpP9F_OH2XrhuuQHA","date":"2018-05-13T23:57:57","stars":5,"text_representativeness":0.9403383731842041,"text_excerpt":"Pinkberry is such a good treat!!! I'm usually into the chocolate hazelnut but just tried the pecan pie and all I can say is YES! I usually don't do any milk related products but on occasion I just crave it, the huge variety of toppings doesn't hurt either :) The smoothies are good as is the frozen yogurt and I can't wait to go back and try the new strawberry lemonade!! The location is great with plenty of other food options near by so maybe after a good meal here in mid-city you want to cap it all off?? Summer is real and Pinkberry helps beat the heat."},{"business_id":"WI0qLdW6rJEMi4aDbuUbvw","review_id":"ynH64o-RsUZQqLFHh19MMg","date":"2014-07-08T20:33:35","stars":5,"text_representativeness":0.9337918758392334,"text_excerpt":"Dear Pinkberry in Mid City, Thank you so much for being there. After a long flight, after a long day, and even when I'm just in the mood for something sweet, I can always count on you. I don't ask for much- just some plain yogurt with strawberries, kiwis, cookie dough, chocolate chips, and honey, and you always pull through. Thank you for being open when I need you to be (*ahem* except for breakfast) and incredibly consistent. Until next time (tonight)... Love, Amanda"},{"business_id":"WI0qLdW6rJEMi4aDbuUbvw","review_id":"sky0zYL_NLg2dm_rxBwbMA","date":"2020-07-18T02:10:00","stars":5,"text_representativeness":0.9316424131393433,"text_excerpt":"I never really get frozen yogurt anymore, but I'm so glad I decided to stop in for some Pinkberry the other day! I ordered the strawberry & banana smoothie--it was the perfect amount of sweet! I will definitely be trying some of their other flavors & frozen yogurt soon!"}],"visual":[{"business_id":"WI0qLdW6rJEMi4aDbuUbvw","photo_id":"N5pfi93E1Svu60y9uUuvpg","label":"inside","image_url":"/photos/N5pfi93E1Svu60y9uUuvpg.jpg","visual_representativeness":0.8866381645202637},{"business_id":"WI0qLdW6rJEMi4aDbuUbvw","photo_id":"jghaWGfzlQBg0UoTGlRkoA","label":"food","image_url":"/photos/jghaWGfzlQBg0UoTGlRkoA.jpg","visual_representativeness":0.8866381645202637}]},"notebook_case":null}
