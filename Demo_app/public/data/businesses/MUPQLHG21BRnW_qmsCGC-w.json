:2,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Candy Stores","historical_business_count":0},{"category":"Specialty Food","historical_business_count":0},{"category":"Desserts","historical_business_count":0},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"MUPQLHG21BRnW_qmsCGC-w","review_id":"R6NaxvIhM1nb9p3mRPgTzw","date":"2017-04-10T01:33:09","stars":5,"text_representativeness":0.9325772523880005,"text_excerpt":"This smelled amazing walking by. By the third time that my friend and I walked past this place during our adventure around Nola, we decided to stop by and try out something. I've been all chocolate/fudged out, but I definitely wanted to try something from this place. I ended up trying out the home made strawberry lemonade drink and my friend got one of their milkshakes. The man behind the fudge is a very outgoing man who calls his sweets \"his children\". A man who loves what he does and is proud of his work...that's just awesome. I did get to try a piece of him fudge and it was REALLY good. I just couldn't buy it without eating it in one sitting and judging myself. LOL! If you're in the ar..."},{"business_id":"MUPQLHG21BRnW_qmsCGC-w","review_id":"hcvEk5GNedc5EF9M0EYZ-A","date":"2019-03-12T14:01:02","stars":4,"text_representativeness":0.9227718114852905,"text_excerpt":"The chocolate scent wafting in the air around corner brought us in here to explore. What a sweet little shop! When we entered they offered us samples of anything we wanted to try. They were also making a fresh batch of New Orleans pecan praline fudge. We were able to watch and all the while the confectioner was singing and smiling. It was so entertaining and fun! As soon as it cooled he passed around samples. Delicious! They have beaucoup flavors of fudge, rice krispie treats, candy apples, shakes, ice cream and even giant marshmallows rolled in oreos, peanut butter cups, m&m's-if you can think it, The Fudgery is one step ahead of you! Next time you're in the French Quarter go let the awe..."},{"business_id":"MUPQLHG21BRnW_qmsCGC-w","review_id":"xYb96MI2RxSrsTg95FOiVw","date":"2019-02-23T06:19:54","stars":4,"text_representativeness":0.9197576642036438,"text_excerpt":"If you love fudge and want to try different flavors, then check out this place. Located inside the French Quarter (right by Jackson Square) next to a couple of other shops. I bought the cookies and cream fudge (trying to be adventurous) and let me tell you, it was worth the try! It IS on the pricey side (I paid $11 for half a pound). They have other flavors available along with Rice Krispies (different flavors and outer coating)."}],"visual":[{"business_id":"MUPQLHG21BRnW_qmsCGC-w","photo_id":"JH9Pp3Wv7QS-w2f3p29Xbw","label":"food","image_url":"/photos/JH9Pp3Wv7QS-w2f3p29Xbw.jpg","visual_representativeness":0.8918015956878662},{"business_id":"MUPQLHG21BRnW_qmsCGC-w","photo_id":"mAX2E49FWRYm3Rz8oco61Q","label":"inside","image_url":"/photos/mAX2E49FWRYm3Rz8oco61Q.jpg","visual_representativeness":0.8918014764785767}]},"notebook_case":null}
