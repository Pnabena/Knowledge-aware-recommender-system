ore":-0.25436681509017944,"rank_movement":68,"has_visual_feature":true,"name":"Church Alley Coffee Bar","address":"4201 Canal St","city":"New Orleans","state":"LA","postal_code":"70119","stars":4.0,"review_count":72,"categories":["Coffee & Tea","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":988,"mm_rank":920,"target_category_support_fraction":1.0,"selected_image_count":5,"label_diversity":4,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee & Tea","historical_business_count":1},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","review_id":"YwB50E6jTWAk5bi4mPb0Lw","date":"2015-10-08T18:57:47","stars":4,"text_representativeness":0.926753044128418,"text_excerpt":"Nice coffee shop with a neighborhood feel. I don't do caffeine, but they have a decent tea selection and seem to always have at least one non-caffeinated option. I've had a few of their pastries, which have been very tasty. There's comfortable seating and a chess board floating around somewhere if you're inclined to play a game. When you first walk in, the space seems huge, but most of it is the Zeitgeist center, which is co-located in the building (and which you need to walk through to access the restrooms). Zeitgeist hosts movie screenings and other events, but for the most part, I don't think the operating hours overlap with Church Alley's, so it's a pretty quiet space. Overall, a good..."},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","review_id":"b7GYfaroUSDe4Lqorco6Ag","date":"2017-11-22T15:04:02","stars":5,"text_representativeness":0.9251196980476379,"text_excerpt":"I had passed this place for months, living only several blocks away. It looks super cute but my hours and theirs, have never jived. Then, on a day off, a friend and I were planning to meet for coffee so I suggested we go there. It's located at the bottom of a recently renovated apartment building. I believe there are only two units above. Very nice, cute finish out. It's quaint, cozy, has fresh baked goods, coffee and teas. Service was somewhat slow but also friendly and hospitable. I was meeting someone for a quick meet and coffee so I didn't have any of the food items. Next time :) I would recommend and would definitely return."},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","review_id":"JPpiMqcg4PSwy8HIpbW-jg","date":"2020-03-03T22:38:25","stars":4,"text_representativeness":0.9132393598556519,"text_excerpt":"This is a lovely coffee shop. There are tons of windows (read natural light), plants, and seating. They have a cool side room that is comfy and could be a cute sun room in your own house. They have good tea, food, and chocolate chip cookies (a personal favorite). They serve drinks in mugs and glasses which I always favor (save the Earth), and it is just more comfy. They seem to be socially conscious and environmentally friendly. They even compost their paper towels - neat! The only issue is sometimes it's hard to find (street) parking, but isn't a big deal."}],"visual":[{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","photo_id":"TFiubH5kEoJBsjmG1crBLw","label":"outside","image_url":"/photos/TFiubH5kEoJBsjmG1crBLw.jpg","visual_representativeness":0.8849910497665405},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","photo_id":"fIYIy-eLpw1GKF69llsXpw","label":"inside","image_url":"/photos/fIYIy-eLpw1GKF69llsXpw.jpg","visual_representativeness":0.8729825019836426},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","photo_id":"19t7tzUq9hEqUHjm6z0A3A","label":"drink","image_url":"/photos/19t7tzUq9hEqUHjm6z0A3A.jpg","visual_representativeness":0.8330992460250854},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","photo_id":"p4faFRGGnVvcMnpe6rYipQ","label":"food","image_url":"/photos/p4faFRGGnVvcMnpe6rYipQ.jpg","visual_representativeness":0.8123879432678223},{"business_id":"nHsoeVL1dXs9ZNjmdrlPuA","photo_id":"BeOOhpe7zKnUaAe3QzodPw","label":"outside","image_url":"/photos/BeOOhpe7zKnUaAe3QzodPw.jpg","visual_representativeness":0.782050371170044}]},"notebook_case":null}
