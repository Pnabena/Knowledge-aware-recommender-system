lap":[{"category":"Food","historical_business_count":3},{"category":"Farmers Market","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"fw2E3GYpoJ2rq1YmzoBSmQ","review_id":"cwIlyu-kak3HtDuScCSYXw","date":"2016-03-27T04:17:54","stars":4,"text_representativeness":0.9502357840538025,"text_excerpt":"My friends and I were browsing through the French Market on a Thursday morning and decided to stop here for a bite to eat for lunch. Overall, I was very satisfied with my entire dining experience and would definitely go back! My friends and I sat down and right away we were greeted and handed a menu. Then, one of the employees also told us about the menu items listed on the hanging chalkboards above. Our server was very nice. She asked us if we were out of town, which two of us were, and she welcomed us to NOLA. Now onto food: One of my friends ordered the crawfish po-boy, another ordered the foot long hot dog, and I ordered the crab cake sandwich. Our food got to us in a very timely mann..."},{"business_id":"fw2E3GYpoJ2rq1YmzoBSmQ","review_id":"veufT8BrhlUpIYIbmenNWw","date":"2014-05-27T20:12:28","stars":5,"text_representativeness":0.933282732963562,"text_excerpt":"Stopped on a whim for alligator bites. Yum! Although I didn't think the portion was that big for $10. But I'm pretty picky about how my alligator is cooked and they do it right Fried green tomatoes were amazing. It was so good that we kept on ordering food. Had the spiral fries and crab cake. The spiral chips are like a fat kids wet dream. Very interesting and delicious. I will dream about them. The crab cake was awesome, I would like to try the sandwich. YOU MUST GO HERE if you are in the French Market. Try something new, it's all good here!!"},{"business_id":"fw2E3GYpoJ2rq1YmzoBSmQ","review_id":"FcPzQCK4JNMkLwbaXhQtqQ","date":"2016-06-14T06:38:40","stars":5,"text_representativeness":0.9180512428283691,"text_excerpt":"Love this place. My go to place in the French market. They have the best alligator bites and potato combo. It keeps me coming back for more. The owner is very nice to us every time we stop by he comes out and serves us."}],"visual":[{"business_id":"fw2E3GYpoJ2rq1YmzoBSmQ","photo_id":"kYHFWcI5hHDJGy1gDAymfg","label":"inside","image_url":"/photos/kYHFWcI5hHDJGy1gDAymfg.jpg","visual_representativeness":0.8860673308372498},{"business_id":"fw2E3GYpoJ2rq1YmzoBSmQ","photo_id":"PgAUbeV29JqBUwo6fITbjg","label":"food","image_url":"/photos/PgAUbeV29JqBUwo6fITbjg.jpg","visual_representativeness":0.886067271232605}]},"notebook_case":null}
