_support_fraction":0.6666666666666666,"selected_image_count":0,"label_diversity":0,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Burgers","historical_business_count":0},{"category":"American (Traditional)","historical_business_count":2},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"wXyHGKmlvQUBGexb2my0JQ","review_id":"bGGv0W0_ZcVFAgd8scobug","date":"2011-10-30T17:30:20","stars":4,"text_representativeness":0.949305534362793,"text_excerpt":"My bff and I went here yesterday for a burger and fries. I had the double cheeseburger (with bacon), vanilla shake and cheese fries. She had the veggie burger (she debated bacon, but eventually decided against it), cheese fries and chocolate malt shake. The shakes are served with big straws, which is nice. We ordered at the counter and didn't have any problems noticing that we would need to bus our table when we were done. The burgers were excellent, the fries were perfect, the shakes were really good. My burger was so juicy that it soaked through the bottom bun. This may be a problem for some, but it was so good I just didn't care. The menu is very simple which makes for easy decisions. ..."},{"business_id":"wXyHGKmlvQUBGexb2my0JQ","review_id":"hKSYZLHVajh_IZjYm3VYdQ","date":"2017-07-22T22:34:04","stars":5,"text_representativeness":0.9450167417526245,"text_excerpt":"Their veggie burger was delicious!! Best one I've had so far. It was almost bright purple because of the beets. I tried to ask for it wrapped in lettuce though and the lady told me they'd only be able to put the lettuce on the side which I thought was strange so I just got the bun. Also their fries were those shoe-string fries and they were delicious! Would definitely come back here again!"},{"business_id":"wXyHGKmlvQUBGexb2my0JQ","review_id":"BDM5yPjxQrmdjp7FU0WeYw","date":"2013-01-15T04:57:39","stars":5,"text_representativeness":0.9417335987091064,"text_excerpt":"I've been wanting to try this place for a while. And they have great choices of speciality burgers. It's a little cheaper than company burger I think. Definitively my favorite burger joint."}],"visual":[]},"notebook_case":null}
