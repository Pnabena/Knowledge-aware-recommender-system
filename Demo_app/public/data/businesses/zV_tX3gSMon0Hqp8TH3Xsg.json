s":[]},"ranking":{"user_row":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":2494,"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","nv_rank":1174,"mm_rank":1092,"nv_score":-0.5223217010498047,"mm_score":-0.3815552294254303,"rank_movement":82,"has_visual_feature":true,"name":"District Donut & Coffee Bar","address":"5637 Magazine St","city":"New Orleans","state":"LA","postal_code":"70115","stars":4.0,"review_count":97,"categories":["Bakeries","Restaurants","Specialty Food","Coffee & Tea","Donuts","Breakfast & Brunch","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1174,"mm_rank":1092,"target_category_support_fraction":0.5714285714285714,"selected_image_count":3,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Bakeries","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Specialty Food","historical_business_count":0},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Donuts","historical_business_count":0},{"category":"Breakfast & Brunch","historical_business_count":1},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Breakfast & Brunch, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","review_id":"bzQ2HVhKK2iUmHP-r2fwew","date":"2015-12-04T16:06:09","stars":4,"text_representativeness":0.9319482445716858,"text_excerpt":"In search for a quick coffee while picking up items on Magazine street, I finally had the opportunity to come by the younger sibling of District Donuts Sliders Brew. A little bigger than a food truck with only outdoor seating; this is a great spot for a grab 'n' go coffee and bite to eat. The interior was nice and toasty while I waited, and has cute references to pi (as in 3.14). I grabbed my usual, a mocha, and their Kung Pao Chicken hand pie. The jury is still out if I think the hand pie was worth $5, but it is damn delicious in my opinion. Hand pies start with the breading, and they're nailing it. Perfectly flaky, warm, and not stale in the least bit. I like the kick to the chicken, an..."},{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","review_id":"W3IT6R7F80NZpg3trMfueg","date":"2018-12-10T03:43:16","stars":4,"text_representativeness":0.931633710861206,"text_excerpt":"Wanting to explore this part of Magazine Street, I had bookmarked this little spot on Yelp to visit. It was mid-morning during the week and I was able to check out District Donut. I must give y'all a fair warning there is very limited seating here. It's all outside and there's probably about 12 seats total. This location is more of a grab-n-go spot. They have an assortment of donuts, kolaches, and sandwiches to select from. I was craving a biscuit so I decided to do my go-to bacon and cheddar. The sandwich was so good, and I loved the biscuit itself. The portion was big and it definitely held me over for the day. The coffee was good but not necessarily my taste. Nothing wrong with that wh..."},{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","review_id":"1IoKo4JVc-sWBog4VWNhMg","date":"2015-07-13T06:12:51","stars":4,"text_representativeness":0.927026629447937,"text_excerpt":"Friendly/knowledgable staff, cool interior and outside seating. The BREAKFAST PIE was delicious and savory. I think the bread:filling ratio was perfect because the bread itself is so, so good. District does their dough right. And the glazed croissant thing was also perfect: just a hint of sweetness, crispy on the outside and soft on the inside. I tried the NITRO COFFEE, which was not bad. Tasted like a good brewed coffee with a flavorful twist. I think I'll try one of their yolk-filled muffin/pies and Vietnamese sno-ball coffee next time!"}],"visual":[{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","photo_id":"922yZJqwo36D5RZ4m_Ft7g","label":"inside","image_url":"/photos/922yZJqwo36D5RZ4m_Ft7g.jpg","visual_representativeness":0.8916003704071045},{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","photo_id":"eOBK8j2UUaoHbD8MwDOwLQ","label":"food","image_url":"/photos/eOBK8j2UUaoHbD8MwDOwLQ.jpg","visual_representativeness":0.8814926147460938},{"business_id":"zV_tX3gSMon0Hqp8TH3Xsg","photo_id":"7IxzBUtKGCu7PVyP0D1sKA","label":"outside","image_url":"/photos/7IxzBUtKGCu7PVyP0D1sKA.jpg","visual_representativeness":0.8537237644195557}]},"notebook_case":null}
