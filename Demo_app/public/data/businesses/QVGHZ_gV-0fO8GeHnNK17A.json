bWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","review_id":"RgtrxN8mY1l0sjCXDAvvmg","date":"2019-02-12T21:27:40","stars":5,"text_representativeness":0.9431415796279907,"text_excerpt":"We were going on the St. Louis Cemetery No. 1 tour and were instructed to meet here. It's a bit of a walk outside of the main French Quarter but it was a cooler November morning so we did not mind. Once we got there you walk to the back to sign in and grab your drink tickets, this is also where the bathroom is located, there is only one but it's unsexed. They offer a 2 for 1 Hurricane drink deal for $12 before the tour starts so the placed was packed while everyone was trying to take advantage. The hurricane was a pre-mixed concoction in plastic pitchers but was decently good! The bartender was awesome and worked quick and efficiently. I obviously do not know much more about this place si..."},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","review_id":"LmW1yIWKvUb5o9U3KgNuUQ","date":"2016-05-02T04:49:30","stars":4,"text_representativeness":0.9422200918197632,"text_excerpt":"The meeting place for French Quarter Phantoms. What a fun bar. We got two tours so we spent a lit of time here. We started with the cemetery tour in the morning and got the experience the jug of hurricanes. 2 for 1? Yup, we all got 2. They weren't bad either. I mean they come with cool cups and make you want to pee half way through the tour. HA! The bartenders were so nice. One had a really cool bottle opener ring that I thought was magic. He was really cool and talked to us about places to eat and even the gay Christmas tree we ran into. I love that this bar was open 24/7 and just down the street from our hotel. Definitely miss this place. Cool people, cool place, and cool city."},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","review_id":"B7-ll9x3CG6vQ71AISo2SA","date":"2016-09-02T20:18:27","stars":5,"text_representativeness":0.9365498423576355,"text_excerpt":"I really liked this place. Visiting from out of state and scheduled a cemetery tour here. The tour went very well. Our guide, Steven Henno(I think), went above expectations for these kinds of things. He was very knowledgeable and expressed a genuine interest in the history and he was real likeable. On top of that the bar is great. Your tour gets you 24h Hurricanes which is grrreat. They were also playing real good music and the vibe was genuine. It didn't come off nearly as cheesy or touristy as a lot of the French quarter."}],"visual":[{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","photo_id":"-qRL27sSx8QuQttoZdZZMQ","label":"outside","image_url":"/photos/-qRL27sSx8QuQttoZdZZMQ.jpg","visual_representativeness":0.9299898147583008},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","photo_id":"KpYU6F30ndphkZ8FRkP_SQ","label":"inside","image_url":"/photos/KpYU6F30ndphkZ8FRkP_SQ.jpg","visual_representativeness":0.8708612322807312},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","photo_id":"7mF3tztARV7YTYAPsfqfBA","label":"inside","image_url":"/photos/7mF3tztARV7YTYAPsfqfBA.jpg","visual_representativeness":0.8691936731338501},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","photo_id":"AV9dM7A9zZ1zv9KxlsL_Ng","label":"inside","image_url":"/photos/AV9dM7A9zZ1zv9KxlsL_Ng.jpg","visual_representativeness":0.866454005241394},{"business_id":"QVGHZ_gV-0fO8GeHnNK17A","photo_id":"_kR3rLJjdeen9KDMk4Y6aw","label":"inside","image_url":"/photos/_kR3rLJjdeen9KDMk4Y6aw.jpg","visual_representativeness":0.7628711462020874}]},"notebook_case":null}
