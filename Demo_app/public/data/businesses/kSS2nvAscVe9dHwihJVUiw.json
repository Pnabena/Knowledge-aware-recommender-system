nside","selection_rank":4,"width":600,"height":400,"image_url":"/photos/SwjqC_mhv0Taa_MRpo3WQQ.jpg"},{"photo_id":"URHSCKg4IN2xaREPV0h3Vg","business_id":"kSS2nvAscVe9dHwihJVUiw","label":"inside","selection_rank":5,"width":300,"height":400,"image_url":"/photos/URHSCKg4IN2xaREPV0h3Vg.jpg"}],"review_excerpts":[]},"ranking":{"user_row":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":1899,"business_id":"kSS2nvAscVe9dHwihJVUiw","nv_rank":1573,"mm_rank":1126,"nv_score":-0.6562243103981018,"mm_score":-0.40084409713745117,"rank_movement":447,"has_visual_feature":true,"name":"Pizza Domenica","address":"3200 Banks St","city":"New Orleans","state":"LA","postal_code":"70119","stars":4.0,"review_count":46,"categories":["Pizza","Restaurants"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"kSS2nvAscVe9dHwihJVUiw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1573,"mm_rank":1126,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Pizza","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"kSS2nvAscVe9dHwihJVUiw","review_id":"Yx8U11I7EzTqnrjW-fbRWg","date":"2019-12-23T22:25:30","stars":5,"text_representativeness":0.9319047927856445,"text_excerpt":"First time eating at Pizza Domenica and it did not disappoint. My husband and I couldn't understand why this place only has 4 stars. Sometimes I wonder about myself because I give just about every restaurant we try 5 stars lol. The food was delicious from the appetizers to the pizza. We ordered the roasted cauliflower and garlic knots. Each came with it's own whipped cheese sauce. One was provolone fonduta and the other feta. I love any kind of cheese so I may be a little biased. All in all it was really good and I am already thinking about when I can return. Something to keep in mind is that Monday thru Friday there's happy hour, which means half priced pizzas, wine and beer. I would pay..."},{"business_id":"kSS2nvAscVe9dHwihJVUiw","review_id":"TLd1R6JUYtxtXUsPeA84UQ","date":"2019-09-20T21:24:06","stars":5,"text_representativeness":0.9291067123413086,"text_excerpt":"So excited to have Pizza Domenica in Mid City! Pizza Domenica has been our favorite pizza in the city for a couple years and it's great to have one in walking distance. What else is there to say other than best Pizza in New Orleans?! I think that pretty much sums it up. Same great happy hour specials as the other location and sister restaurants. The space seems a bit smaller than the others but get there and wait if you must, it's worth it."},{"business_id":"kSS2nvAscVe9dHwihJVUiw","review_id":"mYb7ySOnC614OwxuwMyv9Q","date":"2020-10-27T18:47:58","stars":5,"text_representativeness":0.9277716279029846,"text_excerpt":"I must say this is a extremely cute pizza place! I love the outdoor seating area. We started with the garlic bread knots and I don't know what they put in that whipped dipping sauce but it made those knots pop! Talk about good melt in your mouth bread. I ordered the Margherita pizza and the sauce was so tasty I wish I had ordered some on the side to dip my pizza in. The pizza dough was so light, crisp and soft all in one. We also got a classic cheese pizza which was also just as good. We ordered the Buffalo Chicken Stromboli which was the perfect amount of cheesy, Buffalo sauce goodness. It wasn't to hot either it was just right. We all concluded that this is one of our new favorite pizza..."}],"visual":[{"business_id":"kSS2nvAscVe9dHwihJVUiw","photo_id":"XJDX85K5SBPPmMx3GkYZ-A","label":"inside","image_url":"/photos/XJDX85K5SBPPmMx3GkYZ-A.jpg","visual_representativeness":0.8857868909835815},{"business_id":"kSS2nvAscVe9dHwihJVUiw","photo_id":"zve0H8FvsUeRherreh3OmQ","label":"outside","image_url":"/photos/zve0H8FvsUeRherreh3OmQ.jpg","visual_representativeness":0.879553496837616},{"business_id":"kSS2nvAscVe9dHwihJVUiw","photo_id":"YtwMbcEUE1-Qc8M-sga5eg","label":"food","image_url":"/photos/YtwMbcEUE1-Qc8M-sga5eg.jpg","visual_representativeness":0.8692408800125122},{"business_id":"kSS2nvAscVe9dHwihJVUiw","photo_id":"URHSCKg4IN2xaREPV0h3Vg","label":"inside","image_url":"/photos/URHSCKg4IN2xaREPV0h3Vg.jpg","visual_representativeness":0.8101749420166016},{"business_id":"kSS2nvAscVe9dHwihJVUiw","photo_id":"SwjqC_mhv0Taa_MRpo3WQQ","label":"inside","image_url":"/photos/SwjqC_mhv0Taa_MRpo3WQQ.jpg","visual_representativeness":0.8034290671348572}]},"notebook_case":null}
