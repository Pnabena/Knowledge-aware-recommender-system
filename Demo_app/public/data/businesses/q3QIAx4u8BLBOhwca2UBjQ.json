e_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Coffee & Tea","historical_business_count":1}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"q3QIAx4u8BLBOhwca2UBjQ","review_id":"kS73pMuT0uwgBtyfE5locA","date":"2017-08-21T15:32:52","stars":4,"text_representativeness":0.919342041015625,"text_excerpt":"PJ's has an impressive history in New Orleans, with the first branch opening in Carrollton in 1978. When I first visited New Orleans, PJ's and Community Coffee were kind of it for traditional American style coffee and espresso drinks; how times have changed. I've always been fond of the brand, and their stores are always gorgeous. It may be true that better coffee has come to town, but PJs holds a special place in my heart. Plus, the nitro brew is delicious; rich and dark with hints of caramel and chocolate. I'm always grateful when a local business opens in my neighborhood, as Magazine Street is in danger of looking like Anywhere, USA. And this location, right on the downtown edge of the..."},{"business_id":"q3QIAx4u8BLBOhwca2UBjQ","review_id":"41FSYj0apP-y9tzsQecDVg","date":"2018-05-28T03:33:23","stars":5,"text_representativeness":0.9122454524040222,"text_excerpt":"This is local NOLA version of their Starbucks. I ended getting a cold brew and ice water. The coffee is super strong and I loved it. It is a little pricey, even more than Starbucks but you need to suppose local business. The staff was friendly, the store front is clean."},{"business_id":"q3QIAx4u8BLBOhwca2UBjQ","review_id":"bAR_w0wEjHEO7Ew0-8zDsA","date":"2018-03-20T18:55:08","stars":4,"text_representativeness":0.9047532081604004,"text_excerpt":"This is a pretty good PJ's with a friendly staff. I love the fact that it's big and the windows let in a lot of natural light. I ordered my regular large iced coffee and it was good, but I think that the half and half I added to it was off. It had an odd taste, so I blame the add-in. There are plenty of big tables so that you can sit and do work and, of course, the wi-fi is free. This wouldn't be my first choice for a NOLA PJ's, mainly because there's a sketchy gas station across the street, but it gets the job done if you're in the area."}],"visual":[{"business_id":"q3QIAx4u8BLBOhwca2UBjQ","photo_id":"CnAY9PklMmG5pRbz116qzw","label":"inside","image_url":"/photos/CnAY9PklMmG5pRbz116qzw.jpg","visual_representativeness":0.9100246429443359},{"business_id":"q3QIAx4u8BLBOhwca2UBjQ","photo_id":"imKcgSHQGDD6lReD9t70KQ","label":"outside","image_url":"/photos/imKcgSHQGDD6lReD9t70KQ.jpg","visual_representativeness":0.9100245833396912}]},"notebook_case":null}
