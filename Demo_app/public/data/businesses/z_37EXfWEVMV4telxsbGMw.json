279,"nv_rank":647,"mm_rank":525,"target_category_support_fraction":1.0,"selected_image_count":4,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"z_37EXfWEVMV4telxsbGMw","review_id":"3M4p94HAEP2kc4esdYJMiA","date":"2012-05-02T19:16:02","stars":4,"text_representativeness":0.9415463209152222,"text_excerpt":"Cafe du Monde, in general, is a must-go-to if you love desserts, donuts and don't care about your waist line. AND it's the NOLA/tourist thing to do. I've been to the Original location in the French Quarter before and the crowd wasn't too crazy... this time around it was during Jazzfest weekend and it was packed! Even the take-out line was long... So we opted to try this location and hardly any line at all. Early morning and this mall was pretty dead. But the beignets and the frozen cafe au lait was just as I remembered, down to the powdered sugar going everywhere!... So worth it. My only issue was the workers were really slow and they got our order wrong. I'm sure it's an isolated issue, ..."},{"business_id":"z_37EXfWEVMV4telxsbGMw","review_id":"Yw8p_mpfYs2WCPwNfhYMMg","date":"2013-01-09T19:38:11","stars":5,"text_representativeness":0.9255714416503906,"text_excerpt":"You're in New Orleans. You better stop and get some beignets, especially from Cafe Du Monde. They're like puffy funnel cakes. What more do you want? My family and I came to this location because the one in the French Quarter was just too busy. Hell yes, I'd come back to this location or any CDM location to get some of the tasty beignets."},{"business_id":"z_37EXfWEVMV4telxsbGMw","review_id":"VPkPzzpxXDW2IUUg6pNPnA","date":"2012-10-16T14:52:38","stars":4,"text_representativeness":0.9241313934326172,"text_excerpt":"Get there early. We arrived just before 9am when they open and we were glad we did. We were 5th in line and by the time we got our coffee and beignets the line was getting long fast. The beignets were yummy, the coffee was not so great. Maybe it was because it was the first batch of coffee for the day? Not sure, but we've had chicory coffee before and this was just...meh. The beignets were piping hot when we received them and they were just perfect. The view of the water from this location is really nice. Be prepared to wait in line (even if you're 5th) it still took us 20 minutes to get the beignets and coffee. As is typical with New Orleans style, people take their own sweet time. There..."}],"visual":[{"business_id":"z_37EXfWEVMV4telxsbGMw","photo_id":"JVEttPium6VA14Ce9NV94w","label":"outside","image_url":"/photos/JVEttPium6VA14Ce9NV94w.jpg","visual_representativeness":0.8832839727401733},{"business_id":"z_37EXfWEVMV4telxsbGMw","photo_id":"uNn11SphB_Z42UYCyHiGHA","label":"inside","image_url":"/photos/uNn11SphB_Z42UYCyHiGHA.jpg","visual_representativeness":0.8206395506858826},{"business_id":"z_37EXfWEVMV4telxsbGMw","photo_id":"NS7fjb-JjshEJSDoFT-ebQ","label":"food","image_url":"/photos/NS7fjb-JjshEJSDoFT-ebQ.jpg","visual_representativeness":0.8202364444732666},{"business_id":"z_37EXfWEVMV4telxsbGMw","photo_id":"3U9mpeA4fF5adnJgsiHJ1w","label":"inside","image_url":"/photos/3U9mpeA4fF5adnJgsiHJ1w.jpg","visual_representativeness":0.7982585430145264}]},"notebook_case":null}
