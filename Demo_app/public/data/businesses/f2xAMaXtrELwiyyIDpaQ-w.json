272,"mm_score":-0.6400181651115417,"rank_movement":521,"has_visual_feature":true,"name":"McAlister's Deli","address":"5300 Tchoupitoulas St","city":"New Orleans","state":"LA","postal_code":"70115","stars":2.5,"review_count":42,"categories":["Sandwiches","Delis","Salad","Restaurants"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2299,"mm_rank":1778,"target_category_support_fraction":0.25,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Sandwiches","historical_business_count":0},{"category":"Delis","historical_business_count":0},{"category":"Salad","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","review_id":"ggSNU9Fs2Hnepzh5fZP0Kw","date":"2011-02-10T05:03:50","stars":4,"text_representativeness":0.9486430883407593,"text_excerpt":"Mcalisters is like a walk down memory lane for me. It reminds me of my college years when I would go and splurge on lunch between classes at USM. While I do realize that Mcalisters in the 'Burg isn't the same as the one on Tchop, it kinda is. This a franchise and my food taste exactly the same at both locations and I have frequented both. I like the New Yorker, similar to a Rueben. I also like the nachos, but I really like processed cheese (probly Velveta) and corn chips so very much. I also love the humongous sweet tea. I find if you stick with basics there you won't be disappointed. I wouldn't order a panini, and I am very skeptical of the entrees they now serve. But they have good soup..."},{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","review_id":"YsHiTDCnsc2p8CT5ps34ew","date":"2016-08-08T17:32:30","stars":4,"text_representativeness":0.934018611907959,"text_excerpt":"I come here often because it is very close to where I work, and it is a healthier, fast, fresh alternative to fast food. All I can say is they must have hired new people since the last people reviewed this McAlisters because I have had nothing but quick and friendly service. The salads and sandwiches are good, and the baked potatoes are delicious. Time and time again I am pleasantly surprised by the quality and portion size of the food and the service here. I have noticed that if you eat in, they are quicker than if you get your meal to go."},{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","review_id":"3vkW6bvoq1-R9-qgsAYGnQ","date":"2014-07-22T00:18:55","stars":4,"text_representativeness":0.9162781834602356,"text_excerpt":"This deli location is pretty chill for the most part. The cashiers are very welcoming and they are knowledgable of their menu items and prices. I like to visit this location when I get my bi-weekly mani/pedi at Star Nails(the best) nail salon. I always order the same thing from them: The Southwest Cobb salad and the Southwest turkey melt combo. It's onluy $6.99 and it gets me really full! I love the fresh guacamole and that Chipotle Ranch dressing is very good also. The place has many tables and they offer free wifi access. I like to go there and browse the net after my nails are dry. Overall, a good place to grab a quick lunch!"}],"visual":[{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","photo_id":"N8GKIDPuP3lF6JBeQHi1HQ","label":"drink","image_url":"/photos/N8GKIDPuP3lF6JBeQHi1HQ.jpg","visual_representativeness":0.9331303834915161},{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","photo_id":"K99XHL55J2MeCBX5Pkn9aQ","label":"food","image_url":"/photos/K99XHL55J2MeCBX5Pkn9aQ.jpg","visual_representativeness":0.877457857131958},{"business_id":"f2xAMaXtrELwiyyIDpaQ-w","photo_id":"VkILJ12jHruYx0-h7EpJwg","label":"food","image_url":"/photos/VkILJ12jHruYx0-h7EpJwg.jpg","visual_representativeness":0.856777012348175}]},"notebook_case":null}
