siness_count":8},{"category":"Bars","historical_business_count":5},{"category":"French","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Bars, Cocktail Bars, French, Nightlife, Restaurants","shared_category_count":6},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, French, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Apz4sB97NRa7iTPpznQLFA","review_id":"r6wRMo2CUGCj9VY0HgfrMg","date":"2018-05-20T22:07:33","stars":5,"text_representativeness":0.9307782649993896,"text_excerpt":"Amazing drinks and food! Stumbled into this spot upon realizing I wanted to escape Bourbon. The atmosphere was very down-to-earth, but the bartenders are masters of their craft! I enjoyed the flavors of every cocktail I tried. The place has ana amazing secret courtyard as well. Full-service kitchens putting out great quality food In the French Quarter this late at night are hard to come by, and the best thing is that the hours here are awesome. Highly recommended for an escape from all the tourist places and shitty dive bars in the area."},{"business_id":"Apz4sB97NRa7iTPpznQLFA","review_id":"awDKSkxAilaROoDt2JNYjQ","date":"2018-11-08T22:20:31","stars":5,"text_representativeness":0.9303176403045654,"text_excerpt":"Great addition to the FQ. The food here is delicious, and the drinks are. Creative as well. My favorite part of the menu is the shot and chaser combos. The Tully and pickle juice became my favorite Otherwise, the courtyard seating can accommodate larger groups, which is frequently difficult to do in the quarter. Definitely take a look at this place for a starting (or ending) point that is just off bourbon st"},{"business_id":"Apz4sB97NRa7iTPpznQLFA","review_id":"mI1pfcn4Adc5Hw8AlS7GRw","date":"2020-03-29T13:11:56","stars":5,"text_representativeness":0.9209240674972534,"text_excerpt":"Absolutely delicious brunch visit! Made a reservation via OpenTable, and upon arrival were told that reservations were for indoor seating only (courtyard is first come / first serve and fills fast). That was fine with us, as we were seated at a front booth by the window. We could still see outside and catch a bit of sunlight. The service was slow to start as they were jam packed, but I had no reason to worry. Eventually the server caught up, drinks and orders flowed our way, and he even made sure to bring us the check and pick up the receipt quickly once our meal was over. The food orders literally come as they are ready from the kitchen. You know they're made fresh because even if two pe..."}],"visual":[{"business_id":"Apz4sB97NRa7iTPpznQLFA","photo_id":"aiU1teMxuIytVAER3fqtOQ","label":"inside","image_url":"/photos/aiU1teMxuIytVAER3fqtOQ.jpg","visual_representativeness":0.8750433921813965},{"business_id":"Apz4sB97NRa7iTPpznQLFA","photo_id":"oopgt