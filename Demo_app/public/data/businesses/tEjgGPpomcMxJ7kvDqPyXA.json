ion":0.5,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Juice Bars & Smoothies","historical_business_count":0},{"category":"Acai Bowls","historical_business_count":0},{"category":"Coffee & Tea","historical_business_count":1}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","review_id":"xMWlEyabF_fCx_rDL4kjkA","date":"2021-08-15T22:40:47","stars":5,"text_representativeness":0.9291990399360657,"text_excerpt":"Finally got to try this place out and it did not disappoint. My husband is really into eating healthy so a place all about fresh fruit smoothies, avocado toast, and açaí bowls was right up his alley! I went with the blue tart because I like my smoothies really sweet and it was deliciously sweet and tart at the same time. Plus it was just really pretty. My husband got the chocolate lover I think it was called. It was cacao, avocado, banana, and maybe peanut butter? His was thick and definitely healthier/less sweet than mine. The combo of chocolate and avocado seems weird to me but I guess they make it work because he loved it! They also have fresh pressed juices and what was SO COOL, espec..."},{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","review_id":"oZDW8KKFKogYuR6pruH-WQ","date":"2021-07-18T15:49:28","stars":5,"text_representativeness":0.9267979860305786,"text_excerpt":"Loved this juice place. I normally juice myself and so this was really nice to be able to go and be able to pick up some different variations and different taste for change that was already done and didn't cause me to have to go through the whole process of actually making my own juice. The place is really nice and warm and the service was amazing it's one of those places that you can kind of go hang out with your friends instead of having a cup of coffee, you go get some fresh squeeze juice. So yeah if you're in the area you have got to try this place five stars definitely"},{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","review_id":"tw-hpCpaYPOCUP5fMb5lAw","date":"2021-04-25T17:58:24","stars":5,"text_representativeness":0.9088164567947388,"text_excerpt":"I just realized I took a bunch of photos but none of my smoothie or Shari V's juice. My bad. Will update later. So Main Squeeze is a Louisiana franchise and I think is based out of New Orleans. This was my first trip to any of their locations. This weekend is opening weekend. The workers were super friendly and handed out a few samples of their juices. I'm not a juice guy but these were tasty and according to the worker packed with immuno-whatevers. I got a smoothie - berry boost Shari V got a Vitality and nut bowel Update: I am at Main Squeeze now and just ordered a Chocolate Love I loved the Berry Boost. Lots of fresh fruit. Not overly sweet. They did a good job with created the recipe...."}],"visual":[{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","photo_id":"5wTjZMi3_K39JhBHlYhOQQ","label":"food","image_url":"/photos/5wTjZMi3_K39JhBHlYhOQQ.jpg","visual_representativeness":0.9129714965820312},{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","photo_id":"8_ozWLum7Z3tl7hK9qJ7Ww","label":"drink","image_url":"/photos/8_ozWLum7Z3tl7hK9qJ7Ww.jpg","visual_representativeness":0.8334773778915405},{"business_id":"tEjgGPpomcMxJ7kvDqPyXA","photo_id":"tbAtUOVziHvlR1dA2OmmAg","label":"drink","image_url":"/photos/tbAtUOVziHvlR1dA2OmmAg.jpg","visual_representativeness":0.7090335488319397}]},"notebook_case":null}
