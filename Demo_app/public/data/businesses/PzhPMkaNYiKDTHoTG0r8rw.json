abel":"food","selection_rank":4,"width":300,"height":400,"image_url":"/photos/QkL3_cJoUJjgbAylykMDAg.jpg"}],"review_excerpts":[]},"ranking":{"user_row":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":1030,"business_id":"PzhPMkaNYiKDTHoTG0r8rw","nv_rank":393,"mm_rank":380,"nv_score":0.5782709717750549,"mm_score":0.5484193563461304,"rank_movement":13,"has_visual_feature":true,"name":"Pho Cam Ly","address":"3814 Magazine St","city":"New Orleans","state":"LA","postal_code":"70115","stars":4.5,"review_count":178,"categories":["Vietnamese","Restaurants"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":393,"mm_rank":380,"target_category_support_fraction":0.5,"selected_image_count":4,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Vietnamese","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","review_id":"F9L-JiB60svUf2t4_Y3RPQ","date":"2019-07-28T16:58:45","stars":5,"text_representativeness":0.9480108022689819,"text_excerpt":"This place is pho-king delicious! Seriously, I haven't been able to find better pho than the pho chin (brisket) that they serve here. Further, their lemongrass chicken banh mi, spring rolls, and vermicelli (with soy sauce instead of fish sauce) are BOMB, and compared to other popular viet restaurants, their dishes are the best. The place is clean, beautiful, and you can't beat the prices. Come here!!! You will leave with a full belly and happy heart."},{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","review_id":"HaKTDS0omE_jZpuaY3mcdQ","date":"2020-09-27T23:29:21","stars":5,"text_representativeness":0.9406360983848572,"text_excerpt":"Have ordered takeout here several times pre and post Covid and it's always delicious! A lot of people are quite opinionated about pho broth but I guess I'm not that sophisticated- I think many Vietnamese places across the city have amazing pho broth. I typically get chicken but I'm also a fan of the vegetarian pho with tofu. And the spring rolls are so beautifully put together, fresh, and come with a generous amount of peanut sauce, which I appreciate. They don't skimp on the pho accompaniments and follow order notes perfectly. No pictures because I always devour everything immediately!"},{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","review_id":"EeScQBrziZZalzx2poVByg","date":"2019-04-15T04:36:37","stars":5,"text_representativeness":0.9393142461776733,"text_excerpt":"This was my favorite place for pho when living in New Orleans! I felt that it was a good mix and variety for anyone, no matter how new they were to Vietnamese food. The pho beef broth is flavorful and rich and the portions always leave me very full. Also, the pork steamed bao is huge and delicious. The pork has an incredible charred and sweet flavor to it with a freshness of the pickled veggies. Their crab rangoons are also very good, as is the pork vermicelli bowl. I loved going there on a cold day for a giant bowl of pho and leaving very full for $15 or less."}],"visual":[{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","photo_id":"Q-WDRVLskQtN4Lo-m97hhA","label":"inside","image_url":"/photos/Q-WDRVLskQtN4Lo-m97hhA.jpg","visual_representativeness":0.8724743127822876},{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","photo_id":"XZZ1RM7nj1wlrZ_Q5jI9TA","label":"inside","image_url":"/photos/XZZ1RM7nj1wlrZ_Q5jI9TA.jpg","visual_representativeness":0.8437057733535767},{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","photo_id":"3PC9Q_yMjfH38VY98WRzgQ","label":"food","image_url":"/photos/3PC9Q_yMjfH38VY98WRzgQ.jpg","visual_representativeness":0.8337411880493164},{"business_id":"PzhPMkaNYiKDTHoTG0r8rw","photo_id":"QkL3_cJoUJjgbAylykMDAg","label":"food","image_url":"/photos/QkL3_cJoUJjgbAylykMDAg.jpg","visual_representativeness":0.7995423078536987}]},"notebook_case":null}
