I8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","review_id":"T2Gepa0eqCUGZPEvj6k7WQ","date":"2015-05-30T22:04:06","stars":4,"text_representativeness":0.9346158504486084,"text_excerpt":"A cool locals bar. It's always an extreme laid back crowd here. They have live music and trivia which is always good. On Wednesdays they sometimes have a late night crawfish boil which is free just keep buying beer and supporting the bar!"},{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","review_id":"77tAy1SOtL5lqjM95KJ92w","date":"2016-12-16T02:40:43","stars":4,"text_representativeness":0.9242376685142517,"text_excerpt":"A fun local bar with friendly patrons! We stumbled upon his place after getting a little off the beaten path roaming the garden district in search of a cemetery. Although we stopped in just to use the bathroom and get our bearings, we ended up staying for well over an hour enjoying cheap beers and idle chitchat with our fellow bar mates. There was a Saints Game on, and everyone was uber excited even though apparently this tends to be the hangout for Michigan fans. (Yes, NOLA really *does* have everything.) The only downfall is that the ladies room was pretty dismal and kind of gross. However, it's a dive bar, not the Monteleone. 4 stars for what it is!"},{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","review_id":"ITKNz_8W39LZKdMi3ByLAg","date":"2021-08-10T00:12:38","stars":5,"text_representativeness":0.9157352447509766,"text_excerpt":"This is a dive bar, but a non-smoking dive bar so I'm über happy. It was fun and friendly and even had a decent choice of beers (I was absolutely shocked). They have 2 IPAs, a stout, Guinness, etc. it wasn't busy but it was friendly but not nosy. Fun!"}],"visual":[{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","photo_id":"JxVjQ-BXyNDXMd3e5DumDg","label":"inside","image_url":"/photos/JxVjQ-BXyNDXMd3e5DumDg.jpg","visual_representativeness":0.9764772057533264},{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","photo_id":"g-fiHhiNEMnD2btNEk97Mg","label":"inside","image_url":"/photos/g-fiHhiNEMnD2btNEk97Mg.jpg","visual_representativeness":0.9572629928588867},{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","photo_id":"FOe_7ysQ-A8-zY1MBY7MQQ","label":"inside","image_url":"/photos/FOe_7ysQ-A8-zY1MBY7MQQ.jpg","visual_representativeness":0.9434146285057068},{"business_id":"vl-E0kX8I-hZ5pekRXBhDQ","photo_id":"RM9xFAOfoAPZxc90vybSUg","label":"inside","image_url":"/photos/RM9xFAOfoAPZxc90vybSUg.jpg","visual_representativeness":0.9304299354553223}]},"notebook_case":null}
