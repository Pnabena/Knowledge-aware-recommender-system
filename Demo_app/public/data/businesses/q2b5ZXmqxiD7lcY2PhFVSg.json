null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Beer","historical_business_count":1},{"category":"Wine & Spirits","historical_business_count":1},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Beer, Food, Wine & Spirits","shared_category_count":3},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"q2b5ZXmqxiD7lcY2PhFVSg","review_id":"7f_Bj3whwjbJyrJR0Ewo8Q","date":"2015-08-05T15:57:43","stars":5,"text_representativeness":0.9453532695770264,"text_excerpt":"New wine shop in my neighborhood and I get to be FTR. This is a rare opportunity 'round these parts these days. The people behind Grande Krewe are as welcoming as can be. As soon as my friends and I entered the store last night, we were offered a glass of the coldest rosé (the only way one should drink rosé, in my opinion) as we browsed. The shop is small, but stocked full of a great variety of bottles from around the world (sectioned accordingly). I was most impressed with the bubbly section. Yes, they had your Doms, your Krugs and your Veuves, but a good selection of mid range priced bottles I've never heard of (small batch?) Porch pounders (new word I learned!) on the bottle shelf. The..."},{"business_id":"q2b5ZXmqxiD7lcY2PhFVSg","review_id":"Mv3PXuhNL2GKrbmc0BH3_w","date":"2016-05-30T18:59:03","stars":5,"text_representativeness":0.9366533756256104,"text_excerpt":"This place is awesome. Great old / new world selections. Liquor selection gets better and better. If you want to do blind tasting, just set your price per person and they will pick bottles out for you and practically give you a class on the wine! I love this place!"},{"business_id":"q2b5ZXmqxiD7lcY2PhFVSg","review_id":"iOP1ux9RKbbrCaZ9Ucn-Jg","date":"2021-08-17T18:06:36","stars":5,"text_representativeness":0.9242143630981445,"text_excerpt":"I had never been to this wine shop before as I'm the type that picks up wine from my grocery store, but I was attending their anniversary party with my Krewe to provide atmosphere and pour champagne. I figured as long as I'm here, I should take a bottle home (make it two!) I described the types of varietals and regions I enjoy, and their salesperson recommended 5 bottles that I would enjoy. I took home an Israeli Gewürztraminer and a New Zealand Sauvignon blanc. SO friendly, and accommodating!"}],"visual":[{"business_id":"q2b5ZXmqxiD7lcY2PhFVSg","photo_id":"hnBt7W5TXKu3aifIMpZNyw","label":"outside","image_url":"/photos/hnBt7W5TXKu3aifIMpZNyw.jpg","visual_representativeness":0.8316083550453186},{"business_id":"q2b5ZXmqxiD7lcY2PhFVSg","photo_id":"2EW4uZTFsvpPa2kvC-W5NA","label":"drink","image_url":"/photos/2EW4uZTFsvpPa2kvC-W5NA.jpg","visual_representativeness":0.8316082954406738}]},"notebook_case":null}
