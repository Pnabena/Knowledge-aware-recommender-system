gory_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"C6YaSrMAzy3jJqinlFVudw","review_id":"Bd2QjrFjXiArxHiVQmmLiw","date":"2012-08-03T19:37:01","stars":4,"text_representativeness":0.9403610229492188,"text_excerpt":"The food here is outstanding... not real healthy though. I have been eating here for years. There were times almost every day. Since it had been a while, I met a friend there for lunch today. Everything is made fresh. I got the soup/salad combo. Of course, it hit the spot. My friend got the egg salad sandwich. You are get a lot of food for the money. They are quick and friendly. Make sure to check out their daily specials which you can do online. If you're in the CDB for lunch time, this is a fabulous place to come! The owners are super cool. Always helpful and service with a giant southern smile!"},{"business_id":"C6YaSrMAzy3jJqinlFVudw","review_id":"jutpz-AJIGma-CKvK2BIBg","date":"2017-07-19T13:36:56","stars":4,"text_representativeness":0.9359636306762695,"text_excerpt":"I enjoyed Welty's. I got the California Club on a ciabatta, and when I first got the sandwich, it looked too big to finish, but I somehow managed to eat all of it. I also enjoyed the fruit cocktail that is available as a side. Great spot for lunch. It's nice to have it so close to work."},{"business_id":"C6YaSrMAzy3jJqinlFVudw","review_id":"0Xv2KjxGIoYaCehXwyq3gg","date":"2018-07-24T04:45:13","stars":5,"text_representativeness":0.9340312480926514,"text_excerpt":"Our group of four ate here for lunch. The staff were so friendly and welcoming, came over to ask how everything was. You order at the counter and pick up there after they call out your number. Everyone so enjoyed the food. My Reuben was delicious. Prices are very reasonable. It's a busy place, understandably. Lots of local business people there on lunch break. Definitely give Welty's a try while in town."}],"visual":[{"business_id":"C6YaSrMAzy3jJqinlFVudw","photo_id":"y4eXHKepeS0EqB2kg2Ebhw","label":"outside","image_url":"/photos/y4eXHKepeS0EqB2kg2Ebhw.jpg","visual_representativeness":0.9002068042755127},{"business_id":"C6YaSrMAzy3jJqinlFVudw","photo_id":"RgMzM-_8SatrrI5GVNr8-g","label":"inside","image_url":"/photos/RgMzM-_8SatrrI5GVNr8-g.jpg","visual_representativeness":0.8930731415748596},{"business_id":"C6YaSrMAzy3jJqinlFVudw","photo_id":"v88TvRRy5OgSy_hQOn975g","label":"inside","image_url":"/photos/v88TvRRy5OgSy_hQOn975g.jpg","visual_representativeness":0.8874858617782593},{"business_id":"C6YaSrMAzy3jJqinlFVudw","photo_id":"l2U6PvJvrZ9b46icyM9H-A","label":"food","image_url":"/photos/l2U6PvJvrZ9b46icyM9H-A.jpg","visual_representativeness":0.7990161180496216},{"business_id":"C6YaSrMAzy3jJqinlFVudw","photo_id":"eJUMDenCUPz_clgxLy4Qxw","label":"food","image_url":"/photos/eJUMDenCUPz_clgxLy4Qxw.jpg","visual_representativeness":0.7469504475593567}]},"notebook_case":null}
