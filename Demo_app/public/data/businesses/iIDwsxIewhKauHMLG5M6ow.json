score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Desserts","historical_business_count":0},{"category":"Cupcakes","historical_business_count":0},{"category":"Bakeries","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"iIDwsxIewhKauHMLG5M6ow","review_id":"2fKzOkfZAxfPVE1gCUSYnw","date":"2018-01-02T19:55:11","stars":5,"text_representativeness":0.929353654384613,"text_excerpt":"If you prefer traditional cakes with buttercream frosting then this bakery is right up your alley. I've tried a red velvet cake from here and on my most recent visit, an almond buttercream cake. Both were delicious and I received a lot of compliments on the almond buttercream one I picked up. It tasted just like wedding cake. I like O'Delice's cakes because they're moist, the icing is fluffy and most importantly, they're not too sweet. The texture is PERFECT. I ruined my diet this past weekend because of them but those slices were probably worth it. I know that they can make custom cakes and other small pastries but I usually just stop in if I need to pick up a birthday cake. Their standa..."},{"business_id":"iIDwsxIewhKauHMLG5M6ow","review_id":"NhReqIM_2Jly_lioLbquew","date":"2013-06-27T02:22:16","stars":5,"text_representativeness":0.9273906350135803,"text_excerpt":"I want to marry their almond croissants!!!! Honestly, I haven't been to France, but I imagine they are as good at this place as they are from any Parisian patisserie. This is a great local bakery that is runned by very friendly owners who are always super nice. I only recently discovered this place and now regret not having found it sooner. Aside from the almond croissants, their praline cheesecake and mini pies are also divine. I haven't had an opportunity to sample their cakes but I can only imagine that they are amazing, and plan on ordering a custom one for my significant other's birthday. They do accept credit cards but there is a $10 minimum. I also have gotten coffee there which is..."},{"business_id":"iIDwsxIewhKauHMLG5M6ow","review_id":"zcbS9eYGVJpY2_hRuR74ZA","date":"2011-03-25T22:18:51","stars":5,"text_representativeness":0.9269973039627075,"text_excerpt":"This is a small French Bakery owned by a Vietnamese family. The cakes are super delish and moist. I ordered a red velvet and OMG it was a big hit with everyone. Best I ever had! Next time I'll be back to try the strawberry shortcake."}],"visual":[{"business_id":"iIDwsxIewhKauHMLG5M6ow","photo_id":"LE8_9ueE7yO8ESXDwT0bgg","label":"inside","image_url":"/photos/LE8_9ueE7yO8ESXDwT0bgg.jpg","visual_representativeness":0.9095724821090698},{"business_id":"iIDwsxIewhKauHMLG5M6ow","photo_id":"Xq2pArjJ3pYvXHI0LmpcWw","label":"food","image_url":"/photos/Xq2p