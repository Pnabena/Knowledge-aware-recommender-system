ry":{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1375,"mm_rank":834,"target_category_support_fraction":1.0,"selected_image_count":5,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee & Tea","historical_business_count":1},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","review_id":"MK6EChElFaqb3-1Q8R45QA","date":"2020-12-05T21:14:49","stars":5,"text_representativeness":0.9396207332611084,"text_excerpt":"Love this place! Great coffee/tea and a huge, beautiful space for downtown. The decor is beautiful - I'd love to hang out here with some friends when COVID permits. There is an outdoor courtyard which is very pretty and seating on the sidewalk if you don't want to sit inside, but also plenty of room to social distance inside. The barista (or maybe the owner) was incredibly friendly and sweet - which I always love about shops and really makes this place feel more like a neighborhood joint. Makes me wish I was still working downtown so I could go more."},{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","review_id":"Sg9zewy24GZY1DPfSkslHg","date":"2021-05-21T18:07:45","stars":5,"text_representativeness":0.9297922849655151,"text_excerpt":"This is literally the coolest coffee shop I've been in. This space is perfect for working. They have a variety of teas and simple coffee beverages on their menu. I'm sure the barista can make special drinks if you need them. They have a beer cooler with some craft beers and hard seltzers. Their courtyard is perfect if you prefer being outside, but the inside is amazing. There is a reading room with tons of books if you want a cool space to vibe. I love it here. Super hipster, extra chill."},{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","review_id":"d2AqjOmkuAPMKVf0drmMWQ","date":"2021-11-20T14:43:40","stars":4,"text_representativeness":0.9238560199737549,"text_excerpt":"Like others say you come here for the ambiance! Stellar place and they serve coffee, doesn't really matter whether it's good or bad. Wish there was music playing or live music as they have the space already set. Should never not have live music."}],"visual":[{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","photo_id":"S9zyt1Uq2eibjAcquVSCMw","label":"outside","image_url":"/photos/S9zyt1Uq2eibjAcquVSCMw.jpg","visual_representativeness":0.9522808790206909},{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","photo_id":"xXx2xPdacZovTCxpG3ZGkQ","label":"inside","image_url":"/photos/xXx2xPdacZovTCxpG3ZGkQ.jpg","visual_representativeness":0.8810949325561523},{"business_id":"mXnlC59Wqe_Q8lAxmchBJg","photo_id":"Dfmz1WfqSdpg1oMiLAUVsA","label":"inside","image_url":"/photos/Dfmz1WfqSdpg1oMi