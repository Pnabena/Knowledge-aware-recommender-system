n":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"o1DccASlMWUWZfXj33lJ0g","review_id":"_wZGowrNjIufXYRN1Ab0Hg","date":"2015-11-11T23:10:52","stars":5,"text_representativeness":0.9282184839248657,"text_excerpt":"Sometimes you just really need ice cream. You've got cookies, cake, candy. Whipped cream and juju babies. But you NEED ice cream. The magic of the texture...soft...smooth...full and cool, dissolving across your palate into liquid velvet. The taste almost seems to change and it makes it's way into...in through you. Yeah. It's ice cream. This review isn't about sorbet, gelato, sherbet, or frozen yogurt. This review is about 2 scoops of the original treat, served from a sweet smelling shop in Mid-City. I probably eat ice cream 4 times a year, and rarely do I leave home with the sole intent of buying ice cream to eat right there. But I saw that there was a Baskin Robbins right in the heart of..."},{"business_id":"o1DccASlMWUWZfXj33lJ0g","review_id":"gac3O0Z9Gx3MDXhd03lyJA","date":"2014-12-02T01:25:59","stars":4,"text_representativeness":0.9232057332992554,"text_excerpt":"In an effort to thwart my stomach's unusual desire for sweet nothings to fall into it, i tried just drinking a bunch of water and tea. That might sound weird, but it was getting late, much too late for ice cream and it was the lesser of evils I could think of. .....So I walk into Baskin Robbins and have to maintain discipline as I try to not let my eyes be larger than my stomach. I think I succeeded a bit. I only ordered a banana split sundae with two scoops of vanilla bean, one scoop of chocolate chip, caramel, chocolate fudge, nuts, cherries, but HOLD the whipped cream, I'm trying to watch what I eat here ya know. So as I watched exactly what I ate go down into my belly, i was reminded ..."},{"business_id":"o1DccASlMWUWZfXj33lJ0g","review_id":"Yvnkm2NAJ0pKrthok2Aeag","date":"2014-08-21T05:53:03","stars":4,"text_representativeness":0.9196433424949646,"text_excerpt":"New Baskin Robbins! Staff is friendly, place is clean, and give you plenty of napkins. They sell slices of ice cream cake (OMNOMNOM!), the clown cones of my child hood, make smoothies that my husband adores and they make a pretty good banana split. Yum. What's not to love?"}],"visual":[{"business_id":"o1DccASlMWUWZfXj33lJ0g","photo_id":"cvE6zx3b-q5atY8LxexA8Q","label":"food","image_url":"/photos/cvE6zx3b-q5atY8LxexA8Q.jpg","visual_representativeness":0.9170699119567871},{"business_id":"o1DccASlMWUWZfXj33lJ0g","photo_id":"JuzaGozbzsyGPS9vqQ_Klw","label":"food","image_url":"/photos/JuzaGozbzsyGPS9vqQ_Klw.jpg","visual_representativeness":0.9170699119567871}]},"notebook_case":null}
