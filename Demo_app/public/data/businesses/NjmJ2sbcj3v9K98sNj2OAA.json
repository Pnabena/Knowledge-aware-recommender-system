Wine & Spirits"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"NjmJ2sbcj3v9K98sNj2OAA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1862,"mm_rank":1180,"target_category_support_fraction":0.7,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Nightlife","historical_business_count":5},{"category":"Fondue","historical_business_count":0},{"category":"Champagne Bars","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Food","historical_business_count":3},{"category":"Modern European","historical_business_count":0},{"category":"French","historical_business_count":2},{"category":"Bars","historical_business_count":5},{"category":"Beer","historical_business_count":1},{"category":"Wine & Spirits","historical_business_count":1}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Beer, Food, Nightlife, Restaurants, Wine & Spirits","shared_category_count":6},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, French, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, French, Nightlife, Restaurants","shared_category_count":4},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"NjmJ2sbcj3v9K98sNj2OAA","review_id":"JeNV-Qtg42yShoMdtnnK7A","date":"2011-05-13T07:30:59","stars":4,"text_representativeness":0.9405093789100647,"text_excerpt":"My friends suggested I try out Ste. Marie when I went down to NOLA for Jazzfest. I don't eat the different foods that people go crazy for down there and they felt Ste. Marie was the way to go. Those ladies were correcto! Love the room, high ceilings, huge map of NOLA on the wall and just a great space. Our waitress was really sweet and constantly came over to check in with us and make sure we were doing well. Drinks were well made, I loved the glass my drink was served in. I had a delicious salad to start and then they customized the eggplant sandwich for me without any dairy. It was DELICIOUS. Amazing bread and just so flavorful. Speaking of flavorful, the fries were out.of.this.world. I..."},{"business_id":"NjmJ2sbcj3v9K98sNj2OAA","review_id":"Mdiua2A08o23RYQ6TnaO5w","date":"2012-04-06T03:18:58","stars":5,"text_representativeness":0.9308497905731201,"text_excerpt":"I love this place. I mean I really, really love this place. The food is French and wonderful. The soft shell crab BLT is to die for. The salads are all refreshing and delicious. Their hanger steak and fries is very filling and worth the price. Bartenders are THE BOMB. They mix the best drinks - try the French 75, you won't be disappointed. Buy a bottle of Veuve Clicot and you can sign it and put in the champagne tower by the door. Ultra cool is their secret private room - in the middle of the champagne tower; you'd never know it was there."},{"business_id":"NjmJ2sbcj3v9K98sNj2OAA","review_id":"zAeJQQy2HLuz36kmSpB_kw","date":"2014-02-21T00:31:18","stars":4,"text_representativeness":0.9304335117340088,"text_excerpt":"Sainte Marie is right around the corner from us, so obviously I'd like it more than the average person. It is a little pricey but the service was phenomenal, despite going during All-Star weekend. The food was great too. I must say the apps is where it's at. And they have happy hour from 4-7pm which I love because we can go after work and not have to slam down drinks in a one crunch."}],"visual":[{"business_id":"NjmJ2sbcj3v9K98sNj2OAA","photo_id":"hl5ILGpx2y2RLtFm9DP07g","label":"inside","image_url":"/photos/hl5ILGpx2y2RLtFm9DP07g.jpg","visual_representativeness":1.0}]},"notebook_case":null}
