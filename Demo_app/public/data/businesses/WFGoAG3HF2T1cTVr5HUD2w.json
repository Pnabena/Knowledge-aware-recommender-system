9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","review_id":"aYKzFlytg5uCqAomF4i0XA","date":"2019-11-20T01:33:23","stars":5,"text_representativeness":0.9374877214431763,"text_excerpt":"I always go to the Kenner location so I was excited to see they opened up a New Orleans location! The margaritas are more expensive here than at the Kenner location but they are bigger so I suppose it's worth it lol. They are $3 on Tuesday's in kenner and 5.99 at the New Orleans location. The tacos did not disappoint as per usual. I also tried a new dessert today! The Mexican churros with ice cream. AMAZING! I just love chilangos and I was so happy to see they have a lot of business at the new spot!"},{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","review_id":"ultDydNXb87q-qChxHG0YA","date":"2021-06-25T18:03:43","stars":4,"text_representativeness":0.9291647672653198,"text_excerpt":"As far as Taco Tuesday goes, this is definitely my new favorite spot. They served shots for $1 and The tacos are $1 each (extra with add ons of course), and they hit every time. My favorites are the chorizo and the al pastor! Only criticism is I really dislike the salsa and the queso. The salsa is served hot (which I've never heard of lol but might just be me) and the queso just honestly isn't good."},{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","review_id":"1adVkVXP8mxUJ9MXdxP0tQ","date":"2020-01-07T04:39:42","stars":5,"text_representativeness":0.9263143539428711,"text_excerpt":"I'm super conflicted because if I rave about this place it will become packed and then harder for me to come in and get this delicious food whenever I want, BUT I was blown away by Chilangos. My husband and I went for a quick lunch, and during a Monday lunch during the holidays, it was pretty quiet! They've really transformed the old Boucherie space and I really love the hot pink and blue decorations, fun logo, and neon signs. It's a very light-hearted fun space, and did I mention SALSA BAR?! It has 5-6 in-house made salsas that change daily. My favorite was this bright orange salsa that I believe was made with \"fried\" tomatoes? My only recommendation is that I wish they had labels for th..."}],"visual":[{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","photo_id":"9UEEbk5J85Kw-RihYhLnEQ","label":"food","image_url":"/photos/9UEEbk5J85Kw-RihYhLnEQ.jpg","visual_representativeness":0.9176216721534729},{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","photo_id":"9XENKZUDdNMzNGxsFiW-2w","label":"food","image_url":"/photos/9XENKZUDdNMzNGxsFiW-2w.jpg","visual_representativeness":0.9035130143165588},{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","photo_id":"anyjNdEi1KkwXspovikPWw","label":"food","image_url":"/photos/anyjNdEi1KkwXspovikPWw.jpg","visual_representativeness":0.892552375793457},{"business_id":"WFGoAG3HF2T1cTVr5HUD2w","photo_id":"sp4m8wc9DXu_yFLK1QkRMA","label":"food","image_ur