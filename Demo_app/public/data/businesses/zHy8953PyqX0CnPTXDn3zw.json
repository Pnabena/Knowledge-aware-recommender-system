53PyqX0CnPTXDn3zw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2294,"mm_rank":1817,"target_category_support_fraction":0.75,"selected_image_count":3,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Specialty Food","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Food","historical_business_count":3},{"category":"American (Traditional)","historical_business_count":2}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Food, Restaurants","shared_category_count":3},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"zHy8953PyqX0CnPTXDn3zw","review_id":"ZLQWcZYw5Lgn6QLj_1ADDA","date":"2021-05-08T04:41:31","stars":4,"text_representativeness":0.9390177130699158,"text_excerpt":"I live in the lower garden district and was excited to try this place I found via Yelp. Stopped in for a late lunch during the week. The eatery is set up in a large store area with plenty of space between tables. They have an outdoor patio and a private parking lot out front. You order at a counter for your meal and they bring it to your table. The food was quickly prepared (but it wasn't very busy the time of day I went). Staff were friendly and attentive. I got the creole Cuban and I enjoyed the Dickie Brennan's take on it. My sandwich and fries were delicious. Bathrooms were gender neutral with individual toilet stalls and a common sink area. The food was delicious 4.5+ stars, but next..."},{"business_id":"zHy8953PyqX0CnPTXDn3zw","review_id":"zLQezUy_ZeGlgsy1eZSIvA","date":"2021-01-02T20:25:41","stars":5,"text_representativeness":0.9349367618560791,"text_excerpt":"Eatery and market located on Orange street in the lower garden district. I arrived around noon on a Saturday and to my surprise they're weren't many people there. It has a commercial/industrial kitchen vibe. As soon as you walk in everything is very clean, neat and organized. Everyone is wearing masks. The staff was very nice and polite. They sell many refrigerated prepared food items that you can buy to take home. They also have pies, meal kits, meats, soups, dressings, spices. They have a few tables outside and inside if you want to get something from the eatery and dine in. I ordered the smash patty burger. It was such a good burger! Its two 3 oz. house ground chuck patties, American c..."},{"business_id":"zHy8953PyqX0CnPTXDn3zw","review_id":"2UBBOIhTonk7UuVHGJG2hA","date":"2020-07-05T17:36:44","stars":5,"text_representativeness":0.9295961856842041,"text_excerpt":"Y'all!! Let's first start with the 5 star customer service. I chose to go with a Brennan's restaurant for Father's Day take out dinner and The Commissary definitely delivered the best options. For $165 (including tax and services fees) we were able to enjoy two 20oz ribeyes, 1 8oz filet mignon wrapped in bacon, creamed spinach, 4 halves of twice baked potatoes, 4 stuffed jalapeños wrapped in prosciutto, and 4 halves of stuffed tomatoes. You just can't beat that!! Fine dining provided at home! This fed three adults and a toddler. Everything was packaged safely and they were observing social distancing rules upon arrival. I felt totally safe picking up my food. I had to return a second time..."}],"visual":[{"business_id":"zHy8953PyqX0CnPTXDn3zw","photo_id":"YHCvYMD065OHevFf6Edzdw","label":"food","image_url":"/photos/YHCvYMD065OHevFf6Edzdw.jpg","visual_representativeness":0.9183077812194824},{"business_id":"zHy8953PyqX0CnPTXDn3zw","photo_id":"3SB1kwEvfsKqwRGEJ8ZuVA","label":"food","image_url":"/photos/3SB1kwEvfsKqwRGEJ8ZuVA.jpg","visual_representativeness":0.9151579737663269},{"business_id":"zHy8953PyqX0CnPTXDn3zw","photo_id":"MC-Lx-57XCLsCW0PKfYYKA","label":"food","image_url":"/photos/MC-Lx-57XCLsCW0PKfYYKA.jpg","visual_representativeness":0.9049544334411621}]},"notebook_case":null}
