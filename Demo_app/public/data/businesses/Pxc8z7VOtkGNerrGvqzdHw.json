f9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Pxc8z7VOtkGNerrGvqzdHw","review_id":"Z2xkciNZT-S1x3xwxi-b3A","date":"2012-01-14T04:04:08","stars":4,"text_representativeness":0.9257785677909851,"text_excerpt":"This is a pretty cool place to get coffee. Located around the corner from my #1 coffee shop, this PJ's is nice. I pass this location nearly every day, but had never been inside. In the mood for something different, I decided to give it a try. Inside there are numerous tables, chairs and even a couch. In front of the couch was a table with two different board games. Since I was alone I didn't play any games, but I do like the idea. Service was friendly and the shop was clean. Wi-fi was free and tested 1.8 mbs download. The iced coffee is my drink of choice and their version is very good. If you're in the lower garden district and want coffee and a place to hang out, give PJ's a try. Note: ..."},{"business_id":"Pxc8z7VOtkGNerrGvqzdHw","review_id":"VMjPj65XhiMTcvKfUslk8w","date":"2015-08-13T16:12:41","stars":5,"text_representativeness":0.905745267868042,"text_excerpt":"I love this PJ's! Every time I've been in there, I'm always politely greeted and the service is always fast. I can kind be a little picky about whatever I order, (usually a granita, with half the syrups, and an extra shot), but they have always made it perfect for me. They also ask me if I want the cold espresso already made, or a fresh hot brew. Doesn't really matter to me, but thank you for asking. I love the oatmeal cookies too! I would think that all the PJ's have the same kind, and they might... but still they are better at this PJ's than the other ones I've been to. Or maybe its just because I love this location. Thanks guys! Keep up the good work!"},{"business_id":"Pxc8z7VOtkGNerrGvqzdHw","review_id":"ehB5PCAiFivxc8NfKboV9A","date":"2015-12-19T16:17:25","stars":5,"text_representativeness":0.9014357328414917,"text_excerpt":"Best coffee shop around! The guys working there are funny, cute and an overall pleasure:) So happy to have this place in our neighborhood :) see ya'll again tomorrow"}],"visual":[{"business_id":"Pxc8z7VOtkGNerrGvqzdHw","photo_id":"V3Ky1gx7MF_A_zOmLj9Ovw","label":"inside","image_url":"/photos/V3Ky1gx7MF_A_zOmLj9Ovw.jpg","visual_representativeness":1.0000001192092896}]},"notebook_case":null}
