yNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"_ZRynwYKBpUCMVHqR2vj4A","review_id":"hGf1PhGfGC44SxAP1E5N2g","date":"2011-10-27T21:16:37","stars":4,"text_representativeness":0.9411148428916931,"text_excerpt":"You always see those shows on tv at night about little gourmet cupcake places full of good looking treats. The sad thing is that all of these places are usually located somewhere in California, where you wonder if they eat the cupcakes or just look at them. Imagine my delight when I heard that a gourmet cupcake place was open uptown! I was excited to try it. The only cupcakes I think that I've ever had were sadly from bakeries who I don't think specialized in cupcakes (does that make sense? I'm saying that they weren't good.). Anyway, at Kupcake Factory they have a huge selection of cupcakes from strawberry, to Boston creme, to carrot cake. I decided to try the Birthday cake cupcake and t..."},{"business_id":"_ZRynwYKBpUCMVHqR2vj4A","review_id":"mAJ07bl25waaxpWxdStH8g","date":"2014-09-14T05:54:45","stars":5,"text_representativeness":0.9326887130737305,"text_excerpt":"I am a dessert groupie! This place has the best cupcakes in town! It has that homemade taste that other places lack. The wedding cupcake is awesome, but I may be bias since I just love wedding cake! The staff is pleasant as well."},{"business_id":"_ZRynwYKBpUCMVHqR2vj4A","review_id":"OXdBeG2O6xIbY0YmbwCITQ","date":"2014-12-15T20:09:00","stars":5,"text_representativeness":0.9324479103088379,"text_excerpt":"I love cupcakes. I had the wedding cupcake and it was delicious, the lemon cupcake was good as well but the favorite for me with the wedding.They are very personable and accommodating. They are in a plaza but as you enter into the plaza they are the first retailer on the left hand side if you come to. Highly recommended"}],"visual":[{"business_id":"_ZRynwYKBpUCMVHqR2vj4A","photo_id":"lCzJ63hB--zauKSOrDVoTA","label":"inside","image_url":"/photos/lCzJ63hB--zauKSOrDVoTA.jpg","visual_representativeness":1.0}]},"notebook_case":null}
