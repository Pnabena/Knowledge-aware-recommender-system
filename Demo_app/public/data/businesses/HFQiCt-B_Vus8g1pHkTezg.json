ew_excerpts":[]},"ranking":{"user_row":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":713,"business_id":"HFQiCt-B_Vus8g1pHkTezg","nv_rank":2257,"mm_rank":1487,"nv_score":-0.7464467883110046,"mm_score":-0.5387341380119324,"rank_movement":770,"has_visual_feature":true,"name":"Le Salon","address":"300 Gravier St, Fl 1","city":"New Orleans","state":"LA","postal_code":"70130","stars":4.0,"review_count":34,"categories":["Restaurants","American (New)","Food","Tea Rooms"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"HFQiCt-B_Vus8g1pHkTezg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2257,"mm_rank":1487,"target_category_support_fraction":0.75,"selected_image_count":4,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"American (New)","historical_business_count":2},{"category":"Food","historical_business_count":3},{"category":"Tea Rooms","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"HFQiCt-B_Vus8g1pHkTezg","review_id":"ab0N-LMy3_qqvjfqSIqp8w","date":"2019-05-27T22:27:46","stars":5,"text_representativeness":0.924486517906189,"text_excerpt":"I attended afternoon tea here yesterday. It was fantastic. The service was friendly and attentive. The selection of teas was plentiful. I chose the lemon pomegranate and it was superb. Every bite of food I had was greatness. I am Picky about textures and do not typically like meat salads but the curry chicken salad was amazing. The lemon curd was perfectly tart and sweet at the same time and the Devonshire cream was what heaven is Made of. The scones were the best I've ever had. Also, if it's available, try the Pontota Lemonade cocktail. 5 stars!"},{"business_id":"HFQiCt-B_Vus8g1pHkTezg","review_id":"217PIzrByu6SFWaDR6lsmw","date":"2017-03-27T01:45:02","stars":4,"text_representativeness":0.9214867353439331,"text_excerpt":"Unique experience! I was with a group of 11 ladies. Starts with a cocktail (I had the sangria) and finger sandwiches - I did not like the lobster salad on a cucumber, but I also don't care for seafood. The teas we tried were the Strawberries and Champagne and then the Bourbon Vanilla Chai. The sugar to put in the tea looked like rock salt, and there was also milk - both of which I added to the Chai and it was great! After the sandwiches came the scones - the best part of the service -with lemon curd, raspberry preserves, Devonshire cream, and a vanilla cream. And following that, an assortment of sweets. I would recommend it. Reservations are required in advance."},{"business_id":"HFQiCt-B_Vus8g1pHkTezg","review_id":"EeA_r9Gpe5cgA5n0orwsSA","date":"2018-02-06T17:35:44","stars":5,"text_representativeness":0.9181102514266968,"text_excerpt":"Had a Sunday tea here (they've got two seating on Sunday - 11am and 2pm). I would say dress code is business casual to dressier if you can. Seating is either at tables or at the couches with settings that seemed to be the same throughout the place. Servers were very friendly and helpful but did not rush us at all. We had a few of the cocktails and enjoyed them, they are a little on the sweet side. It doesn't seem like a lot of food at first, but it does satiate the hunger - little finger sandwiches (truffled egg salad, cucumber, smoked salmon, smoked turkey, chicken salad), scones (black currant/walnuts) and dessert. I went with the Lapsang Souchong which had those campfire smokey notes. ..."}],"visual":[{"business_id":"HFQiCt-B_Vus8g1pHkTezg","photo_id":"TpZC_aC_Oz7C3HJOeXM3HA","label":"drink","image_url":"/photos/TpZC_aC_Oz7C3HJOeXM3HA.jpg","visual_representativeness":0.90565025806427},{"business_id":"HFQiCt-B_Vus8g1pHkTezg","photo_id":"EvMTxjRvFSC-k2lgzLsW8A","label":"inside","image_url":"/photos/EvMTxjRvFSC-k2lgzLsW8A.jpg","visual_representativeness":0.8813900947570801},{"business_id":"HFQiCt-B_Vus8g1pHkTezg","photo_id":"riYzNJIHm3xdhoqwlgI4zg","label":"food","image_url":"/photos/riYzNJIHm3xdhoqwlgI4zg.jpg","visual_representativeness":0.8794490098953247},{"business_id":"HFQiCt-B_Vus8g1pHkTezg","photo_id":"hkrWzh_CuZJXwYiV34Rd8w","label":"food","image_url":"/photos/hkrWzh_CuZJXwYiV34Rd8w.jpg","visual_representativeness":0.8387134075164795}]},"notebook_case":null}
