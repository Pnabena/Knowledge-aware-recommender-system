en":false},"evidence":{"source":"frozen-model","summary":{"business_id":"mCNvZPROAx2AwbYeizPHvg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1437,"mm_rank":902,"target_category_support_fraction":0.3333333333333333,"selected_image_count":3,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Fashion","historical_business_count":0},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Used","historical_business_count":0},{"category":"Vintage & Consignment","historical_business_count":0},{"category":"Shopping","historical_business_count":0}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"mCNvZPROAx2AwbYeizPHvg","review_id":"AjnmIO7eXAz0SGTQUSdahg","date":"2018-09-27T01:19:28","stars":4,"text_representativeness":0.9246822595596313,"text_excerpt":"It was scorching hot one day while I was in New Orleans. After walking around, I popped on Yelp and fortunately it told me that Arrow Cafe was right around the corner. Truthfully, I was going to just get a bottle of water and be on my way, but there was something about this place that said, \"spend your money here\" so I did. I got my water, but I also picked up an iced latte too. Surprisingly there was only one other person inside besides the adorable woman working behind the counter. It's a got a cool vibe and they sale random things. It's got a retro feel to it without being super annoying about it. It doesn't try to hard, which I appreciate it. The latte was great. I'm so happy I got it..."},{"business_id":"mCNvZPROAx2AwbYeizPHvg","review_id":"RJVs-UGpNlLNfNDCjWOdng","date":"2018-01-27T18:35:19","stars":4,"text_representativeness":0.9155017137527466,"text_excerpt":"Stopped in here for some coffee before the cemetery tour. Lots to look at and good coffee. I also had a yummy vegan pastry. I'm loving the masks and plants! There's local art for sale on the walls which I always love. Could use a little cleaning in the sugar/lid area. Friendly service! (No public restroom)"},{"business_id":"mCNvZPROAx2AwbYeizPHvg","review_id":"7su-wpHRvk45apjWMDRrTw","date":"2016-04-21T18:06:11","stars":5,"text_representativeness":0.9139746427536011,"text_excerpt":"This place has my favorite roast in the city, and all of the drinks they make are delicious and beautiful! Super cute shop that will have one of the cutest locations in the city, especially once the Rampart Streetcar Line is finished! Try some granola with yogurt to go along with your coffee. Makes for a great pre-workout meal and also just a happy day."}],"visual":[{"business_id":"mCNvZPROAx2AwbYeizPHvg","photo_id":"49o-1QqUecNQUZfLmL1ZPA","label":"inside","image_url":"/photos/49o-1QqUecNQUZfLmL1ZPA.jpg","visual_representativeness":0.9518067836761475},{"business_id":"mCNvZPROAx2AwbYeizPHvg","photo_id":"-VeBF38SvwEz0vqmsLrl6w","label":"inside","image_url":"/photos/-VeBF38SvwEz0vqmsLrl6w.jpg","visual_representativeness":0.9421088099479675},{"business_id":"mCNvZPROAx2AwbYeizPHvg","photo_id":"E2Czx5nw1yasz7SHE8HwbA","label":"inside","image_url":"/photos/E2Czx5nw1yasz7SHE8HwbA.jpg","visual_representativeness":0.8957340121269226}]},"notebook_case":null}
