rget_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Asian Fusion","historical_business_count":0},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Sushi Bars","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"American (New)","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Cajun/Creole, Restaurants","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"mXR44pGgOvbnkMWJp6nRnw","review_id":"Wz6AczKZQ44DvCJqVcOVVw","date":"2010-11-03T23:24:59","stars":4,"text_representativeness":0.9345252513885498,"text_excerpt":"Mike's on the Avenue was our choice for lunch today. We had a party of four and arrived around 1. The restaurant wasn't crowded and we were seated immediately. We started with an order of salmon spring rolls and handmade shrimp dumplings. The spring rolls were good, but the dumplings were lick the plate good. For entrees we ordered the cuban sandwich, grilled fish Tacos, thai shrimp pasta and crab cake. Everyone enjoyed their meal, but fish tacos stood out. They were described to me as incredible. I had the thai shrimp pasta. It was good, but not phenomenal. Service was great and the view of St. Charles and Lafayette Square can't be beat. Enjoying a good meal while watching the streetcar ..."},{"business_id":"mXR44pGgOvbnkMWJp6nRnw","review_id":"6Y2b125-WU-1nUNWavf-Yg","date":"2010-12-24T19:48:15","stars":5,"text_representativeness":0.9223402738571167,"text_excerpt":"Had dinner on Tuesday night 12/21, and had the Reveillon menu. It was absolutely fantastic! Good to see Mike's is back in NOLA, I had been there back in 1995, and was impressed then too."},{"business_id":"mXR44pGgOvbnkMWJp6nRnw","review_id":"09vGtsMJ6knl17WH2rC6lw","date":"2012-08-28T22:37:45","stars":5,"text_representativeness":0.9216144680976868,"text_excerpt":"We had a great meal here with friends during our recent visit. I had an amberjack special that was just dynamite, and their sushi was really good, even if the rolls were a bit small. The cajun roll was really memorable and unlike anything I've had before. It had that cajun spice to it that was just right to add zing without overpowering the fish. Our server was friendly and attentive to our large group. The atmosphere is casual/trendy, but with a relaxed feel (I guess that's just New Orleans style!)."}],"visual":[]},"notebook_case":null}
