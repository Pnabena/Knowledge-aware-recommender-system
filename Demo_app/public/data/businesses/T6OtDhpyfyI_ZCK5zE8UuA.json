rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"T6OtDhpyfyI_ZCK5zE8UuA","review_id":"TL8MhNVfK5CISsK5lUW9jw","date":"2011-04-19T17:51:52","stars":4,"text_representativeness":0.9244080781936646,"text_excerpt":"Starbucks must be doing well when they place two Starbucks across from each other. This Starbucks is located inside the Marriott hotel and is located right across the street from the Sheraton Starbucks. This Starbucks also closes early so make sure to get here before 5pm. I believe this Starbucks also has the collector Starbucks cups (has the city of New Orleans printed on the outside). Lots of seating and relatively fast service. No use having your Starbucks gold card here though. No free soy or syrup choices."},{"business_id":"T6OtDhpyfyI_ZCK5zE8UuA","review_id":"gPElwRDP4chh2nj2tv2hJw","date":"2010-09-21T03:52:24","stars":4,"text_representativeness":0.9108299016952515,"text_excerpt":"Bonus points to this Starbucks for being located inside of my hotel (New Orleans Marriott). I was able to visit each day to get my daily Iced Green Tea craving satisfied. The cool thing about this location is that the barista told me I could bring my cup back for 60 cent refills! Score! I was ready to take complete advantage of this until housekeeping tossed my cup out while I was out of the room. Grrrr!"},{"business_id":"T6OtDhpyfyI_ZCK5zE8UuA","review_id":"Ozqpz3E-iWrVAMqKHMg2pg","date":"2011-04-18T17:17:58","stars":4,"text_representativeness":0.9059370160102844,"text_excerpt":"This Starbucks sits deep inside the Marriott. So what you get is a plush Starbuck's experience. There is a separate room for the plush chairs. This is one of the best smelling Starbuck's. The same fragrance smell that fills the Marriott fills the air in this Starbuck's. The result is that you feel like your breathing in potpori. The prices are steeper than your usual Starbucks outside of downtown New Orleans. However, the atmosphere is so relaxing that I felt like getting in my daily coffee here was worth the steeper price."}],"visual":[{"business_id":"T6OtDhpyfyI_ZCK5zE8UuA","photo_id":"yAY-FHdKmQNH2hm5HGCGpg","label":"outside","image_url":"/photos/yAY-FHdKmQNH2hm5HGCGpg.jpg","visual_representativeness":0.8951183557510376},{"business_id":"T6OtDhpyfyI_ZCK5zE8UuA","photo_id":"HQiW2wZn1N-G8Lzx26zF9w","label":"drink","image_url":"/photos/HQiW2wZn1N-G8Lzx26zF9w.jpg","visual_representativeness":0.895118236541748}]},"notebook_case":null}
