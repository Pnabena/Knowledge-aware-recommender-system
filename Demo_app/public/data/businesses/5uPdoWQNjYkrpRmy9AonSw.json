al_feature":true,"name":"Hana Japanese Restaurant","address":"8116 Hampson St","city":"New Orleans","state":"LA","postal_code":"70118","stars":3.5,"review_count":185,"categories":["Restaurants","Japanese","Sushi Bars"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"5uPdoWQNjYkrpRmy9AonSw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":512,"mm_rank":505,"target_category_support_fraction":0.3333333333333333,"selected_image_count":2,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Japanese","historical_business_count":0},{"category":"Sushi Bars","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"5uPdoWQNjYkrpRmy9AonSw","review_id":"xy640qQ7dpZXAYuUCOw40g","date":"2010-11-15T02:32:34","stars":4,"text_representativeness":0.9517621994018555,"text_excerpt":"Went there the other day for take-out. Everything was really great. The Hana Special Roll is HUGE. Don't even attempt to eat the full order yourself. A little cheaper than other sushi places around here, and just as good."},{"business_id":"5uPdoWQNjYkrpRmy9AonSw","review_id":"tsfVoWtYm6OdWvk1-Y9UnA","date":"2012-04-24T19:54:20","stars":5,"text_representativeness":0.9517355561256409,"text_excerpt":"OOHH MYY GOODNESS! This is my favorite sushi restaurant in all of New Orleans. Everyone always says Ninja is their favorite, and my husband and I are dumbfounded. How can you say that?! Hana is so fresh, fast, and yummy. I love the noodle salad.. which Mikimoto on Carrollton also has.. but is such a rare treat. We get the Hana Special roll nearly every time. What a crowd pleaser! It's the biggest roll I've ever seen.. and the flavors always hit the spot. I do wish they had a heart attack roll, or some of these other desinger type rolls I've had at sushi restaurants in California.. but they'll make anything.. and with the noodle salad.. I swear it might be my favorite sushi place ever! Ser..."},{"business_id":"5uPdoWQNjYkrpRmy9AonSw","review_id":"eHRblfSHpKvKFP90X45HUQ","date":"2015-10-14T17:53:09","stars":4,"text_representativeness":0.9516629576683044,"text_excerpt":"Hana is my \"go-to\" sushi place for lunch in the city. Typically pretty fast service and the rolls are delicious. I'm a big fan or the eel with tamago and the yellowtail. The fish is fresh and the waitstaff is knowledgeable. The prices are middle of the road, so easy to get carried away and order too much! They have the standard \"sushi and sashimi lunch specials\" which come with miso and noodle or lettuce/ginger salad. The atmosphere is pretty forgettable and the bathroom is weirdly small. There's a long sushi bar across the back left side and a TV for lunches alone. I've never had any of their prepared food, I only go for the sushi!"}],"visual":[{"business_id":"5uPdoWQNjYkrpRmy9AonSw","photo_id":"DLtdVaUEtXB--mWNiAzmiQ","label":"food","image_url":"/photos/DLtdVaUEtXB--mWNiAzmiQ.jpg","visual_representativeness":0.9144076108932495},{"business_id":"5uPdoWQNjYkrpRmy9AonSw","photo_id":"hrZLBM_aFPYjGOUmYIbFEA","label":"food","image_url":"/photos/hrZLBM_aFPYjGOUmYIbFEA.jpg","visual_representativeness":0.91440749168396}]},"notebook_case":null}
