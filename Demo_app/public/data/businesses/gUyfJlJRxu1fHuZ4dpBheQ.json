IyQmWTQhA","business_row":1743,"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","nv_rank":273,"mm_rank":406,"nv_score":0.6555185317993164,"mm_score":0.5116252899169922,"rank_movement":-133,"has_visual_feature":true,"name":"Santa Fe","address":"3201 Esplanade","city":"New Orleans","state":"LA","postal_code":"70119","stars":3.5,"review_count":252,"categories":["Mexican","Restaurants","Latin American"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":273,"mm_rank":406,"target_category_support_fraction":0.6666666666666666,"selected_image_count":3,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Mexican","historical_business_count":1},{"category":"Restaurants","historical_business_count":8},{"category":"Latin American","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Mexican, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","review_id":"RM-unO4LbOKmCXVcKjMq6g","date":"2010-08-24T14:40:51","stars":4,"text_representativeness":0.9452272057533264,"text_excerpt":"I really liked this place! It's definitely a legitimate Mexican restaurant -- a rarity in New Orleans. My office took our boss there for his birthday in May, and everyone had a great time! We ordered two pitchers of watermelon margaritas for our table -- delicious! I had crawfish enchiladas, which were quite tasty, and everyone else enjoyed their meals as well. Our server was great -- really friendly and on top of things. I'm confused by all the negative reviews this place has gotten on Yelp; perhaps the restaurant has ironed out the kinks that prompted past negative reviews? In any case, will definitely come back to Santa Fe."},{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","review_id":"VvbTnT7h17O2BlYBf1Pchw","date":"2020-10-25T01:47:40","stars":4,"text_representativeness":0.9375810623168945,"text_excerpt":"Have not been here for years! Dined here post Covid last week and it was a lovely evening. Margaritas were as strong as I remember and the ambiance with all the little lights in the trees on Esplanade is so charming! Staff is attentive and courteous- when I had to go inside to use the restroom everyone joked with me and I was cracking up. The queso is not my favorite, but that didn't stop me from eating a ton of it. Tuna dish was great and exactly what I expected, but why was I trying to be healthy there? Next time I'm getting a quesadilla or something and going all in. One of the prettiest outdoor dining spots in NOLA!"},{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","review_id":"Yle2CgsabcOKCJrXAWvM8w","date":"2013-06-24T02:25:09","stars":5,"text_representativeness":0.9348618388175964,"text_excerpt":"I thought the Mexican food here was the best I've had in New Orleans. I'm from Southern CA, so I can be picky when it comes to Mexican food. The margaritas are incredible! There were six of us, and everyone ordered something different. I think the only disappointment was the nachos (that one person ordered). She said they were OK, and to me, it looked like it was just cheese and green onions were on them...no meat or beans, but i could be wrong. Once she ate the top layer, it was just the chips. I had the tostada which I loved. Can't wait to go back!"}],"visual":[{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","photo_id":"rXAEqn32U7U4vjWg74OXvg","label":"food","image_url":"/photos/rXAEqn32U7U4vjWg74OXvg.jpg","visual_representativeness":0.9250683784484863},{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","photo_id":"03lT0E-0DXj3ZGxlQ37Hcg","label":"food","image_url":"/photos/03lT0E-0DXj3ZGxlQ37Hcg.jpg","visual_representativeness":0.9249082207679749},{"business_id":"gUyfJlJRxu1fHuZ4dpBheQ","photo_id":"vcB3E4v7fLI7fWCJaiNdFQ","label":"food","image_url":"/photos/vcB3E4v7fLI7fWCJaiNdFQ.jpg","visual_representativeness":0.9065819978713989}]},"notebook_case":null}
