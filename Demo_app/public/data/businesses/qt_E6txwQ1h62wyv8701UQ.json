nEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants, Seafood","shared_category_count":3},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"qt_E6txwQ1h62wyv8701UQ","review_id":"hsI2GdMDnzexQFWv1VwZww","date":"2019-05-03T20:42:41","stars":4,"text_representativeness":0.9541602730751038,"text_excerpt":"I have heard great things about Clesi's crawfish since they were a pop up. Now they have a beautiful restaurant of there that I got to see today. I love what they did with the space. It is a raised deck with picnic tables and umbrellas. From that deck area, you can enter the restaurant, which smells fantastic btw, and enter the bar area. There are about 10 stools at the bar and about 4 tables with stools across. I ordered 5 lbs of crawfish and boudin to go at the bar and sat and wait. The staff was smiling and friendly. I waited about 20 minutes for my food which was to go. When I got home and tried the boudin, it was very good and I am a boudin snob. It was more rice to meat ratio, but t..."},{"business_id":"qt_E6txwQ1h62wyv8701UQ","review_id":"91GEs59UX6o27wMpW7lBiA","date":"2016-03-31T17:38:57","stars":5,"text_representativeness":0.9434682130813599,"text_excerpt":"Oh baby crawfish! My SO had a friend in town who wanted crawfish, and we had been wanting to try Clesi's, so to Clesi's we went! Upon walking up, we were warmly greeted by Clesi himself; and he said \"Come on in, the crawfish are soaking and they'll be coming out in a few minutes!\" So we walked in and waited in the short line to order, and when we got to the front, Clesi had come aroung to take our order. I got an order of crawfish (comes with a corn, a potato, and a sausage) and fries. My SO got the jambalaya cheese fries, and her friend got an order of crawfish and meatpies. The crawfish were excellent! Perfect amount of salt and spice. Not too spicy, not too salty. They were flavored no..."},{"business_id":"qt_E6txwQ1h62wyv8701UQ","review_id":"CBcIOSdFGtFL2UC90ZQkqQ","date":"2019-02-25T20:40:10","stars":5,"text_representativeness":0.9422861337661743,"text_excerpt":"Perfect crawfish. Probably the best I've ever had that wasn't a home boil. But beware, they are spicy and not for the weak of heart. I love spice and it was totally worth it but your nose will be running and you'll get a free lip pump. A bit pricy. $8 a lb right now, with a 2lb maximum per person, but that could change as the season progresses. Perfect service. I forget how friendly people in Mew Orleans are. Lots of local beers. The draft is a bit pricy but I guess you are paying for the experience. Good music and lovely seating. Go early. They sell out."}],"visual":[{"business_id":"qt_E6txwQ1h62wyv8701UQ","photo_id":"q_srvYgGHF2AIIQMksu5_w","label":"inside","image_url":"/photos/q_srvYgGHF2AIIQMksu5_w.jpg","visual_representativeness":0.8326261043548584},{"business_id":"qt_E6txwQ1h62wyv8701UQ","photo_id":"nwd7nEYqx4we01jxJEf6kw","label":"outside","image_url":"/photos/nwd7nEYqx4we01jxJEf6kw.jpg","visual_representativeness":0.8232349157333374},{"business_id":"qt_E6txwQ1h62wyv8701UQ","photo_id":"fGpLEcymIAM8yGfTtLkmbg","label":"food","image_url":"/photos/fGpLEcymIAM8yGfTtLkmbg.jpg","visual_representativeness":0.8180103898048401},{"business_id":"qt_E6txwQ1h62wyv8701UQ","photo_id":"K9agJaNE3NN6aVNyzY9GcA","label":"menu","image_url":"/photos/K9agJaNE3NN6aVNyzY9GcA.jpg","visual_representativeness":0.8085445165634155},{"business_id":"qt_E6txwQ1h62wyv8701UQ","photo_id":"RSkfuuPzc-n_hhYwUahlpA","label":"food","image_url":"/photos/RSkfuuPzc-n_hhYwUahlpA.jpg","visual_representativeness":0.7734561562538147}]},"notebook_case":null}
