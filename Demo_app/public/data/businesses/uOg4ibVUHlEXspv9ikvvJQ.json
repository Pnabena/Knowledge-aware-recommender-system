torical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"uOg4ibVUHlEXspv9ikvvJQ","review_id":"Qi53b1r7UqUrIkAcZEOBTg","date":"2021-04-28T01:25:54","stars":5,"text_representativeness":0.9172285795211792,"text_excerpt":"This place was so bomb! This black owned establishment left nothin to be desired. The food was amazing and the vibe was just as good. It looks as though it's mainly takeout but we were seated on the outside and it was perfection. They had one of my favorite artists on repeat and they served up the tastiest crawfish and shrimp I've had since visiting New Orleans hands down! A far cry from the normal tourist faire, plus it felt like we were at a family reunion with all the good seafood eating family style down south! I highly recommend this restaurant, and will definitely be back when I visit again!"},{"business_id":"uOg4ibVUHlEXspv9ikvvJQ","review_id":"BmxwZUcLzTRcfCLiPUgcww","date":"2020-10-11T23:04:53","stars":5,"text_representativeness":0.9063973426818848,"text_excerpt":"So WOW! I've been in NOLA for 2years and haven't come across this much flavor when it come to seafood. The price is great, the food and hospitality amazing, the quickness and accuracy was immaculate. I'm almost never give out 5 stars but this was more than worthy."},{"business_id":"uOg4ibVUHlEXspv9ikvvJQ","review_id":"yXZzdWnJJhGqX8wppLrSZQ","date":"2020-10-18T22:45:28","stars":4,"text_representativeness":0.9003626704216003,"text_excerpt":"I finally strolled in to deeexquisite located on St. Bernard Ave a block from circle food store after hearing rave reviews. I'm NOLA bred so I know good food and I actually love spicy food but our food today was entirely too spicy to the point I couldnt eat my corn or potatoes. My coworker felt the same way! I enjoyed the lobster as it wasn't too spicy but it did have green stuff on the top part of the lobster, never seen that before and I ve eaten lobster at several restaurants before without seeing that. I do believe maybe the corn and potatoes were soaked too long in the juice which may have cause the spice was but overall the wait time was not too long and I will just try them again o..."}],"visual":[{"business_id":"uOg4ibVUHlEXspv9ikvvJQ","photo_id":"OMHHeOGMnlRK_XsEl3_C0A","label":"inside","image_url":"/photos/OMHHeOGMnlRK_XsEl3_C0A.jpg","visual_representativeness":0.9063630104064941},{"business_id":"uOg4ibVUHlEXspv9ikvvJQ","photo_id":"HUfOSUc1ESZoeH-nFvtEmw","label":"outside","image_url":"/photos/HUfOSUc1ESZoeH-nFvtEmw.jpg","visual_representativeness":0.9063630104064941}]},"notebook_case":null}
