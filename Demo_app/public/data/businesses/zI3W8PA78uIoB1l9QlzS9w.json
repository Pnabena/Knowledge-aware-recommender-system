:3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":2488,"business_id":"zI3W8PA78uIoB1l9QlzS9w","nv_rank":1766,"mm_rank":1353,"nv_score":-0.6875929832458496,"mm_score":-0.49417251348495483,"rank_movement":413,"has_visual_feature":true,"name":"Good Bird","address":"2381 Saint Claude Ave","city":"New Orleans","state":"LA","postal_code":"70117","stars":4.5,"review_count":32,"categories":["Salad","Sandwiches","Restaurants","American (New)"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"zI3W8PA78uIoB1l9QlzS9w","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1766,"mm_rank":1353,"target_category_support_fraction":0.5,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Salad","historical_business_count":0},{"category":"Sandwiches","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"American (New)","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"zI3W8PA78uIoB1l9QlzS9w","review_id":"QNGtgbJS-hyNbufCX0h6DQ","date":"2017-09-01T18:18:51","stars":5,"text_representativeness":0.9516286849975586,"text_excerpt":"I have a new love at St. Roch Market! Yes I do, and it's name is Good Bird!!! Their approach is simple, Rotisserie Chicken, Chicken Sandwiches and Salads done right! I had the Larry Bird and it was love at first bite. The chicken, BLT and avocado mix between Ciabatta from Bread on Oaks will make you giddy from joy. They also sale whole Rotisserie Chickens that are juicy, delicious and 100 times better than the ones at the grocery store. They serve breakfast which I've not had the pleasure to enjoy but will soon. For the leaf eaters they have salads that look amazing, I'll let you know how they are if I ever turn into a Rabbit ;-) Keep it up Good Bird!!!"},{"business_id":"zI3W8PA78uIoB1l9QlzS9w","review_id":"heujCFbjl3uAgMVCNjcMwQ","date":"2017-12-27T18:02:27","stars":5,"text_representativeness":0.9516054391860962,"text_excerpt":"I'm always appreciative of any reason to have lunch at St. Roch Market, because it's always an excuse to try something I've never had before or revisit an old fave. Good Bird has been on my list for a while, mainly because I love any kind of chicken sandwich, so I was eager to see what they had to offer. Upon a friend's suggestion I got the Larry Bird. With chicken, lettuce, tomato, avocado, and bacon all on ciabatta bread, it's hard to go wrong. The sandwich didn't disappoint- it's really big and served wrapped in paper with a side of their homemade chips. The chicken is nice and juicy and the avocado and bacon was the perfect touch. This sandwich was delicious! It was go-out-of-your-way..."},{"business_id":"zI3W8PA78uIoB1l9QlzS9w","review_id":"1tZMFxcAtR2sYjF-jGyZoQ","date":"2017-06-29T22:01:23","stars":5,"text_representativeness":0.9397172927856445,"text_excerpt":"Definitely one of my favorite vendors in the St Roch Market. Good portions and they're filled with flavor. I've tried both the \"Good Bird\" and \"The Birdman\" sandwiches. Both were so good I literally couldn't stop eating them and my sides kinda hurt afterwards. Haha AND the guys that work there are super friendly which is an added bonus."}],"visual":[{"business_id":"zI3W8PA78uIoB1l9QlzS9w","photo_id":"j0FWWBqws7jpZSUg9W8hVg","label":"food","image_url":"/photos/j0FWWBqws7jpZSUg9W8hVg.jpg","visual_representativeness":0.9150866270065308},{"business_id":"zI3W8PA78uIoB1l9QlzS9w","photo_id":"E8XKysKWPYjgLBo_vCeZQA","label":"inside","image_url":"/photos/E8XKysKWPYjgLBo_vCeZQA.jpg","visual_representativeness":0.8789875507354736},{"business_id":"zI3W8PA78uIoB1l9QlzS9w","photo_id":"fiqwUdwZxbURVCux6ziZ_w","label":"inside","image_url":"/photos/fiqwUdwZxbURVCux6ziZ_w.jpg","visual_representativeness":0.8669070601463318}]},"notebook_case":null}
