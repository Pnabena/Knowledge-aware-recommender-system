cal_business_count":5},{"category":"Burgers","historical_business_count":0}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","review_id":"qNB6Xw8CZig69MyAUP3rLA","date":"2018-04-08T17:56:06","stars":4,"text_representativeness":0.9429522156715393,"text_excerpt":"A solid BBQ place in Mid-city the pulled pork was good and the baked beans were exceptional! They also do a selection of burgers that looked outstanding. Creative cocktail menu and the milkshakes are crazy good. The wait staff is very attentive, knowledgeable and friendly So while not the first place I'd go solely for BBQ the total package is definitely worth it; we will be back"},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","review_id":"ssoPXcllyZoc9hcupKzxcA","date":"2017-07-22T21:29:16","stars":4,"text_representativeness":0.9428624510765076,"text_excerpt":"Everything we ate was really good. My favorite was the pork belly appetizer. It was cooked and seasoned perfectly. I ordered the two meat platter with more pork belly and brisket. The pork belly was really good, but not as good as the appetizer. They were seasoned differently, but both were definitely good. The brisket was good as well, but it did become overwhelming after a while. The baked beans were average and the fries were good. I like the sauces they provide. I cannot remember which one I used, but everyone has different taste preferences for BBQ sauce. We foolishly decided after stuffing our faces with BBQ that we wanted to each order a shake. Omg.... I've never been so full in my..."},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","review_id":"OP9x8GAEjTghmceXaFoR3w","date":"2018-01-06T04:33:29","stars":5,"text_representativeness":0.9336334466934204,"text_excerpt":"I made my second visit to Frey with a girlfriend a little more than a week ago. My girlfriend had never gone there. As soon as we got on, the greeter made us feel welcome. Our server came within minutes, identified herself and we were ready to rummmmmmble. I had the house merlot and my friend had tea. I ordered the pork belly poppers because I was introduced the week before to them. I had never had pork belly in my life. They are so good that, don't hate, I'm running for pork belly queen. I'm hoping that genius chef would be my King. OMGawd I didn't know that bacon could be transformed like that. It was crispy, not greasy, great texture and flavor. Oh mygawd chef, if I win the power ball ..."}],"visual":[{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","photo_id":"nUCUXmh53eax4aNYTAHhLg","label":"drink","image_url":"/photos/nUCUXmh53eax4aNYTAHhLg.jpg","visual_representativeness":0.8756429553031921},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","photo_id":"f748Q3gnSXkaHnz8iIOdjA","label":"food","image_url":"/photos/f748Q3gnSXkaHnz8iIOdjA.jpg","visual_representativeness":0.8586248159408569},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","photo_id":"w9lCrqY_f_9_dVJVlufmnQ","label":"food","image_url":"/photos/w9lCrqY_f_9_dVJVlufmnQ.jpg","visual_representativeness":0.8487317562103271},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","photo_id":"mNQDaBsznsF-dpuBOpaaFA","label":"inside","image_url":"/photos/mNQDaBsznsF-dpuBOpaaFA.jpg","visual_representativeness":0.7859585285186768},{"business_id":"aIVk0IEUj7rPaAMeAmBSGg","photo_id":"OwBBTAW1YtBWaJIzBIcing","label":"inside","image_url":"/photos/OwBBTAW1YtBWaJIzBIcing.jpg","visual_representativeness":0.7706469893455505}]},"notebook_case":null}
