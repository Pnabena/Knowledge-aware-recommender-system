d_category_count":6},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"BfAYvF-GsCljAFNRmuP3lg","review_id":"pqHVkcuMJih7_kNEscYQ0w","date":"2018-07-08T15:03:24","stars":5,"text_representativeness":0.9536886215209961,"text_excerpt":"When I first walked in, the space felt much warmer and very inviting. The addition of banquettes likely contributed to the cozier vibe, and the open concept kitchen is gorgeous. I'm a big fan of eating at the bar and did so at the recommendation of their bar manager, Crystal. It's fun and interesting to see everything being prepared, and to watch the teamwork and camaraderie among the chefs and kitchen staff. That, and you get a bird's eye view of everything coming off the line, so we ended up ordering more items based on what we saw - after we ordered. We were greeted by a very friendly and welcoming host, and were seated immediately. Our server/bartender was Hunter - a very nice fella, ..."},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","review_id":"ZX6DmS0Y-wbZiYEeW39LVw","date":"2018-07-11T16:00:04","stars":4,"text_representativeness":0.944400429725647,"text_excerpt":"Bywater American Bistro is yet another great restaurant in that area (check out Paladar 511 if you haven't yet). The interior the restaurant felt like a mix of casual around the bar to fancier around the dining area, with exposed brick and warm lighting. I noticed that the restaurant wasn't too loud either which I always value. Also, the hostess was so beyond friendly and definitely made for a great welcoming inside the restaurant. The food here was outstanding. We started off with the bread and 5 cheese plate almost immediately upon sitting down because we were all starving. So yes, you have to pay for the bread. But yes, it is so incredibly worth it. I'm not sure what type of bread it w..."},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","review_id":"D3v5iu2R7N9PRcpdpIqOkg","date":"2018-12-21T23:54:23","stars":5,"text_representativeness":0.9286938905715942,"text_excerpt":"Dined here recently and had an absolutely wonderful time. Every now and then I like to get adventurous and try new places (rather than same Uptown / Irish Channel / Garden District fare etc....) So we field tripped it over to Bywater. They had a lovely table reserved for us right by the large floor to ceiling windows. The service was top notch, our waitress was all over it and very attentive. I started off with a bourbon manhattan on the rocks, which was excellent. We split the pate which was awesome, and a new found favorite for me. For the main course I had the pork belly -- absolute delish. It's a really nice restaurant, lighting, bathrooms (clean), everything was really really good. E..."}],"visual":[{"business_id":"BfAYvF-GsCljAFNRmuP3lg","photo_id":"tEndpWf3RNEqzaG_ytapUQ","label":"food","image_url":"/photos/tEndpWf3RNEqzaG_ytapUQ.jpg","visual_representativeness":0.8778142929077148},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","photo_id":"QWcHmoxoiyTDpjza_P5CYw","label":"inside","image_url":"/photos/QWcHmoxoiyTDpjza_P5CYw.jpg","visual_representativeness":0.8752902746200562},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","photo_id":"1AqFi-3f7j35idh_hPPdnA","label":"food","image_url":"/photos/1AqFi-3f7j35idh_hPPdnA.jpg","visual_representativeness":0.8697999715805054},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","photo_id":"g-vFkdpgWf6J1WyAXShYWQ","label":"inside","image_url":"/photos/g-vFkdpgWf6J1WyAXShYWQ.jpg","visual_representativeness":0.833963930606842},{"business_id":"BfAYvF-GsCljAFNRmuP3lg","photo_id":"XGuN3S04eZCK2ChuokbT7g","label":"inside","image_url":"/photos/XGuN3S04eZCK2ChuokbT7g.jpg","visual_representativeness":0.7529759407043457}]},"notebook_case":null}
