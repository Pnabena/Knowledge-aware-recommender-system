l_business_count":5},{"category":"Vegan","historical_business_count":0},{"category":"Arts & Entertainment","historical_business_count":0},{"category":"Gluten-Free","historical_business_count":0},{"category":"Italian","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Bars","historical_business_count":5}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants, Vegetarian","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"wDxoeFTU69uc6eN2C57EZQ","review_id":"h22Q7mtfLcdmpF2Sp8HloA","date":"2018-10-01T19:31:36","stars":5,"text_representativeness":0.9512413144111633,"text_excerpt":"I visited G's with parents for a late afternoon lunch. We actually found parking right outside and Ricky, our server, could not have been more friendly and kind. We had the artichoke dip that was lovely and served in a great tiny cast iron skillet. We also each had salads which were nice. We split a large Bienville pizza. All three of us really loved the taste. I'm not sure what type of cheese they use, but it was great. Thin crust, perfect size for us. My folks each has a glass of house wine, I think red and white both which they enjoyed! I stuck with iced tea. The Bienville has a lot of different toppings and there are plenty of other signature pizzas or you can build your own. I've had..."},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","review_id":"wBdPHfEC-1pxYpPiYqp96w","date":"2018-11-16T23:41:54","stars":5,"text_representativeness":0.9391090273857117,"text_excerpt":"We were looking for a lunch spot close and my daughter loves her some pizza so we decided to come try G's. I'm not a huge pizza guy so I was skeptical at first, but man on man, I'm glad we went. I believe it was the owner waiting on us and he was as nice as can be. He recommended some apps. We got the sprouts, cheese bread, and artichoke dip. The sprouts and artichoke dip were insanely good. Cheese bread was okay, just like a normal pizza place. My gf and I shared the City Park Salad and no joke, one of the best salads I've had in New Orleans. Pleasantly surprised. My friends split the pesto pizza and I was blown away. Very good. Lots of choices on the menu as well. We got a pepperoni piz..."},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","review_id":"XHfK8eyucei1F43lKVPsmA","date":"2018-01-10T20:08:53","stars":4,"text_representativeness":0.9285296201705933,"text_excerpt":"I came here with a coworker for lunch today. Walked right in with no one in the place. Nice little cute renovation since Back to the Garden had closed. We ordered a pizza. The waitress told us about their special on Wednesdays. Buy one large get the second for a BUCK. What a deal! We got there at 11:30ish and got our pizza at 11:50am. WOW pizzas were fantastic and hot cooked to perfection. I was very impressed. I went to the other location on Bienvielle and have zero desire to return. I am glad this experience was a lot better. This is around the corner form our work. We look forward to returning next week! Great service and clean as well!"}],"visual":[{"business_id":"wDxoeFTU69uc6eN2C57EZQ","photo_id":"HdE9mEKGnALQlYPy8APAsA","label":"inside","image_url":"/photos/HdE9mEKGnALQlYPy8APAsA.jpg","visual_representativeness":0.8402365446090698},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","photo_id":"64idlQQKfZBOqfywBNEzyw","label":"food","image_url":"/photos/64idlQQKfZBOqfywBNEzyw.jpg","visual_representativeness":0.811148464679718},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","photo_id":"S0d9a7sokvDlFxPKBOEB8w","label":"drink","image_url":"/photos/S0d9a7sokvDlFxPKBOEB8w.jpg","visual_representativeness":0.7813253402709961},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","photo_id":"UhclbANPrC_HB3KIF-qzTg","label":"inside","image_url":"/photos/UhclbANPrC_HB3KIF-qzTg.jpg","visual_representativeness":0.7794162034988403},{"business_id":"wDxoeFTU69uc6eN2C57EZQ","photo_id":"0IArzmmswMZ6ot1x-hrPjQ","label":"outside","image_url":"/photos/0IArzmmswMZ6ot1x-hrPjQ.jpg","visual_representativeness":0.7515363097190857}]},"notebook_case":null}
