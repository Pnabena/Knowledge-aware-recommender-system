iness_count":0}],"history":[{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Beer, Food, Nightlife, Restaurants, Wine & Spirits","shared_category_count":6},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"sdFJSq-EgmtplIwUamRwTQ","review_id":"KRnW8vQAWwsRo7JogjTAJw","date":"2012-10-29T08:27:01","stars":4,"text_representativeness":0.9454631805419922,"text_excerpt":"The food on Bourbon Street is generally not that great. When I visit New Orleans I usually try to eat on any other street. During my most recent trip, my boyfriend and I decided to stop here just to drink and enjoy some people watching. We sat on the balcony for hours and ended up ordering only only drinks and some fried pickles. Our server was so sweet and we really had a good time. The next day we were looking for a place to watch football and get a little lunch so we made our way back to Bayou Burger. This time we ordered a burger to share called The Cowboy, an easy choice since we are both kinda obsessed with bacon. We knew we couldn't go wrong with a burger described as having, \"heap..."},{"business_id":"sdFJSq-EgmtplIwUamRwTQ","review_id":"YlRpigYnmbZ_g5FXMagM_w","date":"2015-03-02T22:32:33","stars":5,"text_representativeness":0.9326767325401306,"text_excerpt":"What a great place for lunch on Bourbon Street! We stopped in on Mardi Gras day with 5 of us and sat at the side bar. We were actually overlooking a table for 2 but luckily the folks there were friendly and we ended up sharing their fried pickles. Delish! I had my sights set on the crawfish beignets - they are a must - once again along with some gumbo. Perfect meal. Yelp check ins will get you a free app so if you doubt me at all use it for the beignets! The burgers were great as were the debris fries. We even made friends with the next two people who sat at the table in front of us. Great place with a great feel and awesome food!"},{"business_id":"sdFJSq-EgmtplIwUamRwTQ","review_id":"aKm1yLFLRYGkvqAi6bFSEw","date":"2017-09-04T00:31:22","stars":4,"text_representativeness":0.9325392842292786,"text_excerpt":"Stumbled upon this place on way out of bourbon street. Skipped the burger and fries and tried there red beans and rice as well as there gumbo. Both were pretty tasty. Enjoyed it! The large screens are ideal for watching a game. Service was very good as well."}],"visual":[{"business_id":"sdFJSq-EgmtplIwUamRwTQ","photo_id":"3TglbOEDuazRtO4tdqAJLw","label":"drink","image_url":"/photos/3TglbOEDuazRtO4tdqAJLw.jpg","visual_representativeness":0.9152571558952332},{"business_id":"sdFJSq-EgmtplIwUamRwTQ","photo_id":"dyrC_MYHpOC2lmTM6dkJvQ","label":"inside","image_url":"/photos/dyrC_MYHpOC2lmTM6dkJvQ.jpg","visual_representativeness":0.8620575666427612},{"business_id":"sdFJSq-EgmtplIwUamRwTQ","photo_id":"knq3UzHVhf8u1fIW