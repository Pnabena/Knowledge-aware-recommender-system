ared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Food, Restaurants","shared_category_count":3},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","review_id":"5Y93wNZzoTY4VNY29dohcA","date":"2018-01-30T19:53:19","stars":5,"text_representativeness":0.926666259765625,"text_excerpt":"Lakeview Brew Coffee Cafe is my new favorite spot to grab an iced mocha. I love the service here. Everyone I have interacted with is so kind. My daughter is in love with the hot chocolate... it isn't the kind that is dumped out of the packet. I haven't tried the food here yet, but the daily specials always sound amazing. If you are in this neck of the woods, definitely check this place out."},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","review_id":"-cqPj82VqOMsDYhmTdxsqQ","date":"2018-07-29T04:16:27","stars":5,"text_representativeness":0.9265403747558594,"text_excerpt":"Great spot to grab coffee or a quick bite to eat. I've been here a couple of times, and it hasn't disappointed yet! Went this morning and got a frozen coffee for the first time. It was - dare I say it - better than Chateau. Quiche is delicious as well. Casual place with counter service. They also have outdoor seating."},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","review_id":"ZecW8d7shVOb9R5T0E5gNw","date":"2017-03-04T22:26:43","stars":5,"text_representativeness":0.9145069718360901,"text_excerpt":"Great hidden breakfast place. An easy walk from Navarre neighborhood and Lakeview. The iced coffee is delicious, as are the lattes. Onto the food. I've had the breakfast sandwich with avocado, red onions, and Gouda cheese...talk about good. The last time I went I had the biscuit-panini and it was easily one of the best breakfast sandwiches I've had. Love walking here with friends that are in town and would highly recommend to anyone!"}],"visual":[{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","photo_id":"hqIM5CqExCSMEn7VGFxyqg","label":"inside","image_url":"/photos/hqIM5CqExCSMEn7VGFxyqg.jpg","visual_representativeness":0.8909629583358765},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","photo_id":"j065AhFWL6Iif9nqIcYosA","label":"food","image_url":"/photos/j065AhFWL6Iif9nqIcYosA.jpg","visual_representativeness":0.8013986349105835},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","photo_id":"FEzFPca7s8ftZKtbywKfaw","label":"food","image_url":"/photos/FEzFPca7s8ftZKtbywKfaw.jpg","visual_representativeness":0.7817056179046631},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","photo_id":"0rv_1cykZO-pq2WmAtKsrA","label":"food","image_url":"/photos/0rv_1cykZO-pq2WmAtKsrA.jpg","visual_representativeness":0.7660140991210938},{"business_id":"6C0IhZMfk7mhpjTBcdsX1g","photo_id":"M-R5RBFVZh67kJEp2RRXmw","label":"food","image_url":"/photos/M-R5RBFVZh67kJEp2RRXmw.jpg","visual_representativeness":0.7356972694396973}]},"notebook_case":null}
