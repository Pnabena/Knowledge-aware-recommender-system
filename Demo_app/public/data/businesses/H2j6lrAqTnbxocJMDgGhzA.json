ory_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"H2j6lrAqTnbxocJMDgGhzA","review_id":"EFKUjRzWLuZDhMf0vkLm0Q","date":"2018-06-23T22:26:25","stars":5,"text_representativeness":0.9179975986480713,"text_excerpt":"I really enjoy Daddy's Donuts. It's one of my favorite donut shops in the city. I always can count on them to have fresh hot glazed donuts available."},{"business_id":"H2j6lrAqTnbxocJMDgGhzA","review_id":"exRt5ZhviUnor1-nERBqew","date":"2020-08-16T15:20:32","stars":5,"text_representativeness":0.9171059131622314,"text_excerpt":"I try to make it to Daddy's Donuts almost every weekend to get a couple glazed donuts and a coffee. The coffee is delicious. Love supporting this local Gentilly gem! The reviewers who say the owner/operator is rude are WRONG. Her sassiness and humor brighten up my day - just don't rush her checkout process and you'll be fine, K?!"},{"business_id":"H2j6lrAqTnbxocJMDgGhzA","review_id":"UxEUnsLXq9aINKAC1vFCcA","date":"2019-12-29T04:15:21","stars":5,"text_representativeness":0.9138057231903076,"text_excerpt":"I'll FOREVER be a fan of a good, quality donut and this Mom and Pop donut shop delivers just that! A GOOD, QUALITY DONUT! The donuts are ALWAYS fresh and never hard or stale tasting. You can truly taste the difference in \"Made Fresh Daily\". The prices are low and affordable! My favorite glazed twist is only $1.25 and you can grab 10 donut holes for the kids for $1! The staff is friendly and inviting every morning! They make you feel like family, which I love! This donut shop is truly a hidden Gentilly Gem! I think I've found my new NEIGHBORHOOD FAVORITE!"}],"visual":[{"business_id":"H2j6lrAqTnbxocJMDgGhzA","photo_id":"lAXA5z_Fh0oUR_GPn2SDfQ","label":"inside","image_url":"/photos/lAXA5z_Fh0oUR_GPn2SDfQ.jpg","visual_representativeness":0.9999999403953552}]},"notebook_case":null}
