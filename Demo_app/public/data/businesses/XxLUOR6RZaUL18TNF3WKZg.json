d":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"XxLUOR6RZaUL18TNF3WKZg","review_id":"x6tkYMMSilpK7xPsEnqK4g","date":"2018-08-08T15:59:47","stars":4,"text_representativeness":0.9445334672927856,"text_excerpt":"Stopped in for Happy Hour and a bite to eat. Service is fast, and friendly. Happy Hour Oysters are a must eat. There was a special curry dish that day that was to-die for; absolutely loved it! Everyone around me ordered something different, and they all loved their food. Can't wait to try this place again on my next visit. I also love that I can sit at their bar area while waiting on my food instead of fighting for a table."},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","review_id":"Ni9qiTuMFDfOSERDs5ndIQ","date":"2018-10-15T21:36:48","stars":5,"text_representativeness":0.9180194735527039,"text_excerpt":"Oh yum! The perfect casual noshing after a long day. We had the ceviche and cru, daily special and the crab claws. All the food was super fresh and delicious. Service was quick and each dish was placed before us as it was ready. I love that this is in a food court so I could pretty much eat a progressive dinner by wandering from kiosk to kiosk... except I didn't. I just gorged myself on seafood. The chef & shucker were hustling to get orders up. Next time I'm going after those charbroiled oysters."},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","review_id":"O_twUjWyxzW_xeHGaxCEFg","date":"2018-07-22T00:53:15","stars":4,"text_representativeness":0.9166813492774963,"text_excerpt":"I was craving some oysters and good atmosphere. Mission accomplished. The oyster shucker was fast, nice and knew all about the oysters. I felt bad because I have a horrible memory and all I wanted to do was devour them. The market is always a chill place and I felt really fly stopping by the oyster bar!"}],"visual":[{"business_id":"XxLUOR6RZaUL18TNF3WKZg","photo_id":"mW_lETjAH6zm91mfFxtL1w","label":"inside","image_url":"/photos/mW_lETjAH6zm91mfFxtL1w.jpg","visual_representativeness":0.8773188591003418},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","photo_id":"3qewZ5nh36LIWDz-vfR9DA","label":"inside","image_url":"/photos/3qewZ5nh36LIWDz-vfR9DA.jpg","visual_representativeness":0.8615053296089172},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","photo_id":"DKAiirwXPEyrhbD9YeAL_g","label":"food","image_url":"/photos/DKAiirwXPEyrhbD9YeAL_g.jpg","visual_representativeness":0.849984884262085},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","photo_id":"VSOwSluQDZabtyh5qtKYxQ","label":"food","image_url":"/photos/VSOwSluQDZabtyh5qtKYxQ.jpg","visual_representativeness":0.8310980796813965},{"business_id":"XxLUOR6RZaUL18TNF3WKZg","photo_id":"BWtOmbLMbW-xKUm3u3qD9A","label":"food","image_url":"/photos/BWtOmbLMbW-xKUm3u3qD9A.jpg","visual_representativeness":0.8168458938598633}]},"notebook_case":null}
