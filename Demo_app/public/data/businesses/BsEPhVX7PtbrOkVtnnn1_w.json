vement":88,"has_visual_feature":true,"name":"Loretta's Authentic Pralines","address":"2101 N Rampart","city":"New Orleans","state":"LA","postal_code":"70116","stars":5.0,"review_count":170,"categories":["Food","Desserts","Bakeries","Candy Stores","Local Flavor","Specialty Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":643,"mm_rank":555,"target_category_support_fraction":0.16666666666666666,"selected_image_count":5,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Desserts","historical_business_count":0},{"category":"Bakeries","historical_business_count":0},{"category":"Candy Stores","historical_business_count":0},{"category":"Local Flavor","historical_business_count":0},{"category":"Specialty Food","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","review_id":"ejJzN9wLGopX_3LpeHEUrg","date":"2019-03-21T16:22:59","stars":5,"text_representativeness":0.9449218511581421,"text_excerpt":"Wonderful location! BEST. BEIGNETS. IN. NEW. ORLEANS!!! Hands down! I originally went to Loretta's in French Market but was disappointed they ran out of praline beignets. I decided to make the trip here (to the original location) the next day. SO WORTH IT! The nice lady at the front is sooo friendly and welcoming. She's actually a close church friend of Ms. Loretta. She explained to me that the praline beignets are made to order... so they definitely came out fresh! They use puff pastry instead of dough, and it gives the beignets a better crunch and texture! Inside the beignet they have a praline cream. Think of it like a traditional cream-filled donut... instead, it's a praline-filled be..."},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","review_id":"SQOOiB4PAiJWKNJd0jCAEg","date":"2019-07-10T13:46:34","stars":4,"text_representativeness":0.9439874887466431,"text_excerpt":"Made it my business to eat at the top 3 beignet restaurants in NOLA. Loretta's is definitely a top 3 contender. They are soft, and flaky on the inside like a croissant. The praline filling is divine, but takes the intensity of the beignets up a 1000%. It is very rich, decadent and filling. It is spectacular. Not necessarily sure that I'd eat them again because they are sooo rich in taste. But I would absolutely eat the traditional ones over and over again. The praline cookie is AMAZING and i wish I would have gotten more. The rum pralines were phenomenal as well. Would have loved to take some home also. All in all, Loretta's is definitely one of the best in NOLA."},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","review_id":"XB1dlPa9CpydmCbyjUTUAA","date":"2017-12-20T05:06:53","stars":4,"text_representativeness":0.9429717659950256,"text_excerpt":"After almost a week in New Orleans, we were feeling pretty exhausted and were looking for one more place to get beignets and somewhere to buy pralines for a Christmas gift. After a quick Yelp search, I found Loretta's, which had both! We did the whole Cafe du Monde thing earlier in the week and only ordered one set of beignets when we got to Lorettas. Turns out, they're both smaller and exponentially better than the beignets at Cafe du Monde. We finished the first order in minutes and decided we needed another! If we go back, I want to try the filled beignets but this time we stuck with the classic ones. They were hot and fresh, perfectly fluffy, and honestly probably a little glimpse of ..."}],"visual":[{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","photo_id":"1VGBrEd2HaI3NKSPZLN6RA","label":"food","image_url":"/photos/1VGBrEd2HaI3NKSPZLN6RA.jpg","visual_representativeness":0.8473296165466309},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","photo_id":"faubvSybmirDNZRLQQfbtg","label":"inside","image_url":"/photos/faubvSybmirDNZRLQQfbtg.jpg","visual_representativeness":0.8207710385322571},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","photo_id":"-kbNAIjc5brECNrLE8r4nw","label":"food","image_url":"/photos/-kbNAIjc5brECNrLE8r4nw.jpg","visual_representativeness":0.8174436092376709},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","photo_id":"8KGmDhVNyEMNd5-uZz2OBA","label":"inside","image_url":"/photos/8KGmDhVNyEMNd5-uZz2OBA.jpg","visual_representativeness":0.808172345161438},{"business_id":"BsEPhVX7PtbrOkVtnnn1_w","photo_id":"928VdIrGnJeV31gopYkvXQ","label":"food","image_url":"/photos/928VdIrGnJeV31gopYkvXQ.jpg","visual_representativeness":0.7968066334724426}]},"notebook_case":null}
