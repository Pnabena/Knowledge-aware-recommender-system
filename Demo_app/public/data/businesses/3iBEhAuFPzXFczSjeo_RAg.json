s_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"3iBEhAuFPzXFczSjeo_RAg","review_id":"Do4zDL2OK-5iKYO--ncqVA","date":"2016-02-29T04:08:17","stars":5,"text_representativeness":0.9360905885696411,"text_excerpt":"The champagne margarita was tasty. We also really enjoyed the chips and guacamole but the portion was pretty small. The prices were reasonable overall though. We sat in the courtyard which was a nice quiet escape from the madness of Bourbon street. Our server was very nice and attentive even though she was the only one working on a Sunday."},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","review_id":"SHIqRebxVgX4PeBDo4jGpw","date":"2010-06-10T05:21:14","stars":4,"text_representativeness":0.9353776574134827,"text_excerpt":"I learned about this place b/c there was a Daily Deal for it. 15 bucks for a 30 dollar gift certificate and i figured, we'll we're going to New Orleans, might as well. So we decided to go on a Tuesday night. Apparently Tuesdays is their big deal night. $2 margaritas, beers, shots, tacos, chips and salsa, and some other stuff. We ordered a TON of margaritas and shots and tacos and chips and salsa and our tab came out to $24. A couple of redbull and vodkas later and we broke the $30 mark. The prices were awesome and the wait staff was good, responsive. The tacos were good, not amazing but good. Drinks were good too. Nothing to complain about, I recommend, especially on a Tuesday."},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","review_id":"QaSwBZliqYdiRiPHdx5xLQ","date":"2013-01-14T23:34:33","stars":4,"text_representativeness":0.9316246509552002,"text_excerpt":"Great selection of tequila - duh. Tacos were fresh and yummy and not too expensive, like some other Tex Mex places in the French Quarter. Service was quick (table) and polite. The location being Bourbon Street nearly scared me away but it didn't and I'm glad. I'll go back for sure."}],"visual":[{"business_id":"3iBEhAuFPzXFczSjeo_RAg","photo_id":"uWEhg3M3YiUdKchJ0BKl8g","label":"drink","image_url":"/photos/uWEhg3M3YiUdKchJ0BKl8g.jpg","visual_representativeness":0.9045245051383972},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","photo_id":"akv5chEAyQa-_thuWPOcfw","label":"drink","image_url":"/photos/akv5chEAyQa-_thuWPOcfw.jpg","visual_representativeness":0.8951801061630249},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","photo_id":"As7eB73MXzTz0spd6LcvBA","label":"inside","image_url":"/photos/As7eB73MXzTz0spd6LcvBA.jpg","visual_representativeness":0.8593800067901611},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","photo_id":"Dc8SPNJkKwdMczfPmE5IdQ","label":"inside","image_url":"/photos/Dc8SPNJkKwdMczfPmE5IdQ.jpg","visual_representativeness":0.8093849420547485},{"business_id":"3iBEhAuFPzXFczSjeo_RAg","photo_id":"ckli0AhzGSAlgCCqCxLTnw","label":"inside","image_url":"/photos/ckli0AhzGSAlgCCqCxLTnw.jpg","visual_representativeness":0.6259101629257202}]},"notebook_case":null}
