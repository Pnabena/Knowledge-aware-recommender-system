al_business_count":0},{"category":"Southern","historical_business_count":2},{"category":"Nightlife","historical_business_count":5}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Breakfast & Brunch, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Nightlife, Restaurants, Southern","shared_category_count":3},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Nightlife, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Nightlife, Restaurants","shared_category_count":2},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Nightlife","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"mhj9KWNqKnEAb55-94ZzfA","review_id":"KF4YRvHXNf68ZN_thNAZjw","date":"2019-01-25T19:14:49","stars":4,"text_representativeness":0.9346837401390076,"text_excerpt":"Live Oak is a little gem. The music is always great and definitely uplifts my mood when I hear it. This is a great breakfast/brunch spot. The food is amazing. My favorite is \"the hangover\", which is cheese grits, over-easy eggs (you can request them another way), ham, and bacon bits. Their grits are SO creamy and tasty. Perfectly salted. My runner up meal is definitely the blueberry hill pancakes. OMG. I almost licked my plate. Three pancakes with strawberries, blueberry compote, and fresh Chantilly cream. I love a good homemade whipped cream. You can get eggs and your choice of meat on the side for $3.50 more. Coming in third place is their yummy, creamy shrimp and grits. Mind you this i..."},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","review_id":"Y8chFhTMr4AMapIIwCW5sQ","date":"2019-09-23T17:46:10","stars":4,"text_representativeness":0.9344747066497803,"text_excerpt":"I came here the other day with my sister and brother in law because we had their dog and we were looking for a nice little brunch spot in the uptown area that was dog friendly. This place was so amazing! They had live music going on inside, but because we had Lucy, my sisters Boxer, we decided to sit outside to dine. They were so sweet! They even brought out a little water dish for her to have something to drink. It's such a cute, eclectic place. The ambiance both inside and out were really nice and the staff were amazing. Such a cute little uptown spot with great service. We tried a few dishes. We had some pancakes that were so light and fluffy and an eggs Benedict dish that came with Gr..."},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","review_id":"5Bmd_KHX5jTvX78xnBKLAA","date":"2016-10-30T20:13:21","stars":5,"text_representativeness":0.9275160431861877,"text_excerpt":"I love this place! Perfect spot for weekend brunch. It gets busy so you may have to wait a few minutes, but they have a great system for sitting you down and try to get you settled in as quickly as possible. Its bright and sunny with fab live music and excellent coffee. The frozen boozy coffee looks phenomenal (though I didn't partake) and my BLT with a fried egg and avocado was incredible. Literally cleaned the plate."}],"visual":[{"business_id":"mhj9KWNqKnEAb55-94ZzfA","photo_id":"R4D6y8EOnNW38I36IGTmqA","label":"drink","image_url":"/photos/R4D6y8EOnNW38I36IGTmqA.jpg","visual_representativeness":0.9172735214233398},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","photo_id":"EEXLp3CcG7c-coXGQBCxMQ","label":"food","image_url":"/photos/EEXLp3CcG7c-coXGQBCxMQ.jpg","visual_representativeness":0.8538709282875061},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","photo_id":"wGOORwNyOECSksqB73UWMA","label":"inside","image_url":"/photos/wGOORwNyOECSksqB73UWMA.jpg","visual_representativeness":0.8488336801528931},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","photo_id":"tEhXEjgsUrBd93JjsFY2Uw","label":"food","image_url":"/photos/tEhXEjgsUrBd93JjsFY2Uw.jpg","visual_representativeness":0.8271293640136719},{"business_id":"mhj9KWNqKnEAb55-94ZzfA","photo_id":"svzDyXTZFCbOAItt5XMHwg","label":"inside","image_url":"/photos/svzDyXTZFCbOAItt5XMHwg.jpg","visual_representativeness":0.7610915899276733}]},"notebook_case":null}
