_row":3279,"nv_rank":2020,"mm_rank":1527,"target_category_support_fraction":0.5,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Burgers","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ytY1d6GAmOiuSNLeUw0DTw","review_id":"sOw9oKwnehke20lFqToOAg","date":"2008-06-05T23:54:30","stars":5,"text_representativeness":0.9234384298324585,"text_excerpt":"Great Burger joint (with several locations around the metro area). I highly reccomend the #4 with smoke sauce. Plus nothing beats piggin out on bud's chili cheese fries at the clearview Bud's when you drunk at 4 am."},{"business_id":"ytY1d6GAmOiuSNLeUw0DTw","review_id":"1N62AgsfHUvtfzpfY8txhw","date":"2016-12-03T20:00:43","stars":5,"text_representativeness":0.9205789566040039,"text_excerpt":"Personal fav. Cheap, easy, good. I like that the fries don't come out salty, add your own. Nuggets are good. But the sauce is the best. Been going here for years, great for families to eat here or pick up. Love how it hasn't changed much, for the better at least for me. The classics never disappoint. You know what you are getting when you go. Thanks bud!"},{"business_id":"ytY1d6GAmOiuSNLeUw0DTw","review_id":"tPv87fKzKxvczT3NoT_PUA","date":"2012-06-05T04:30:26","stars":4,"text_representativeness":0.9144161343574524,"text_excerpt":"Quite simply I love Bud's, yet there isn't a single shred of decency within the menu. It's greasy burgers and inexpensive, decent beer. The picnic table style set up rocks, the handpainted menu board is older than you, and it can get a little packed during the lunch hour. That said, the service is quick and the price is right. It's like the original fast food concept but no drive thru and it's local with other sites around the city too."}],"visual":[{"business_id":"ytY1d6GAmOiuSNLeUw0DTw","photo_id":"nrQojXlZgqzbTEEjHiBTBA","label":"outside","image_url":"/photos/nrQojXlZgqzbTEEjHiBTBA.jpg","visual_representativeness":1.0}]},"notebook_case":null}
