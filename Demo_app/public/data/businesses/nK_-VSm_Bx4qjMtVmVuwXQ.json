nk_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Donuts","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Bakeries","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"nK_-VSm_Bx4qjMtVmVuwXQ","review_id":"jNUZx9TwmR_hUQ_tkD0txw","date":"2019-03-01T10:49:29","stars":5,"text_representativeness":0.909135639667511,"text_excerpt":"Grabbed a dozen donuts yesterday and a couple of something else, round and small and cinnamony. All was delightful. The donuts were somehow both light and fluffy, yet still dense enough for one to be satisfying. Though, I wager eating only one will be a difficulty. They're just a couple miles from home and on the way to work. This will surely be a problem for both time and diet."},{"business_id":"nK_-VSm_Bx4qjMtVmVuwXQ","review_id":"mC23lnTu7GNXORr1LVTTlA","date":"2021-01-27T13:53:09","stars":5,"text_representativeness":0.9035277366638184,"text_excerpt":"OK, being from Cali is cool, but NOLA bakeries, honestly put us to shame! I'm almost 50 and I've never seen twisted donuts with chocolate and vanilla glaze!! The best of both worlds!! The eggs don't need cheese but, they taste like it's some in there... and they melt in your mouth! The grits are well cooked, perfect for your daily dose of folic acid. I now know why breakfast is the most important meal of the day!"},{"business_id":"nK_-VSm_Bx4qjMtVmVuwXQ","review_id":"YQH4DA1kVADx1ZZTKvtBWA","date":"2021-02-19T19:08:17","stars":5,"text_representativeness":0.8987669348716736,"text_excerpt":"The best neighborhood bakery! I've lived very close to Mr. B's (previously Honey Whip Donuts) for a very long time now and I can confidently say that I have never come across a bakery quite like it. For the longest time I would just get the donuts, which are to die for, but this year I finally tried one of their king cakes and OMG it was amazing! It is very similar to Randazzo's king cakes, so if you like those, then you'll definitely like Mr. B's king cakes. I may have even liked Mr. B's more than Randazzo's. On top of that, Mr. B, his wife, and the employees are some of the nicest people you will ever meet. Do yourself a favor and try out Mr. B's bakery!"}],"visual":[{"business_id":"nK_-VSm_Bx4qjMtVmVuwXQ","photo_id":"uV3rLmlqZqQTiMRjGDpcrA","label":"food","image_url":"/photos/uV3rLmlqZqQTiMRjGDpcrA.jpg","visual_representativeness":1.0}]},"notebook_case":null}
