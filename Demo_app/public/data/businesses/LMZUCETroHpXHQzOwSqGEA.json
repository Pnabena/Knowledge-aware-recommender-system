usiness_id":"LMZUCETroHpXHQzOwSqGEA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1776,"mm_rank":1455,"target_category_support_fraction":0.5,"selected_image_count":2,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Tacos","historical_business_count":1},{"category":"New Mexican Cuisine","historical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Mexican","historical_business_count":1},{"category":"Japanese","historical_business_count":0},{"category":"Ramen","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Mexican, Restaurants, Tacos","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"LMZUCETroHpXHQzOwSqGEA","review_id":"qkYqeZBy44yfnDSUpK-EkQ","date":"2020-11-25T18:30:50","stars":5,"text_representativeness":0.9504772424697876,"text_excerpt":"Really great place and amazing food. Kind of tucked away right off of tchop but definitely worth finding it. They have outdoor seating only and to go. The food was flavorful and I loved the Mexican au jus dipping sauce. What we ordered: -Queso and Cracklin: definitely unique that it came with cracklin but it was still tasty. The queso was a little thinner than I liked but that's just a preference thing. -Birria tacos: the tacos were amazing! I loved the meet and cheese and flavors. The dipping sauce was tasty but very heavy cilantro flavor which I love but I wouldn't recommend it if you don't like cilantro. -Beef Birriarito: this was really tasty and a little spicier than the tacos. I thi..."},{"business_id":"LMZUCETroHpXHQzOwSqGEA","review_id":"0YDZGHtow_1FSQm2IbzPAg","date":"2021-05-16T20:05:06","stars":5,"text_representativeness":0.9492341876029968,"text_excerpt":"I loved checking out Secret Birria! I've been wanting to try birria tacos for so long and thought they were pretty good. I'm not a huge brisket fan in general, but I enjoyed them! I loved the fish tacos, and the queso & cracklins was a great appetizer. I finished with the tres leches cake which was pretty good as well! This is a very lowkey neighborhood-like place, and it's also byob which I think is very cool. This is a also grab & go type restaurant, but they do have some outdoor seating on the side of the restaurant which is nice when the weather is good! The staff was attentive and nice. Definitely check this place out if you haven't tried birria tacos yet!"},{"business_id":"LMZUCETroHpXHQzOwSqGEA","review_id":"XYOEfmdFWpZVXvsTkq1XhA","date":"2021-01-13T16:48:55","stars":4,"text_representativeness":0.9450469613075256,"text_excerpt":"Birria tacos were pretty dang good, and it's a great location on Tchoup. We loved the tacos, and the cracklings with queso. We will be back for sure!"}],"visual":[{"business_id":"LMZUCETroHpXHQzOwSqGEA","photo_id":"YnxKTfqiv_xncbTOU9Mw8A","label":"food","image_url":"/photos/YnxKTfqiv_xncbTOU9Mw8A.jpg","visual_representativeness":0.8783087730407715},{"business_id":"LMZUCETroHpXHQzOwSqGEA","photo_id":"1z7BkyP5x3St2aqKGt-uJg","label":"food","image_url":"/photos/1z7BkyP5x3St2aqKGt-uJg.jpg","visual_representativeness":0.8783087730407715}]},"notebook_case":null}
