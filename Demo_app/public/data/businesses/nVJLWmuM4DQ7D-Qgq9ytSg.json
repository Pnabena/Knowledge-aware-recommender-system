dD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2009,"mm_rank":1743,"target_category_support_fraction":0.4,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Meat Shops","historical_business_count":0},{"category":"Barbeque","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Specialty Food","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"nVJLWmuM4DQ7D-Qgq9ytSg","review_id":"IF0Y27NA5RI-TplgAPS6mw","date":"2016-01-10T00:39:49","stars":5,"text_representativeness":0.9364092350006104,"text_excerpt":"I have been searching for a place where I can get consistently great BBQ and who knew that it would be located withing blocks from my house. BBQ Kings is for me the best BBQ in the city. The pork ribs were perfectly smoked with great flavor served wrapped in foil to keep warm and smothered in a great homemade sauce. The stars of the show here are the sides, I had a great vinegar coleslaw and baked beans. One of my friends had potato salad that was almost just as good as what my mother makes at home, full of seasonings and lights on mayo. My friends also had a smoked Tilapia sandwich, pulled pork sandwich and hot link sandwich all of the sandwiches were reported to be outstanding. Another ..."},{"business_id":"nVJLWmuM4DQ7D-Qgq9ytSg","review_id":"lOYl35AbPDq9T_kZbiMBXg","date":"2013-08-30T21:38:03","stars":4,"text_representativeness":0.9316678643226624,"text_excerpt":"Man! On Man! This is some good BBQ flavor. Never heard about this place but apparently it was reopened after serving New Orleans for a long time. I enjoyed the bbq chicken, baked beans (yum) potato salad and mac & cheese. I felt like I was at a back yard bbq of a grillmaster on the Food network. It's a very small place, just a bar seating.. I would suggest takeout and eat at home."},{"business_id":"nVJLWmuM4DQ7D-Qgq9ytSg","review_id":"NIz4nO2euFl4w9tkppwWMw","date":"2014-03-24T14:35:34","stars":5,"text_representativeness":0.9251985549926758,"text_excerpt":"It was so good. The restaurant is unassuming, but that's how a BBQ joint should be, right!? The food was so good. The ribs were meaty and tender, the chicken was moist. It was smoky and well seasoned, but not overly salty like some BBQ. Their sauce has to be homemade; it was awesome. Great potato salad, tasted like my grandmother's! Can't wait to go back."}],"visual":[{"business_id":"nVJLWmuM4DQ7D-Qgq9ytSg","photo_id":"-p9Hy8jFcVIFtrPomlgAyQ","label":"food","image_url":"/photos/-p9Hy8jFcVIFtrPomlgAyQ.jpg","visual_representativeness":1.0}]},"notebook_case":null}
