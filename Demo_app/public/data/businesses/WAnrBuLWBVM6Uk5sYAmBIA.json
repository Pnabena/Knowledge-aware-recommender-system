3333333,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Shaved Ice","historical_business_count":0},{"category":"Local Flavor","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"WAnrBuLWBVM6Uk5sYAmBIA","review_id":"_kSZsRMEPstK4-X4KacTHw","date":"2020-11-04T15:51:18","stars":5,"text_representativeness":0.9565662145614624,"text_excerpt":"This is the best snowball stand in the east. I've been going to this snowball stand for at least five years now and their snowballs are so full of flavor. I don't know how long they have been in business but I am glad I discovered them. I grew up going to what I thought was was the best snowball stand in the east, you know the one on Lake Forest, but I was wrong. I released I was wrong when Brain Freeze was closed and I went to the other one. I ordered my fav, a peach and pink lemonade and boy was it watery. I was so disappointed and dissatisfied. Their nachos are always on point, cheese always hot and the perfect thickness. If you are in New Orleans East and in the mood for a snowball, s..."},{"business_id":"WAnrBuLWBVM6Uk5sYAmBIA","review_id":"E7Fsu21_Hy4vItRpIwyeAg","date":"2019-05-05T12:05:57","stars":5,"text_representativeness":0.9418604373931885,"text_excerpt":"Yes!!! This my favorite of all times snowball stands. It sells the other stuff expected and the flavor of the snowballs is amazing. It has a little sitting area out front and it's next to a seafood place (haven't tried them yet). So my current love is the creole cream cheese with condensed milk on top. I am in heaven when I am eating this. Don't be afraid of the line, it could be long but it moves efficiently and the service is ok."},{"business_id":"WAnrBuLWBVM6Uk5sYAmBIA","review_id":"omzsc0fsaKrYbBpYvmh58Q","date":"2019-03-10T03:04:30","stars":5,"text_representativeness":0.9397071599960327,"text_excerpt":"This place had a nice long list of options for flavors and toppings. They also did the usual other food items you find at a snowball stand (nachos, ice cream etc...)The snowball was nice and juicy I got the sour apple and Georgia peach! The ice was fluffy. I haven't found ice like that outside of the New Orleans area. There is a nice area outside to sit and eat your food if you don't want to take it to go.And it's right next to Castnet Seafood! What could be better."}],"visual":[{"business_id":"WAnrBuLWBVM6Uk5sYAmBIA","photo_id":"5XU8-fGrHqnLbZl_uh0W8Q","label":"food","image_url":"/photos/5XU8-fGrHqnLbZl_uh0W8Q.jpg","visual_representativeness":0.8978433609008789},{"business_id":"WAnrBuLWBVM6Uk5sYAmBIA","photo_id":"wvuMavf_TIZeMmWgVZhq2Q","label":"outside","image_url":"/photos/wvuMavf_TI