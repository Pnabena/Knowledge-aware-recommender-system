s_count":4},{"category":"American (New)","historical_business_count":2},{"category":"Restaurants","historical_business_count":8},{"category":"Southern","historical_business_count":2},{"category":"Breakfast & Brunch","historical_business_count":1},{"category":"Country Clubs","historical_business_count":0},{"category":"Bars","historical_business_count":5}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Bars, Breakfast & Brunch, Cajun/Creole, Nightlife, Restaurants","shared_category_count":6},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants, Southern","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","review_id":"N92kUGuqyK310pd6hMs2kQ","date":"2019-05-10T17:30:31","stars":5,"text_representativeness":0.9447739124298096,"text_excerpt":"This place is amazing!! Great service and friendly staff. The bottomless mimosas where great and staff was on point making sure the were refilled. Our group shared crab cake, boudin ball, truffle Mac and cheese . Which were all delicious and good portion sized. I had strawberry chicken waffles which were delightful and perfect. Waiter gave us to go cup and then we went to pool. Bit on pricey side but so worth it for portion and taste. One of the best brunches I've had in new orleans. Outside pool is bit expensive. 15$ each person and 2$ for locker. But so worth it."},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","review_id":"BOg2hCeUmXUim8rEOQ0iyA","date":"2018-09-22T01:23:25","stars":4,"text_representativeness":0.9420954585075378,"text_excerpt":"My friend and I were wandering through Bywater and looking at colorful houses when we got caught in a torrential downpour. We sought refuge in a nearby industrial warehouse and started googling places we could hang out until it was over. The Country Club popped up and it was nearby so we called a Lyft and were on our way. It looked pretty cool from the outside, like a giant fancy house. And welcoming, complete with pride flags over the door. Inside I was even more impressed. Really large and spacious, high ceilings and cool decor. Given that it was a Monday during the day it wasn't totally full but there were people sitting in the bar. We also discovered there was a pool out the back with..."},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","review_id":"1j31NbQGj22XIRLQh8MrtA","date":"2014-01-19T17:06:20","stars":5,"text_representativeness":0.937881350517273,"text_excerpt":"I love this place for so many different reasons. On Saints noon games, grabbing a seat at the bar for bottomless mimosas is the most fabulous way to brunch it up. In the heat of the early summer months, the pool out back is absolutely my favorite place to catch some some and cool off. The food is amazing, the courtyard is beautiful, the drinks and cold and fruity (unless you know, you order a non-fruity drink.) It's one of the places that make New Orleans an awesome place to call home. Disclaimer: if you're a prude, don't bother or stay in the front of the house for brunch. The pool is $10 a day, or you can get a year's membership but it is clothing optional, just in case that wasn't made..."}],"visual":[{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","photo_id":"fF3ossFJmI_yMeYHTzpPtw","label":"outside","image_url":"/photos/fF3ossFJmI_yMeYHTzpPtw.jpg","visual_representativeness":0.8503677845001221},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","photo_id":"d1N7L-qsYX5PJxRlLn2mmg","label":"inside","image_url":"/photos/d1N7L-qsYX5PJxRlLn2mmg.jpg","visual_representativeness":0.84110426902771},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","photo_id":"fFM2OTmEqNmAvpNGFsA6rQ","label":"inside","image_url":"/photos/fFM2OTmEqNmAvpNGFsA6rQ.jpg","visual_representativeness":0.8242131471633911},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","photo_id":"_YtIaeBLDUEsFXZoHvNshQ","label":"drink","image_url":"/photos/_YtIaeBLDUEsFXZoHvNshQ.jpg","visual_representativeness":0.8164187669754028},{"business_id":"9kv9JpLhzkN3UeWZDrsmEA","photo_id":"2A1jFIyD9CoQBV8UFNjC4w","label":"food","image_url":"/photos/2A1jFIyD9CoQBV8UFNjC4w.jpg","visual_representativeness":0.7831580638885498}]},"notebook_case":null}
