w":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":1604,"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","nv_rank":433,"mm_rank":412,"nv_score":0.5456492304801941,"mm_score":0.5102221965789795,"rank_movement":21,"has_visual_feature":true,"name":"Brennan's Restaurant","address":"417 Royal St","city":"New Orleans","state":"LA","postal_code":"70130","stars":3.5,"review_count":349,"categories":["Cajun/Creole","Breakfast & Brunch","Restaurants"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":433,"mm_rank":412,"target_category_support_fraction":1.0,"selected_image_count":4,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Cajun/Creole","historical_business_count":4},{"category":"Breakfast & Brunch","historical_business_count":1},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Breakfast & Brunch, Cajun/Creole, Restaurants","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","review_id":"F9IBBH8I_oKGBn_s1LMGBQ","date":"2012-05-13T15:11:17","stars":5,"text_representativeness":0.933870792388916,"text_excerpt":"I chose Brennan's because its in the Quarter and I wanted to walk around Bourbon St. a bit after dinner. Also it was one of the few recommended restaurants I was able to get reservations for on one hour's short notice. Many Yelp reviews gave me the wrong impression, that Brennan's is for breakfast or brunch, but I came here for dinner - and it was excellent: gumbo, soft shell crab, Oysters Rockefeller, Blackened Snapper. Everything was perfectly prepared; there was nothing \"touristy\" about that. Upscale interior, historic building, great location. A wedding reception was taking place in the courtyard, and I took that to be a good sign. Our waiter was really good - very outgoing, proud of ..."},{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","review_id":"awp4BSeZNqBp2KWJHc-9Qw","date":"2010-01-22T18:06:01","stars":5,"text_representativeness":0.9337573051452637,"text_excerpt":"I've only been to Brennan's once in my life, even thought I'm a native, and that will be three years ago come March 2 but it was an amazing experience. I hope to go again. It is pricey and definitely not Weight Watchers friendly, which is why I haven't been more often but it is worth it. It is most definitely an over the top brunch in the best sense. I had something with eggs. It has been so long, I kind of forget but it was delicious. The bananas foster presentation is a spectacle and very yummy. The service was amazing and the facility, in its historic home, is gorgeous."},{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","review_id":"4nmjUNonwKjKlbTb5hKLJw","date":"2009-06-29T03:25:57","stars":4,"text_representativeness":0.9325273036956787,"text_excerpt":"Fabulous brunch spot. It's pretty expensive for brunch, but definitely worth it. The service was awesome and the food was delicious. They have various versions of eggs benedict on the menu. I went with the Eggs Hussarde, which was awesome. Plenty of flavor and a good-sized portion of eggs. My friends also said the omelets and the turtle soup were very good. I highly recommend this place and you have to get the bananas foster. After all, they were invented here. And, the brandy milk punch was a great eye-opener to start the meal."}],"visual":[{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","photo_id":"Ca9-0C8Gwl40w4bTpF1jlQ","label":"inside","image_url":"/photos/Ca9-0C8Gwl40w4bTpF1jlQ.jpg","visual_representativeness":0.8676486015319824},{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","photo_id":"VkyWf0wBVXTsxKWUhVQr6w","label":"outside","image_url":"/photos/VkyWf0wBVXTsxKWUhVQr6w.jpg","visual_representativeness":0.8391926288604736},{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","photo_id":"U-VV4zUwzr0vUrExCfsKtQ","label":"food","image_url":"/photos/U-VV4zUwzr0vUrExCfsKtQ.jpg","visual_representativeness":0.819372296333313},{"business_id":"dJ1ihpr-XH-Nt-CVrnJE9A","photo_id":"2drPWJfOx6SRkiR8bg7EHg","label":"food","image_url":"/photos/2drPWJfOx6SRkiR8bg7EHg.jpg","visual_representativeness":0.8153507709503174}]},"notebook_case":null}
