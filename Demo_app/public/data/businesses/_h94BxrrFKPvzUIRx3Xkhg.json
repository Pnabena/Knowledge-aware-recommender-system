count":5},{"category":"Sandwiches","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Cajun/Creole, Cocktail Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants, Seafood","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"_h94BxrrFKPvzUIRx3Xkhg","review_id":"56dQSEyro-DMjqw_VIaEPQ","date":"2016-02-08T20:12:17","stars":4,"text_representativeness":0.9311263561248779,"text_excerpt":"I enjoyed my dinner at Saints and Sinners. The location is prime, it is right on Bourbon Street in the middle of everything. The staff was very friendly and accommodating. We had a reservation, and I had requested to be by the TV for a playoff game that my fiancé wanted to watch. The manager came out to make sure that we liked our table and that the correct game was on. The décor was really cool, and I liked the vibe of the lounge. Creative and fun drink menu. The food was good but not great. We had the chargrilled oysters, which were the best part of the meal. The jambalaya was just okay. I am glad that we came here, but I do not think that we would come back on our next trip. Definitely..."},{"business_id":"_h94BxrrFKPvzUIRx3Xkhg","review_id":"Gj7FUfbsBI7eQyycTCmOFw","date":"2016-03-16T01:37:52","stars":4,"text_representativeness":0.9262039661407471,"text_excerpt":"Place was pretty good, excellent service. The seating outside is limited, but right on Bourbon St. The crawfish was pricey for the amount you get but was spicy and had good flavor. They took forever getting us our oysters but gave us free cocktails on the house because of it. I like that trade :)"},{"business_id":"_h94BxrrFKPvzUIRx3Xkhg","review_id":"HcdwK79p-sM57RqxUTLchQ","date":"2014-10-30T04:07:12","stars":4,"text_representativeness":0.9224221706390381,"text_excerpt":"I had never been to S&S before the Yelp event last week, mostly because I don't spend a whole lot of time on Bourbon, but it was nice. The drink special they had was delicious, and the food they served was actually really good as well. I loved the shrimp and tasso pasta. Now that I look at the menu, I see that the dish costs $18. Maybe I should have taken the manager up on the offer when she said I should take some home. ;) Speaking of the manager, she came around and introduced herself to everyone and she seemed really cool. I may stop in here if I ever have to be on Bourbon St for whatever reason. The cocktails on the menu sound pretty good."}],"visual":[{"business_id":"_h94BxrrFKPvzUIRx3Xkhg","photo_id":"lOB_uW2ylxF2TNj1fPySEQ","label":"inside","image_url":"/photos/lOB_uW2ylxF2TNj1fPySEQ.jpg","visual_representativeness":0.8914607167243958},{"business_id":"_h94BxrrFKPvzUIRx3Xkhg","photo_id":"qoos9ELeGLy_jPYMjH3waQ","label":"outsi