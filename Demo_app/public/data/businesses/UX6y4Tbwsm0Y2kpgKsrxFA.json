al_rank_effect":null},"category_overlap":[{"category":"Mexican","historical_business_count":1},{"category":"Fast Food","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Mexican, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"UX6y4Tbwsm0Y2kpgKsrxFA","review_id":"jHgEWJKhFqcx2CQfOm3k2A","date":"2020-11-16T14:42:14","stars":5,"text_representativeness":0.9355610609054565,"text_excerpt":"What's there to say. Chipotle always hits the spot. Food is quick, typically warm and fresh. Great portion sizes. Get that tortilla on the side. Nosh on that burrito bowl. Only downside is there's not free street parking right in front until after 7pm, otherwise street parking around the side. My roommate used to eat here 4-5x a week. Enough said."},{"business_id":"UX6y4Tbwsm0Y2kpgKsrxFA","review_id":"D_qFl1bRrRHYqxpD9M1Qew","date":"2021-01-18T18:46:21","stars":4,"text_representativeness":0.9345403909683228,"text_excerpt":"Chipotle is pretty consistent. If you want Mexican food on the go Chipotle is the place to go. I always get the chicken bowl and no matter what location I go to it always taste the same. If you're in a rush I recommend you use the app to place your order, that way it's ready when you get there. My only complaint with Chipotle is that they don't sell Margaritas. How can you be a Mexican grill with no margaritas?! Great Magazine Street location. A few outside tables. Be prepared to pay a meter for parking or park on a side street. #NeatToBe2021Elite"},{"business_id":"UX6y4Tbwsm0Y2kpgKsrxFA","review_id":"Hb6w03BsKng1soDKWZvTYg","date":"2020-11-19T22:07:31","stars":4,"text_representativeness":0.9140397906303406,"text_excerpt":"I can't deny that I love Chipotle. I ordered through the app and set up a pickup time. You can customize a lot on the app which I appreciate. When I got there, my order was ready at the counter. I had to tell the cashier I was there to pick up an order. Can't say it was any better or worse Chipotle experience. And my burrito was delicious!"}],"visual":[{"business_id":"UX6y4Tbwsm0Y2kpgKsrxFA","photo_id":"JbngGSwowawSUIMUiayISQ","label":"food","image_url":"/photos/JbngGSwowawSUIMUiayISQ.jpg","visual_representativeness":0.9652096629142761},{"business_id":"UX6y4Tbwsm0Y2kpgKsrxFA","photo_id":"L7fanlcCf6M9HthMx1b2og","label":"food","image_url":"/photos/L7fanlcCf6M9HthMx1b2og.jpg","visual_representativeness":0.9652095437049866}]},"notebook_case":null}
