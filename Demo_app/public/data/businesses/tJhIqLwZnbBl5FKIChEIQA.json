s_count":8},{"category":"Venues & Event Spaces","historical_business_count":0},{"category":"Nightlife","historical_business_count":5}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"tJhIqLwZnbBl5FKIChEIQA","review_id":"OcddBPgA_vkTMLsiTQGYQw","date":"2017-09-14T17:23:23","stars":4,"text_representativeness":0.9575114250183105,"text_excerpt":"The coolest thing about this place is the place itself. Such a wonderful building with tons of nooks and crannies and character in droves. It's artistic without being pretentious. Everyone can feel comfortable and hip. The drink menu is solid, with a combination of classic cocktails and some exciting new concoctions. I had two of the new drinks-one mezcal one bourbon. They were both pretty good. I also had the pork belly and brussel sprout small dish. As single bites, the sprouts were not quite charred enough for my taste and the pork belly wasn't seared quite hard enough, but eaten together, in one bite, the whole thing really worked. I enjoyed my time here, and would come back, for sure."},{"business_id":"tJhIqLwZnbBl5FKIChEIQA","review_id":"ShlK2iE-Fdn7zRmRBGvcwQ","date":"2019-03-29T02:20:01","stars":4,"text_representativeness":0.9411625862121582,"text_excerpt":"Went here the other night with friends for drinks and wound up having dinner. The cocktails were amazing however I was quite surprised at how good the food was. We had a few appetizers to start and the brussell sprouts were an instant hit at the table. They were so good we had 4 orders of them. The finish it off I had a fish entree ( the drinks were so could I can't really remember exactly what dish I ordered) which was amazing as well. This place is right around the corner for our place so we will certainly be back."},{"business_id":"tJhIqLwZnbBl5FKIChEIQA","review_id":"Y8zwoGKeGShe_Iv3PxR35A","date":"2017-02-02T14:39:13","stars":4,"text_representativeness":0.9403764009475708,"text_excerpt":"Love this place for happy hour. Great vibe and atmosphere. Sat at the bar a couple of times and had great conversation with the bartender on cocktails. Drinks listed in chronological order and I love a wine list that has wines I've never tried. Scallop dish was very good!!"}],"visual":[{"business_id":"tJhIqLwZnbBl5FKIChEIQA","photo_id":"Bo2YD159mJ_p2hcV2cIwQg","label":"inside","image_url":"/photos/Bo2YD159mJ_p2hcV2cIwQg.jpg","visual_representativeness":0.9039183855056763},{"business_id":"tJhIqLwZnbBl5FKIChEIQA","photo_id":"oxp7AD-OMZNUkG-0LPRGwQ","label":"drink","image_url":"/photos/oxp7AD-OMZNUkG-0LPRGwQ.jpg","visual_representativeness":0.9006087183952332},{"business_id"