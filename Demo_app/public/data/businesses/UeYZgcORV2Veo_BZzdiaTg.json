rical_business_count":0},{"category":"Nightlife","historical_business_count":5},{"category":"Cafes","historical_business_count":0},{"category":"Bars","historical_business_count":5},{"category":"Restaurants","historical_business_count":8},{"category":"Event Planning & Services","historical_business_count":0},{"category":"Salad","historical_business_count":0},{"category":"Sandwiches","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"UeYZgcORV2Veo_BZzdiaTg","review_id":"NgZwYIzAOHUvM0LPhMoUdQ","date":"2020-05-08T12:32:09","stars":4,"text_representativeness":0.945000410079956,"text_excerpt":"Napoleon House was a great place to grab a bite to eat, including some New Orleans favorites. My friends and I arrived around 7:30 and had a short wait, only about 10 minutes or so. The building is historic and full of character. They're known for their muffulettas and their Pimms cup, so my boyfriend and I ordered both, along with a side of jambalaya and boudin sausage. Our server was very polite and provided great service. Our food took awhile to come out, and we were delivered someone else's meals at first, oops! Luckily our food came out shortly after that, because we were getting hungry! My boyfriend and I got the half muffuletta to share, which was just enough for us. It was delicio..."},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","review_id":"vNWnxNc7DqT6MBQ3_ZZXLQ","date":"2017-01-02T19:48:25","stars":5,"text_representativeness":0.944717526435852,"text_excerpt":"My go-to spot to eat and drink in the quarter. This is the one place where locals come to eat, drink and be merry. Napoleon House lunch out on the patio on a nice day is an experience that cannot be beat anywhere. My favorites are the famous Pims Cup of course, the warm muffuletta, huge plate of red beans and rice served with a side of smoked sausage, the shrimp remoulade stuffed avocado, there is not much on the menu that isnt great except maybe the Ruben sandwich that if you are in New Orleans you want a local dish anyways. What makes this place even more exceptional is that they dont gouge you charging tourist prices, its why its a locals hangout. Love this joint."},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","review_id":"vjEQvWibS2_vlSi9KiGvUA","date":"2015-10-28T15:00:53","stars":4,"text_representativeness":0.9443111419677734,"text_excerpt":"We decided to stop in here for lunch after wandering around the French Quarter. We read that their Muffuletta was good, so that's what we tried. We shared 1/2 of a Muffuletta, and it was perfect for lunch. We also had two Abita Ambers (our favorite local beer). The place is great - looks like it hasn't been touched in 100 years, but in this case that's a good thing. Service was great, and the place was perfect for a casual lunch. Definitely stop in here if you are in the quarter and looking for a place to eat!"}],"visual":[{"business_id":"UeYZgcORV2Veo_BZzdiaTg","photo_id":"C1hVxquxTJDH5kFMGQXPvQ","label":"inside","image_url":"/photos/C1hVxquxTJDH5kFMGQXPvQ.jpg","visual_representativeness":0.8804246187210083},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","photo_id":"WQQ5po808h9ayrzrR7fMuQ","label":"inside","image_url":"/photos/WQQ5po808h9ayrzrR7fMuQ.jpg","visual_representativeness":0.8522295355796814},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","photo_id":"f7ZGNUrOliXHhqwAkNmlDA","label":"food","image_url":"/photos/f7ZGNUrOliXHhqwAkNmlDA.jpg","visual_representativeness":0.8291777968406677},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","photo_id":"pZR8Laws3PosRRt5920cdQ","label":"outside","image_url":"/photos/pZR8Laws3PosRRt5920cdQ.jpg","visual_representativeness":0.820420503616333},{"business_id":"UeYZgcORV2Veo_BZzdiaTg","photo_id":"q8faie2U1wcEAZfYjmPQxQ","label":"drink","image_url":"/photos/q8faie2U1wcEAZfYjmPQxQ.jpg","visual_representativeness":0.8166284561157227}]},"notebook_case":null}
