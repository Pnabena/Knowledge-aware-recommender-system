storical_business_count":0},{"category":"Restaurants","historical_business_count":8},{"category":"Bars","historical_business_count":5},{"category":"American (New)","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"hVS67L6bYtNZyuvqDX2O6w","review_id":"Vfzd4198khLlzr51ul_wMw","date":"2019-06-07T21:02:14","stars":5,"text_representativeness":0.923397958278656,"text_excerpt":"I enjoy visiting this place. Nice, peace, and just enough guest. I found it on Yelp & agree; I want everyone to know how great it is, but want to keep it like a neighborhood restaurant-comfortable & cozy! The pizza is large, love the fries, & the drinks are reasonably priced. Friendly staff & locals!"},{"business_id":"hVS67L6bYtNZyuvqDX2O6w","review_id":"9OrxjZ_lQoy7RTShBReqdA","date":"2021-05-10T17:13:38","stars":4,"text_representativeness":0.9129307270050049,"text_excerpt":"I love this little bar! It's right on the lake making for such a chill and relaxing atmosphere. When I went, the restaurant across the lake had a band which was loud enough for us to hear and enjoy. Unfortunately, we ordered a pizza that was nothing special. We ordered a small pepperoni pizza and added bacon and jalapeños. The pizza was very doughy and the bottom was covered in flour. The bacon was also very chewy. We ordered a Cesar salad that made up for the unimpressive pizza. The salad was drenched in a delicious dressing and covered in Parmesan cheese and croutons."},{"business_id":"hVS67L6bYtNZyuvqDX2O6w","review_id":"skMkmQz7vfYrl4fj6FjEDQ","date":"2018-11-08T03:03:00","stars":5,"text_representativeness":0.9105113744735718,"text_excerpt":"Off work late and looked for a place that we could get a good salad and a pizza, tired of the usual suspects in the neighborhood so I Yelped and found this little hidden gem. Wednesday must not be a busy night so we walked right in and were told to sit where ever we liked. Probably should of chose the bar so we could of chatted it up with the waitress/bartender but the hubs chose a table instead. I ordered hydration from her then headed to the table to wait for service. After a couple of questions we settled on two house Italian salads and a large pizza supreme. Salads were large enough for two but we were starved and both ate our own. They were tossed in a very tasty Italian dressing but..."}],"visual":[{"business_id":"hVS67L6bYtNZyuvqDX2O6w","photo_id":"tr5QdR1aubUWM7Fc300h1g","label":"inside","image_url":"/photos/tr5QdR1aubUWM7Fc300h1g.jpg","visual_representativeness":0.8728535175323486},{"business_id":"hVS67L6bYtNZyuvqDX2O6w","