r_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":883,"mm_rank":976,"target_category_support_fraction":0.3333333333333333,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Desserts","historical_business_count":0},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","review_id":"hTJ_z_Sc6jUrARaxbfCULA","date":"2019-12-27T17:56:33","stars":5,"text_representativeness":0.9259514212608337,"text_excerpt":"Was so excited to see that Aqua S finally has opened in Nola, bonus points for being in my neighborhood! Wasn't exactly sure what to expect upon trying this for the first time but had a good feeling it would be an Instagram worthy ice cream treat from researching the company's website. So my wife and I are dairy free so we opted to get the Apple Cinnamon flavor. They have extras you can add. I noticed pop rocks, which were one of my favorites as a child so we added those. I then saw \"fairy floss\" which sounded interesting. I asked one of the employees if this was by chance cotton candy, as I had noticed a cotton candy machine behind the counter. They informed me that yes this was the case..."},{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","review_id":"GG4vQLcvPMWwdACaVVDrlQ","date":"2020-02-06T21:35:50","stars":4,"text_representativeness":0.920793890953064,"text_excerpt":"Fun little place! There's new pop up flavors every 2 weeks as well as monthly rotating flavors on top of their their flagship sea salt. Pandan was the fun flavor while I visited, though they also had lychee pop up that was overly floral and not fruity enough...maybe they do better with creamy flavors rather than fruit flavors? On the upside, you can absolutely tell with the first lick that this is soft served ice cream and not fro yo from the silky smooth texture. Everything is hand made to help you get a final product that is picture perfect (aka the perfectly symmetric swirls of ice cream, also the girl who made the cotton candy threw away the first one she attempted to make for my orde..."},{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","review_id":"n94dAYjKPLE8MoNz7cWImA","date":"2020-04-22T14:46:23","stars":4,"text_representativeness":0.9202960133552551,"text_excerpt":"If you love soft serve ice cream, this is the place to go! I managed to get some mini tubs during this pandemic and it definitely fulfilled every sweet dream I've been having. My favorites were the matcha and lychee (dairy free). The lychee was more of a sorbet type of texture, but both were more on the semi-sweet side. The black sesame was alright in my opinion, while the Thai tea was quite milky but good. Definitely would be coming back to try more of their flavors!"}],"visual":[{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","photo_id":"iucH1B53oGBpySMZTevKFw","label":"outside","image_url":"/photos/iucH1B53oGBpySMZTevKFw.jpg","visual_representativeness":0.9264750480651855},{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","photo_id":"Effc8To7QEj3lohyls84aA","label":"food","image_url":"/photos/Effc8To7QEj3lohyls84aA.jpg","visual_representativeness":0.8760952353477478},{"business_id":"Kjt2eEFNoe9Zz8dwkbYc9w","photo_id":"j24exloNvmrcxdKm3nlwsw","label":"food","image_url":"/photos/j24exloNvmrcxdKm3nlwsw.jpg","visual_representativeness":0.8523563742637634}]},"notebook_case":null}
