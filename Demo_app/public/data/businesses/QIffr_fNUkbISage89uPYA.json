nk_effect":null},"category_overlap":[{"category":"Cajun/Creole","historical_business_count":4},{"category":"Chicken Wings","historical_business_count":0},{"category":"Southern","historical_business_count":2},{"category":"Chicken Shop","historical_business_count":0},{"category":"Soul Food","historical_business_count":0},{"category":"Restaurants","historical_business_count":8}],"history":[{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"QIffr_fNUkbISage89uPYA","review_id":"W6VuRussI-8c8gKi6D15Xw","date":"2021-04-15T14:08:52","stars":5,"text_representativeness":0.9157130718231201,"text_excerpt":"After checking out a few of the jazz bars on the Frenchmen Street and a few drinks in your system, the next thing to do is eat some food! This place was open late and was the perfect food to eat. There's just something about eating fried chicken late at night. Willie's Chicken Shack also sells adult beverages like those slushies that you see everyone walking down the street with. As far as the chicken goes, for being a chain (I think), it's pretty darn good chicken. The chicken, the fries, and the biscuit was exactly what we needed after a night out on Frenchmen street. It's a bonus that this place is open late too!"},{"business_id":"QIffr_fNUkbISage89uPYA","review_id":"o3BQdidCDC8VVzJjv-tLNw","date":"2019-12-28T05:09:07","stars":5,"text_representativeness":0.9045084714889526,"text_excerpt":"The fried chicken wings where so good man oh man I was in love I ate there 4 times during my trip. The food was so good. Everything was fresh made to order, the red beans and rice where to die for. The biscuit with honey oh boy was it good, especially when it was hot and fresh the honey butter was sweet and sticky. If I could I would be there right now."},{"business_id":"QIffr_fNUkbISage89uPYA","review_id":"ePLzARtJK9xJ8GCjN0md3w","date":"2022-01-10T14:58:15","stars":4,"text_representativeness":0.8863024115562439,"text_excerpt":"After a lot of drinking, yummy fried food it is! My boyfriend and I split a 4 piece box of chicken. It came with fries and a biscuit. All was delish! The chicken was crispy and yummy, fries had good seasoning and the biscuit was sweet. Definitely a good meal to soak up all the alcohol."}],"visual":[{"business_id":"QIffr_fNUkbISage89uPYA","photo_id":"yieyNSC3VIwRV0I0-eDsAA","label":"food","image_url":"/photos/yieyNSC3VIwRV0I0-eDsAA.jpg","visual_representativeness":1.0}]},"notebook_case":null}
