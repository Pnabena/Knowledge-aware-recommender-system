"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Vegan","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ukMy1_eFj5nKSZSPYd4LSA","review_id":"vdTEN-gzH42Pfb1LEuPlWQ","date":"2019-12-27T21:12:35","stars":5,"text_representativeness":0.9403416514396667,"text_excerpt":"First trip* So happy to have this place in our neighborhood. A bit hard to find at first glance, it located right next to community center. Small inside, but clean, bright and jamming to fun tunes. Friendly staff. The food- so yummy! The chickpea tuna salad was flavorful, and I really liked the dill dressing. For the \"crab\" Mac and cheese, they use heart of palm instead of crab and lots of other veggies cooked in too. Big Easy bowl was generous portion. And to top it off, bc of wait, they served us a free portion of their special- spinach and artichoke dip. It was awesome! Lots of spinach and I think the sauce was made with coconut. Yum! Went back for more* update! Now serving on normal p..."},{"business_id":"ukMy1_eFj5nKSZSPYd4LSA","review_id":"wfNYmKKp8GGeXL_N6_gcxQ","date":"2019-12-12T20:54:15","stars":5,"text_representativeness":0.9338886737823486,"text_excerpt":"Well I found this place browsing the internet, and i saw the website and menu and knew i had to try it. We went there and got the Oyster mushroom poboy in a wrap. My hubby tried the BBQ veggie burger. Everything we ordered was delicious. I also ordered the bread pudding. I am very happy with the service we received and the food. The staff was very friendly and welcoming and I will be back. I recommend this place for delicious vegan food."},{"business_id":"ukMy1_eFj5nKSZSPYd4LSA","review_id":"3Fe29Gg4LZzS4B2DQkaesQ","date":"2019-12-07T02:04:33","stars":5,"text_representativeness":0.903615415096283,"text_excerpt":"Love the food, space, and people who work here. This is some DAMN good vegan food! Even my husband, a carnivore, loves it. My only hope is that someday they'll have more gluten free options, as I am gf and vegan. But I totally cheat on their chickun and waffles!"}],"visual":[{"business_id":"ukMy1_eFj5nKSZSPYd4LSA","photo_id":"DFFYGWSXsI8-2_-hbXZJtw","label":"food","image_url":"/photos/DFFYGWSXsI8-2_-hbXZJtw.jpg","visual_representativeness":1.0}]},"notebook_case":null}
