,"rank_movement":35,"has_visual_feature":true,"name":"Amorino Gelato al Naturale","address":"637 Canal St","city":"New Orleans","state":"LA","postal_code":"70130","stars":3.5,"review_count":158,"categories":["Food","Desserts"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"GRx3ep-o6K05floY0eMAAg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":691,"mm_rank":656,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Desserts","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"GRx3ep-o6K05floY0eMAAg","review_id":"aTGIeF8--hp16NSb6f_b5w","date":"2019-06-08T05:46:27","stars":5,"text_representativeness":0.9290390610694885,"text_excerpt":"Probably one of the best gelato places in NOLA hands down! It's a small place, and parking can be quiet difficult as it is tucked in the corner of canal street. I had the crepe with the lychee ice cream and the pistachio ice cream topped with chocolate hazelnut and some whipped cream. I highly recommend getting the lychee ice cream as it really does taste like sweet lychee. The pistachio ice cream was a bit nutty for my taste but it was still good. The crepe dived in well with both ice cream flavors and it satisfied my cravings at the end of the night. I also love how this place closes late on the weekend as well as it's good to stop by if you are touristing around the city or near bourbo..."},{"business_id":"GRx3ep-o6K05floY0eMAAg","review_id":"UqIOdhiyLtN_qyi4hRmCdA","date":"2019-04-01T05:23:01","stars":5,"text_representativeness":0.9273554682731628,"text_excerpt":"Came here for a late night dessert. The place wasnt packed and it was clean. It was a weight time but i didnt mind because it gave me time to browse the menu. As i approached the counter, the cashier showed me how to order and gave me options. I got the classic cone with a macaroon. I liked that i could pick 3 flavors and they allowed you to try as many as you want. You can choose between gelato and sorbet. I chose chocolate, blueberry cheese cake, and a nutella flavored gelato. They made it into a flower which was nice. All the flavors where amazing and i got a vanilla macaroon. You dont get a lot of gelato in the cone but i guess your paying for the experience. All in all, i would come ..."},{"business_id":"GRx3ep-o6K05floY0eMAAg","review_id":"YMwwIHa6TyFABaZwJ723lA","date":"2018-12-14T01:15:49","stars":5,"text_representativeness":0.9249311685562134,"text_excerpt":"I've had a lot of gelato in my lifetime, but Amorino's are on a whole other level. Their flower presentation is the best part of the experience and perfect for the gram. I didn't get to try any of the flavors since they were quite busy on Thanksgiving, but I knew I couldn't go wrong with any of them. I got to choose 3 different flavors for my cone and I really liked how the flavors didn't overlap with one another and I got to taste them all seperately. I'm not too fond of their downtown location, but their gelato is the best around so I think I'll have to make an exception to stop by when I am in the area."}],"visual":[{"business_id":"GRx3ep-o6K05floY0eMAAg","photo_id":"rqYGTZdy-LXANG71CH9zYw","label":"drink","image_url":"/photos/rqYGTZdy-LXANG71CH9zYw.jpg","visual_representativeness":0.8952380418777466},{"business_id":"GRx3ep-o6K05floY0eMAAg","photo_id":"IMtVbDAm3sQfRnbsdTC76A","label":"food","image_url":"/photos/IMtVbDAm3sQfRnbsdTC76A.jpg","visual_representativeness":0.8627411723136902},{"business_id":"GRx3ep-o6K05floY0eMAAg","photo_id":"o0z-ibhfu4m_bAvPyx8sFQ","label":"food","image_url":"/photos/o0z-ibhfu4m_bAvPyx8sFQ.jpg","visual_representativeness":0.8526567220687866},{"business_id":"GRx3ep-o6K05floY0eMAAg","photo_id":"x7HKeBbq73MqtotwJ8ygNA","label":"inside","image_url":"/photos/x7HKeBbq73MqtotwJ8ygNA.jpg","visual_representativeness":0.8209528923034668},{"business_id":"GRx3ep-o6K05floY0eMAAg","photo_id":"JJItNekwy7bJuGfMO7Ac4g","label":"inside","image_url":"/photos/JJItNekwy7bJuGfMO7Ac4g.jpg","visual_representativeness":0.7037252187728882}]},"notebook_case":null}
