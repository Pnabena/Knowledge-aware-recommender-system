:"Bars","historical_business_count":5},{"category":"Steakhouses","historical_business_count":0},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Nightlife","historical_business_count":5}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Cajun/Creole, Nightlife, Restaurants","shared_category_count":4},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants, Southern","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants, Seafood","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","review_id":"Jamf34bW3kUb5PYVKruXfg","date":"2017-06-13T03:46:15","stars":4,"text_representativeness":0.9315298199653625,"text_excerpt":"I was a little apprehensive about eating here at first, only because it screams \"tourists\" but I was pleasantly surprised by my meal. The menu is everything you'd want when craving New Orleans fare. It's large and there's something for everyone. I had raw oysters and a soft shell crab salad. The raw oysters were clean, fresh, cold and gi-normous. My dining companion had the fried chicken (I did sneak a bite and it was delicious). The service was great (granted we were there on a Thursday for lunch so it wasn't that busy). I would absolutely return."},{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","review_id":"UDTt9S9n8fKVZIzzqKDQQw","date":"2019-05-11T02:51:33","stars":5,"text_representativeness":0.9284307956695557,"text_excerpt":"First time here and WOW! We ordered the Charbroiled Oysters..... Out of this world!! Also had the Jambalaya which was great! The service was top notch, our waiter Patrick was outstanding. Very attentive and great personality. This is a must do when in NOLA. We will definitely be coming back"},{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","review_id":"ra5lc1qCLLwryaNBtYbBQw","date":"2020-11-22T16:07:08","stars":5,"text_representativeness":0.9269964694976807,"text_excerpt":"Haven't been in a few months since Covid, this spot was originally my husband's favorite spot to go, I would just tag along because he loved it so much. But we finally decided to sit at the bar for the first time! And. Oh did we have fun and enjoy ourselves. I was never the oyster type, they were always nasty to me, but I had the southwest oysters made by Derrick totally changed my mind! I can't wait to go back and order my own platter."}],"visual":[{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","photo_id":"sCTuOTnuF0vzUzOlXrwz5A","label":"inside","image_url":"/photos/sCTuOTnuF0vzUzOlXrwz5A.jpg","visual_representativeness":0.8885635137557983},{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","photo_id":"KDzFwcMdhgc4x72yErv2PQ","label":"food","image_url":"/photos/KDzFwcMdhgc4x72yErv2PQ.jpg","visual_representativeness":0.8563411831855774},{"business_id":"FQJ4ph8e1SMz5YWsdH2m8Q","photo_id":"PWidMc7PVZGOwVXFGhCnXA","label":"inside","image_url":"/photos/PWidMc7PVZGOwVXF