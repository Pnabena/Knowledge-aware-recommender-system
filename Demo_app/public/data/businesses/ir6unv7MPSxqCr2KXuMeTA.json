354643821716,"rank_movement":343,"has_visual_feature":true,"name":"Faubourg Brewery","address":"3501 Jourdan Rd","city":"New Orleans","state":"LA","postal_code":"70126","stars":4.0,"review_count":35,"categories":["Food","Breweries"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"ir6unv7MPSxqCr2KXuMeTA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1488,"mm_rank":1145,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Breweries","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ir6unv7MPSxqCr2KXuMeTA","review_id":"-LY6744urQRybKuwJ8d8Ig","date":"2021-05-24T23:42:34","stars":5,"text_representativeness":0.9420446753501892,"text_excerpt":"I finally made it out to the faubourg brewery and am so happy I did! I will definitely be back. My family and I visited (kid and dog friendly!), listened to some great Cajun music, and had a very yummy dinner. Some enjoyed the beer, and we ordered crawfish, debris fries (which is an appetizer but huge), a muffuletta, and the fish tacos. Everything was delicious. I will definitely be back for the atmosphere and the food - Which is saying something that I'll be back to a brewery (I don't drink alcohol). Free concerts on the weekend outside on the lawn (check the website or Facebook for schedule). The lawn is huge - either reserve a table or bring your own chair. There are also outside games..."},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","review_id":"n30f3_C6vVTB1bFMUHqlDQ","date":"2021-02-11T10:18:50","stars":5,"text_representativeness":0.9201218485832214,"text_excerpt":"Went for the first time specifically to try their seasonal King Cake stout and it did not disappoint. Thank gawd for GPS directions as the last 1/2 mile spins you around turns and little streets until you land at your destination. The taproom is wide open and offers numerous selections of beers as well as packaged goods (got 40% off before they closed for Mardi Gras weekend too). The outdoor beer garden is expansive and a great spot to enjoy a brew outside. They seem to have a restaurant but believe it's only open on weekends and was not operating when I was there so can't share any insite on that. Oh and the bathrooms were immaculate."},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","review_id":"kThxEnD3ilaUlngrL_xNYg","date":"2020-02-07T21:12:21","stars":5,"text_representativeness":0.916100025177002,"text_excerpt":"An amazing place to eat and drink. We had a wonderful experience with Andrew and mary. They were knowledgeable and helpful. The experimental brews were awesome and deliciously different. Very unique experience. The beers were great and they had wonderful food. We had the cracklings and piemento cheese dip and great fried cheese curds with a pepper jelly. Omg good. Wonderful space not to be missed. They have wonderful outside space just right for beer drinking. Hard to find use Waze. Loved it."}],"visual":[{"business_id":"ir6unv7MPSxqCr2KXuMeTA","photo_id":"BXqWW4IwX5GzvKLmKQsVrw","label":"inside","image_url":"/photos/BXqWW4IwX5GzvKLmKQsVrw.jpg","visual_representativeness":0.9153015613555908},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","photo_id":"oF1UdgZ4gh4h6-9M1dbabA","label":"drink","image_url":"/photos/oF1UdgZ4gh4h6-9M1dbabA.jpg","visual_representativeness":0.8729283213615417},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","photo_id":"KbDmCYEqMn-9kDYJZ5tRyw","label":"outside","image_url":"/photos/KbDmCYEqMn-9kDYJZ5tRyw.jpg","visual_representativeness":0.8231328725814819},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","photo_id":"Vyw00QACpIqvXVfDSi9C3A","label":"outside","image_url":"/photos/Vyw00QACpIqvXVfDSi9C3A.jpg","visual_representativeness":0.795762300491333},{"business_id":"ir6unv7MPSxqCr2KXuMeTA","photo_id":"vLJwnBpiZklPQjUxNHcY5A","label":"outside","image_url":"/photos/vLJwnBpiZklPQjUxNHcY5A.jpg","visual_representativeness":0.7861663103103638}]},"notebook_case":null}
