1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","review_id":"HYDtvPFt6CjWDZZfYsxrhQ","date":"2018-05-24T00:56:10","stars":4,"text_representativeness":0.9503713250160217,"text_excerpt":"I loved this place! Got two burgers (the Fharmacy burger and the all american)to go and the burgers were nice and juicy! The employees were really nice as well I was visiting from out of town and they recommended some places for us to check out while we waited was super nice! Any trip to NOLA i definitely will have this on my list of places to eat. Fries were cool nothing super special about them (got Cajun fries) could have used more seasoning but I went for the burger and I was very happy with it!"},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","review_id":"_mWvDCbZV-2YEiMCzYdAKg","date":"2017-02-11T13:50:29","stars":5,"text_representativeness":0.9478166103363037,"text_excerpt":"Delicious burgers! Wow! I was in the mood for something casual and quick and came across Fharmacy Nola on Yelp. I am glad we stopped in because we had some of the best burgers we have experienced here in NOLA. I had the Cali burger and my husband had the Dr. Tan burger. Both were huge, delicious, and served with a generous amount of fries. The service was quick, as far as getting drinks and ordering. It took a while to get the food, but it was worth the wait. Plus, while we were waiting our server kept checking in with water and drink refills. Beyond all of the that, the space is really cool and laid back. I loved the 80's music that was playing. It wasn't too crowded, but it was early on..."},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","review_id":"5CMrXSHZPwFAQDYb9CcO6g","date":"2018-03-11T17:26:31","stars":5,"text_representativeness":0.9470693469047546,"text_excerpt":"First time visiting last week and was extremely impressed. I don't usually give out five stars but Fharmacy definitely deserves it. My bf and I ordered the: Meat Pies Wings (Jerk and Buffalo) three of each Mussels + Frites Build your own burger Obviously too much food but wanted to sample a lot. It was Mussels Monday so they had a special going on for the Mussels and Frites. HUGE BOWL. Totally worth it and I'll be back just for this (Three different kinds of flavors but I would suggest Asian everytime). They do not skimp here. We had to call in a friend to come help us eat halfway through the meal so he could help put it down. Burger was awesome. Probably my top three burgers I've ever ha..."}],"visual":[{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","photo_id":"_e1fOiiWWdA4ovCwQXnePg","label":"outside","image_url":"/photos/_e1fOiiWWdA4ovCwQXnePg.jpg","visual_representativeness":0.8489606380462646},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","photo_id":"mvOYqSxZ-nU4eKPjih7oQQ","label":"inside","image_url":"/photos/mvOYqSxZ-nU4eKPjih7oQQ.jpg","visual_representativeness":0.839590847492218},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","photo_id":"q3_j881dmbOtoEfnpRlknA","label":"inside","image_url":"/photos/q3_j881dmbOtoEfnpRlknA.jpg","visual_representativeness":0.827908992767334},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","photo_id":"GF_m_9wBdChv2JS8hf8rIw","label":"food","image_url":"/photos/GF_m_9wBdChv2JS8hf8rIw.jpg","visual_representativeness":0.8254597187042236},{"business_id":"EmJF-xSIOaEEOWcK8UOBqg","photo_id":"PN94tyJC0ibq2S9VtUl_Ig","label":"food","image_url":"/photos/PN94tyJC0ibq2S9VtUl_Ig.jpg","visual_representativeness":0.8061643838882446}]},"notebook_case":null}
