ame":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"ftV6GGm1dB47vj3nf-UeIg","review_id":"09opoML1bITxXUgSS5_h2Q","date":"2020-08-16T01:29:17","stars":4,"text_representativeness":0.9216219782829285,"text_excerpt":"Located in Pythian Market! The food was really good. I tried the El Pabellon Arepas. The flavors were great but I found it very heavy. I could only finish one! The beef in both dishes was nice and tender. I gave it 4 stars because I thought the service could have been a little friendlier."},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","review_id":"G3pzVkek09gq54Altr-8mg","date":"2020-01-08T01:21:24","stars":5,"text_representativeness":0.9200679063796997,"text_excerpt":"This was a fantastic find! We hit up the Pythian Market close to our hotel and this food hall didn't disappoint. La Cocinita is right in the center of the food hall. My husband got the pulled pork tacos (right of photo) and they were delicious! Fresh and bright veggies and wonderful flavor. I got the El Pabellon Arepas and they were just mouthwatering. The sweetness of the plantains matched perfectly with the savory beef. Amazing filling meal for a super affordable price. A must try!"},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","review_id":"lygBHvSNZwtxyf_YGq8dfg","date":"2019-01-24T01:54:25","stars":5,"text_representativeness":0.9184834957122803,"text_excerpt":"Updating my review. Went to Pythian Market couple of Mondays ago and it was exactly opposite to what I have experienced last time. Food came out perfect as I requested, the manager mister (I assumed...) came over to ask me if everything was alright and YES tacos were amazing! La cocinita just got another big fan!"}],"visual":[{"business_id":"ftV6GGm1dB47vj3nf-UeIg","photo_id":"kmVk4umARk66miPCO51qkA","label":"inside","image_url":"/photos/kmVk4umARk66miPCO51qkA.jpg","visual_representativeness":0.906777024269104},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","photo_id":"QgUYxB73gBqNge96Vs605A","label":"food","image_url":"/photos/QgUYxB73gBqNge96Vs605A.jpg","visual_representativeness":0.8351845741271973},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","photo_id":"bJ63uRZgzEJKkU26BycbHw","label":"food","image_url":"/photos/bJ63uRZgzEJKkU26BycbHw.jpg","visual_representativeness":0.7926093339920044},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","photo_id":"B7cnaGSc1F_QvMewNn-ODw","label":"food","image_url":"/photos/B7cnaGSc1F_QvMewNn-ODw.jpg","visual_representativeness":0.7840040326118469},{"business_id":"ftV6GGm1dB47vj3nf-UeIg","photo_id":"z0O6Te5iGfR2zyom9msTLg","label":"food","image_url":"/photos/z0O6Te5iGfR2zyom9msTLg.jpg","visual_representativeness":0.7157679200172424}]},"notebook_case":null}
