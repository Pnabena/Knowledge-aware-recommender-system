g":{"user_row":3279,"user_id":"D76EFdD5F7XoIIyQmWTQhA","business_row":660,"business_id":"G2W56pUxgJs7UzGcSL0EdQ","nv_rank":2424,"mm_rank":1781,"nv_score":-0.7782000303268433,"mm_score":-0.6407036781311035,"rank_movement":643,"has_visual_feature":true,"name":"Vue","address":"1600 Canal St","city":"New Orleans","state":"LA","postal_code":"70112","stars":4.0,"review_count":10,"categories":["Lounges","Cocktail Bars","Nightlife","Bars"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2424,"mm_rank":1781,"target_category_support_fraction":0.75,"selected_image_count":3,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Lounges","historical_business_count":0},{"category":"Cocktail Bars","historical_business_count":2},{"category":"Nightlife","historical_business_count":5},{"category":"Bars","historical_business_count":5}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Nightlife","shared_category_count":3},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Bars, Cocktail Bars, Nightlife","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","review_id":"2FGzNyHAVQmsPAKyGNYpeA","date":"2018-10-14T22:38:42","stars":4,"text_representativeness":0.9494895339012146,"text_excerpt":"Stopped by on a Friday night and was surprised to find there was a DJ who played tunes from the 2000s-present. I had heard that Vue was a quieter place to grab drinks, but it turned out to be pretty poppin'! Great views and friendly/attentive staff who walk around to ensure you have a drink in your hand if you need it. The seats were all super wet when I went, even though I didn't think it rained earlier on in the day? But it's a very cute setting with a beautiful view of Canal St. I had the NOLA, NOLA cocktail ($12), which was just alright and came in a small plastic cup."},{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","review_id":"0sl745VrsXUlmb2NbHcUEg","date":"2018-11-27T07:48:52","stars":5,"text_representativeness":0.9483783841133118,"text_excerpt":"After checking around, I heard this was the best rooftop in New Orleans. So I gave it a try. Definitely a great experience and very cheap happy hour drink specials. Decently spacious lounge vibe, live DJ, and even small bits."},{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","review_id":"lNrc6zFJQpv_4400krKLgQ","date":"2018-03-19T21:24:34","stars":4,"text_representativeness":0.9476062655448914,"text_excerpt":"Visited this rooftop bar for a private party. Parking is terrible, but everyone knows that going anywhere around downtown NOLA. I also had no idea one needed a room key to go to this floor. Thank goodness the front door guy asked if we needed assistance since we looked confused. Could have more of a selection of alcoholic beverages, but... it's still new. It's also a bit off the beaten path, but the view is really nice. Comfortable seating areas with trendy furnishings. If you have a hot date or a good group to have fun with, it's a very cool place. I'm sure this will be a new hot spot. Who doesn't like a snazzy little rooftop bar? I'll definitely be back to have another great night."}],"visual":[{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","photo_id":"igFnCHB153Ip8WyjmoXApw","label":"drink","image_url":"/photos/igFnCHB153Ip8WyjmoXApw.jpg","visual_representativeness":0.8721789121627808},{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","photo_id":"8Xe7vJbeKPmwmplsFaM1Tg","label":"outside","image_url":"/photos/8Xe7vJbeKPmwmplsFaM1Tg.jpg","visual_representativeness":0.7407675981521606},{"business_id":"G2W56pUxgJs7UzGcSL0EdQ","photo_id":"i5XigbjEo8gsquVrOGiZBQ","label":"outside","image_url":"/photos/i5XigbjEo8gsquVrOGiZBQ.jpg","visual_representativeness":0.7281590104103088}]},"notebook_case":null}
