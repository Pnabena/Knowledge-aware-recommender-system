.5,"review_count":100,"categories":["Food Stands","Ice Cream & Frozen Yogurt","Shaved Ice","Food","Restaurants","Local Flavor"],"is_open":false},"evidence":{"source":"frozen-model","summary":{"business_id":"usDBroDL-Fns6qfNTUBjJg","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":2256,"mm_rank":1780,"target_category_support_fraction":0.3333333333333333,"selected_image_count":1,"label_diversity":1,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food Stands","historical_business_count":0},{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Shaved Ice","historical_business_count":0},{"category":"Food","historical_business_count":3},{"category":"Restaurants","historical_business_count":8},{"category":"Local Flavor","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"usDBroDL-Fns6qfNTUBjJg","review_id":"z4yrOKjpszhWlZdLRNhHvA","date":"2017-08-22T22:57:48","stars":5,"text_representativeness":0.9097343683242798,"text_excerpt":"so f'ing delicious. Tip: horchata sno-ball with condensed milk topping. it will change your world! sno-balls are definitely much more rich and creamier than normal shaved ice. I was skeptical at first, before I had one, but after tasting it I was in love. I highly recommend this place to anyone in the area :)"},{"business_id":"usDBroDL-Fns6qfNTUBjJg","review_id":"0SmvTKMgUc6e-F6-NU139A","date":"2015-03-20T16:50:27","stars":4,"text_representativeness":0.9024849534034729,"text_excerpt":"The ice is similar to Hansen's. Really good. Lots of good flavors and some experimental ones. It's the kind of snoball you eat, no so much drink. If you're looking for more juice/syrup, let it sit for 15 minutes before you dive in. It's a little on the pricey side for a snoball... I paid $5 for a medium but I did have cream flavors so... They were also out of my favorite flavor."},{"business_id":"usDBroDL-Fns6qfNTUBjJg","review_id":"EfgW9DuatyicHXarvLbNPA","date":"2016-07-27T23:21:00","stars":4,"text_representativeness":0.8996824026107788,"text_excerpt":"Found the little trailer down at the Riverfront, and there was a huge line (there is a separate line for ordering, and a separate line to pick up your order, don't confuse those lines!). I ordered the Pineapple flavor ($4 for a 12oz). Totally worth it, as the snoball didn't feel like a sad blob of ice in a cup, but more like a yummy creamy blob of ice, with pineapple flavor! Perfect for cooling down in the HOT weather. They only take cash (or at least only did on the day I went there), so bring cash!"}],"visual":[{"business_id":"usDBroDL-Fns6qfNTUBjJg","photo_id":"atRRszFI2I4ZwlI2tQ0Lwg","label":"inside","image_url":"/photos/atRRszFI2I4ZwlI2tQ0Lwg.jpg","visual_representativeness":1.0}]},"notebook_case":null}
