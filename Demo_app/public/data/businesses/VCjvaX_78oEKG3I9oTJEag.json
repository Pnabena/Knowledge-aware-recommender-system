rical_business_count":8},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"VCjvaX_78oEKG3I9oTJEag","review_id":"Spd0oTcdKUbHBmNDCEymkA","date":"2012-03-08T17:38:48","stars":4,"text_representativeness":0.9329037666320801,"text_excerpt":"Very cool coffee house with a friendly and knowledgeable staff. Also, a great assortment of teas! Not only that, but the tea is on display and you can smell them (meaning they're not in pre-packaged teabags - you can examine the tea leaves!) I came here with a friend visiting from out of town just to have a conversation. This seems to be a great place for that. The inside of the place is a bit small and I saw a lot of people reading or working on their laptops inside, so I don't know if it's the ideal place for a conversation. But happily, there's also a courtyard outside to accommodate more folks and those of us wanting to have conversations. Also got a cookie, which was good. I don't ma..."},{"business_id":"VCjvaX_78oEKG3I9oTJEag","review_id":"oR-SvDnOgC9ViDjSR4CPrQ","date":"2010-09-22T06:14:55","stars":5,"text_representativeness":0.9289785623550415,"text_excerpt":"At first, I wasn't a huge fan of Fair Grinds, perhaps because it always seemed to be overly crowded, kind of noisy, and whatever coffee drink I ordered wasn't what I was looking for. My first impression, however, was way off. This is actually a pretty awesome little coffee shop. After finding myself compelled to come back for meetings and so forth, Fair Grinds started to grow on me. The day I discovered their citron green tea (it tastes like Pez!) is the day I decided this is one of my favorite local coffee shops. Inside, they've got large, colorful tables that are really close together and therefore somewhat difficult to navigate at times. There's also a courtyard/alleyway space for thos..."},{"business_id":"VCjvaX_78oEKG3I9oTJEag","review_id":"DT2Llr9Zvt6tvx0Hnbl02w","date":"2014-05-20T20:10:59","stars":4,"text_representativeness":0.9254558086395264,"text_excerpt":"Big fan. Super hot good coffee served quickly. I like the place even more so because it has tons of out door seating. A little bit out front, more on the side and then a deck patio up top. Very awesome. Cool atmoshphere and in my favorite neighborhood in the city. I'd go back in a heartbeat (if the weather is nice)."}],"visual":[{"business_id":"VCjvaX_78oEKG3I9oTJEag","photo_id":"DemtJnosaMnwc_sI8-zzqw","label":"inside","image_url":"/photos/DemtJnosaMnwc_sI8-zzqw.jpg","visual_representativeness":1.0}]},"notebook_case":null}
