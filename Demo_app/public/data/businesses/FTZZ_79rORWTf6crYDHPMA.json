11,"mm_score":-0.4161878824234009,"rank_movement":464,"has_visual_feature":true,"name":"Bellegarde Bakery","address":"8300 Apple St","city":"New Orleans","state":"LA","postal_code":"70118","stars":5.0,"review_count":18,"categories":["Food","Bakeries"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"FTZZ_79rORWTf6crYDHPMA","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1624,"mm_rank":1160,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":4,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Food","historical_business_count":3},{"category":"Bakeries","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"FTZZ_79rORWTf6crYDHPMA","review_id":"g0c9Y2-Z7HLfHY76SG-Pxw","date":"2021-04-11T16:36:59","stars":5,"text_representativeness":0.9467481374740601,"text_excerpt":"There are a lot of bakeries in NOLA making good bread and pastries but how many can say that their's is also good for you? That's what I love about Bellegarde not only are they making the best French bread in the city and some delicious pastries but their stuff is good for you. They only use stones milled grains and therefore offer baked goods and pastas that are nutritiously good for you. Their croissants and seasonal focaccia are tops and if you have a sweet tooth the Chocolate Pecan Bostock can't be beat! Note that they are now holding Pizza nights on Thursday and they make an excellent cheat meal ;-)"},{"business_id":"FTZZ_79rORWTf6crYDHPMA","review_id":"9pYmlTvOyO0g0i11l5kKXA","date":"2015-11-11T17:33:58","stars":4,"text_representativeness":0.9373331665992737,"text_excerpt":"You can't go wrong with fresh crusty bread. I love all the options we have in New Orleans now and Bellegarde is one of the best."},{"business_id":"FTZZ_79rORWTf6crYDHPMA","review_id":"kleg8CGATIoTbKaj5dL0Uw","date":"2017-01-25T15:58:02","stars":4,"text_representativeness":0.9144645929336548,"text_excerpt":"This bakery puts out very hearty loaves made with as much locally sourced grain as possible and in fact the owner is leading a movement to establish more local sources for grains. Personally I am not a fan of white bread and like my bread dark and full of whole grains and the Bellegarde breads certainly deliver in the hearty strong category and blow the weak white bread options away. The bread is so hearty and many varieties so chewy I find them not always the best suited for sandwiches and some varieties are better used in other applications or just stand well on their own. My favorite Bellegarde bread so far is the Country Rye."}],"visual":[{"business_id":"FTZZ_79rORWTf6crYDHPMA","photo_id":"tFH6p15woJmj9mxH8h-z7g","label":"menu","image_url":"/photos/tFH6p15woJmj9mxH8h-z7g.j