_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Breakfast & Brunch","historical_business_count":1},{"category":"Restaurants","historical_business_count":8},{"category":"American (Traditional)","historical_business_count":2},{"category":"Sandwiches","historical_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Breakfast & Brunch, Restaurants","shared_category_count":3},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"I6h5LoGq2vSC1M-WGWF0Kw","review_id":"nR7foJPQM4cJNlzh1czLlQ","date":"2013-07-17T03:05:01","stars":4,"text_representativeness":0.9280678629875183,"text_excerpt":"Just tried this place for the first time today and really liked it. The server was very attentive and friendly, the loaded grilled cheese sandwich (including pecan smoked bacon) was delicious and so was the strawberry lemonade. My husband let me try some of his Reuben omelet and that was very good as well. Before leaving, I asked whether they had wi-fi. They do, so I foresee more visits there. I wish they didn't close at 4.00, though."},{"business_id":"I6h5LoGq2vSC1M-WGWF0Kw","review_id":"foVdbge-VG2DASdKXtT4QA","date":"2014-05-20T03:35:55","stars":4,"text_representativeness":0.9248865842819214,"text_excerpt":"Now this is a great lunch spot. Jims offers a limited menu of great sandwiches and salads made fresh with fresh sourdough bread that is off the charts. The one knock I have about Jims is that you have to pay extra for a side item but the salads and sandwiches are so filling you really don't need a side. The omelets look crazy good too. Another go to spot in the Bywater/Marigny area."},{"business_id":"I6h5LoGq2vSC1M-WGWF0Kw","review_id":"HB1bOrSCOBCrMwjLVig83A","date":"2012-03-24T19:39:55","stars":5,"text_representativeness":0.9239251613616943,"text_excerpt":"Super cute Bywater cafe opened this week. It's got a really nice vibe in the place. It's got your favorite traditional sandwiches and salads. Love the bread, and great fries! Brand new so has big sandwiches! I hear the Reuben is awesome, I really like the Italian. They also have imported bratwurst!! ALL the way from Wisconsin- simmered in beer and grilled- the right way! I hear they made add breakfast, but for now it's a great Lunch spot."}],"visual":[]},"notebook_case":null}
