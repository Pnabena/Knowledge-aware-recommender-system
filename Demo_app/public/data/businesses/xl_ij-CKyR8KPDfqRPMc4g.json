l_rank_effect":null},"category_overlap":[{"category":"Ice Cream & Frozen Yogurt","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"xl_ij-CKyR8KPDfqRPMc4g","review_id":"vycQEdrHT1kuNkD1nf2KLg","date":"2015-10-10T03:00:22","stars":4,"text_representativeness":0.9201323986053467,"text_excerpt":"Went to SnoWizard while walking down Magazine Street. There was no line and the worker was very friendly. I've tried a few flavors and have no complaints, the snoballs are in super cute containers. Cash only, they don't take cards!"},{"business_id":"xl_ij-CKyR8KPDfqRPMc4g","review_id":"f296wZZw4zxXv8k6xtafEQ","date":"2010-09-25T19:57:15","stars":5,"text_representativeness":0.9082785844802856,"text_excerpt":"I don't care what anyone else says, these were definitely the best Snoballs I had in New Orleans while I was there. Giant containers of finely shaved ice with a ginormous list of flavors that you can combine (if you want) for super cheap. Conveniently located on Magazine without having to venture out to the middle of nowhere for the spot everyone says you should go to that isn't any better. This place really hits the spot when you've been melting in the heat while cruising Magazine St. Do yourself a flavor and stop by here and get one. Make sure you have some cash on you though."},{"business_id":"xl_ij-CKyR8KPDfqRPMc4g","review_id":"HGiM5xQ_PlslJyAvQIXPzw","date":"2010-09-15T02:14:16","stars":4,"text_representativeness":0.8928452134132385,"text_excerpt":"I'm no snoball expert, but I do know a thing or two about shaved ice and syrup in combination, and this place pretty much got it right. The ice is \"wetter\" than the other two places I've tried (Beaucoup and Plum St.) but that's not a bad thing. They have a few sugar-free flavors, I had the pink lemonade and it didn't taste \"fake\" at all. Or maybe I drink far too much Diet Coke. YMMV. As others have said, there's no place to sit except a few plastic chairs out front, just a big building and a parking lot. Hence it's a \"stand\". Grab one and take a walk around Magazine."}],"visual":[{"business_id":"xl_ij-CKyR8KPDfqRPMc4g","photo_id":"Ss7loD_xmEHdQo0xcuy_KA","label":"food","image_url":"/photos/Ss7loD_xmEHdQo0xcuy_KA.jpg","visual_representativeness":0.9447696208953857},{"business_id":"xl_ij-CKyR8KPDfqRPMc4g","photo_id":"lYgu9hOXzmtxHtrSLjdPUg","label":"food","image_url":"/photos/lYgu9hOXzmtxHtrSLjdPUg.jpg","visual_representativeness":0.944769561290741}]},"notebook_case":null}
