ry":"French","historical_business_count":2},{"category":"Cajun/Creole","historical_business_count":4},{"category":"Southern","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (New), Bars, Breakfast & Brunch, Cajun/Creole, French, Nightlife, Restaurants","shared_category_count":7},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, French, Nightlife, Restaurants, Southern","shared_category_count":5},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Bars, Food, Nightlife, Restaurants","shared_category_count":4},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants, Southern","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"American (New), Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","review_id":"0pKAr6F55mcHrsrmhZAXlA","date":"2018-03-06T20:33:19","stars":4,"text_representativeness":0.9490008354187012,"text_excerpt":"Dined here with my girlfriend on a Sunday evening during a recent visit to New Orleans. The space had wonderful ambiance while also exuding a \"neighborhood\" restaurant feel due to its location on a relatively quiet section of Magazine Street - seemingly suitable for both a romantic date night or a more casual get together with friends. We (of course) ordered the blue crab beignets which very much lived up to the hype. Perhaps I'm biased because I love blue crab, but they were lightly fried and did not feel as heavy as one might anticipate. In addition, we shared the apple and celeriac salad, a nice change from the generally heavy food of New Orleans dining, and the LPG cheeseburger, which..."},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","review_id":"osjsDo127v6o-WvljyFskg","date":"2011-08-24T23:59:50","stars":5,"text_representativeness":0.9465527534484863,"text_excerpt":"I went to this place a few weeks ago, but I'm only writing a review now, because I was trying to figure out how to put it's greatness into words. I had only heard of this place in passing when a friend of mine and I decided to check it out. I was immediately impressed as soon as I walked into the door. We were there for an early dinner on a weeknight, so it wasn't crowded. There was a guitarist playing light background music in the dining room, which just made it an even more lovely experience. As soon as we sat down, the waitress was extremely helpful about everything from wine selection to which dishes she recommended. We started with an appetizer of blue crab beignets, which were amazi..."},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","review_id":"3qeq9iRDvwj-772JheNDeA","date":"2010-02-13T06:56:59","stars":5,"text_representativeness":0.9430273771286011,"text_excerpt":"BLUE CRAB BEIGNET. Provoked an involuntary noise. It's part of the Gulf Fish entree and it was so good, along with everything else ordered that night. This is definitely becoming a new must place for friends in town, special occasions, etc. One of my big beefs with the NOLA food scene, as great as it is, is how it is so skewed towards super expensive places you have to get dressed up for or else down home comfort food places with a big gaping hole in between. This place is a great in between - really beautiful dining area, white tablecloths, but still casual and approachable. Everything tasted great. The apple and celery salad was inventive and delicious, the gulf fish as mentioned, as we..."}],"visual":[{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","photo_id":"ib_kApWNAdT7UjUifiCglQ","label":"drink","image_url":"/photos/ib_kApWNAdT7UjUifiCglQ.jpg","visual_representativeness":0.896216869354248},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","photo_id":"LUe1b3QMZVf6K8ryYHD-iA","label":"inside","image_url":"/photos/LUe1b3QMZVf6K8ryYHD-iA.jpg","visual_representativeness":0.8741042613983154},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","photo_id":"aA8TzWu4ZRb-zPL1D4TUXg","label":"outside","image_url":"/photos/aA8TzWu4ZRb-zPL1D4TUXg.jpg","visual_representativeness":0.8465099334716797},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","photo_id":"6B48rgsC-f2CE6wG-_HbFw","label":"food","image_url":"/photos/6B48rgsC-f2CE6wG-_HbFw.jpg","visual_representativeness":0.837300181388855},{"business_id":"H5KRna9A6mDQEJ2ZN0zL6g","photo_id":"y5Dik-lMyHfa_wqaeuv_CQ","label":"inside","image_url":"/photos/y5Dik-lMyHfa_wqaeuv_CQ.jpg","visual_representativeness":0.8182681798934937}]},"notebook_case":null}
