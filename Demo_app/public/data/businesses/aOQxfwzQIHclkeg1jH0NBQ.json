business_count":0},{"category":"Drive-Thru Bars","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Cocktail Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cocktail Bars, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Food, Nightlife, Restaurants","shared_category_count":5},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1}],"text":[{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","review_id":"wJLvkmnOUIWxOR2C-A86Ug","date":"2018-05-30T22:03:57","stars":5,"text_representativeness":0.9302898049354553,"text_excerpt":"Yum! Very refreshing especially when The French Market can and WILL get mighty humid. The Organic Banana is pretty easy to find. It'll be closer to the front entrance (not right by the front but it'll be on the right hand side where all the food stands are located). You can't miss it. There's always a line forming. There are alcoholic and non-alcoholic drinks available. Besides the usual slushy, smoothie drinks...they offer beer on tap also. I ordered the Tropical Smoothie (pineapple and coconut) and my boyfriend got an Andy Gator beer."},{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","review_id":"ekwxCllYPtP4qjUafS9R5A","date":"2014-03-12T20:40:31","stars":5,"text_representativeness":0.9242628216743469,"text_excerpt":"The pina colada is so good here! This is a great place to grab a cold drink on a hot day (or even a cold day, as I have been wont to do at times). Just the right amount of spike to give you a nice buzz without debilitating you for the rest of the day. That particular piece of advice may be taken with a grain of salt; I do have a New Orleans-trained liver now. They use fresh fruit in their smoothies and as garnishes which is probably my favorite part. A little piece of pineapple and suddenly this alcoholic beverage I'm consuming at 10am is a fruit salad! I always make a point to stop by here when I'm in the Quarter because it's unlike anything else I get at a bar and totally worth the pric..."},{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","review_id":"cttmeVcdbe9iZ_opwU48Lg","date":"2020-01-02T01:29:09","stars":4,"text_representativeness":0.9147656559944153,"text_excerpt":"Located in French Market, they have good non-alcoholic beverages too! Tried their tropical smoothie and I wouldn't hesitate to get another."}],"visual":[{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","photo_id":"w4w52PrtL8QqpdjBZ-AYgw","label":"inside","image_url":"/photos/w4w52PrtL8QqpdjBZ-AYgw.jpg","visual_representativeness":0.9077298641204834},{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","photo_id":"zNWF8dPc-6ut-Fiv9VhFAw","label":"outside","image_url":"/photos/zNWF8dPc-6ut-Fiv9VhFAw.jpg","visual_representativeness":0.8675696849822998},{"business_id":"aOQxfwzQIHclkeg1jH0NBQ","photo_id":"DAcmMCkjwvLlKHxs7zoCPw","label":"drink","image_url":"/photos/DAcmMCkjwvLlKHxs7zoCPw.jpg","visual_representativ