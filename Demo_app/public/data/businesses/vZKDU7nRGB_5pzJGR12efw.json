business_row":2326,"business_id":"vZKDU7nRGB_5pzJGR12efw","nv_rank":1577,"mm_rank":1288,"nv_score":-0.6564181447029114,"mm_score":-0.474778950214386,"rank_movement":289,"has_visual_feature":true,"name":"French Truck Coffee","address":"650 Poydras St","city":"New Orleans","state":"LA","postal_code":"70130","stars":4.5,"review_count":46,"categories":["Coffee & Tea","Restaurants","Food","Cafes"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"vZKDU7nRGB_5pzJGR12efw","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":1577,"mm_rank":1288,"target_category_support_fraction":0.75,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Coffee & Tea","historical_business_count":1},{"category":"Restaurants","historical_business_count":8},{"category":"Food","historical_business_count":3},{"category":"Cafes","historical_business_count":0}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"vZKDU7nRGB_5pzJGR12efw","review_id":"QD_GzOpFCpM4_S-m-eWTmA","date":"2019-08-28T17:02:06","stars":4,"text_representativeness":0.932844877243042,"text_excerpt":"I've been to a different location before for coffee and it was delicious, but I wanted to try the food. I got a grilled cheese sandwich. It was Brie, cheddar, and a seasonal fruit compote (which was a delicious add). The bread was good, but weird to have it crust free - felt childish - and I like crust!! But it was delicious. I also got a cappuccino with oat milk. It wasn't the best cappuccino I've ever had, but it hit the spot. They have oat milk and almond milk, which is fantastic. This location is so beautiful with the huge windows and all the plants. The staff was friendly and at the end when I wasn't sure where I was supposed to bring my dish (it's on the other side of the counter if..."},{"business_id":"vZKDU7nRGB_5pzJGR12efw","review_id":"b-wO55vwUhfoEKU7cn6TAA","date":"2019-04-09T16:03:31","stars":5,"text_representativeness":0.9194278717041016,"text_excerpt":"LOVE THE NEW LOCATION OF FRENCH TRUCK! So happy to have a new location of French Truck close to work! While my bank account definitely hates me, I couldn't be happier to have an amazing coffee place just a few blocks away! You really can't go wrong with the coffee at french truck - my personal favorite is the New Orleans iced coffee but I've tried the cortado, lattes, pour overs, etc. and they are all very good! My only issue with French truck is that they only have 2 choices of milk - whole milk and coconut almond milk. I've learned to push past it for the good of a delicious cup of coffee but would love another option please! (maybe 2%). I usually will go with the coconut almond milk bu..."},{"business_id":"vZKDU7nRGB_5pzJGR12efw","review_id":"RYTI9HoiDqjRUsQiHYyenQ","date":"2020-01-08T03:04:10","stars":5,"text_representativeness":0.9119973182678223,"text_excerpt":"This location is probably my fav. High ceilings with equally high windows letting in tons of natural light. There's also a small patio out front. Cafe au lait was awesome as usual and service was delightful. Lots of seating at the front and in the back past the washrooms. I miss their coffee already."}],"visual":[{"business_id":"vZKDU7nRGB_5pzJGR12efw","photo_id":"8FoYF9DdgZVIJAGOInjy2w","label":"outside","image_url":"/photos/8FoYF9DdgZVIJAGOInjy2w.jpg","visual_representativeness":0.8730441927909851},{"business_id":"vZKDU7nRGB_5pzJGR12efw","photo_id":"7M_7ETGU0zx82ALpTB6E3w","label":"inside","image_url":"/photos/7M_7ETGU0zx82ALpTB6E3w.jpg","visual_representativeness":0.8420749306678772},{"business_id":"vZKDU7nRGB_5pzJGR12efw","photo_id":"aOmEyWWvqTpd4A1IaEG54g","label":"food","image_url":"/photos/aOmEyWWvqTpd4A1IaEG54g.jpg","visual_representativeness":0.8134782910346985},{"business_id":"vZKDU7nRGB_5pzJGR12efw","photo_id":"FxCQYjJdAvv8pqfxclLYBQ","label":"inside","image_url":"/photos/FxCQYjJdAvv8pqfxclLYBQ.jpg","visual_representativeness":0.8065464496612549},{"business_id":"vZKDU7nRGB_5pzJGR12efw","photo_id":"NsUB9DKV2qCGmplVSpwuyw","label":"inside","image_url":"/photos/NsUB9DKV2qCGmplVSpwuyw.jpg","visual_representativeness":0.7448728680610657}]},"notebook_case":null}
