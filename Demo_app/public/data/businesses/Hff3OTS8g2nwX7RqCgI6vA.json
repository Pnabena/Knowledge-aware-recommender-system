_business_count":0},{"category":"Candy Stores","historical_business_count":0},{"category":"Bakeries","historical_business_count":0}],"history":[{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"Hff3OTS8g2nwX7RqCgI6vA","review_id":"NUSfmO3xfwAO01obvq7wgg","date":"2021-02-18T16:48:47","stars":5,"text_representativeness":0.9548372030258179,"text_excerpt":"Local, Black Owned Bakery in the Gentilly area. Glazed donuts were fresh and still a little warm. Not too sweet. Petit fours were delicious! Customer service was pleasant during my visit and even better when I called to place a cake order! The King cakes looked great and I have heard nothing but wonderful things about them! I'll be back to try some more wonderful sweets since this is my neighborhood bakery."},{"business_id":"Hff3OTS8g2nwX7RqCgI6vA","review_id":"ki2vHHxiBNqfS6Ot8wpvUA","date":"2019-07-28T17:53:44","stars":5,"text_representativeness":0.9451795220375061,"text_excerpt":"I absolutely love this bakery. My first taste if their goodness was a few days after Valentine's Day. I bought a tiny cake, almond flavored with poured icing. It was delicious...even days old. I've tried many of their baked goods since then and have loved them all. The folks I've treated to their goodies have been equally pleased. Favorites: donuts, pies, eclairs, king cake, petit fours, and, my personal favorite, white (almond-flavored) cake by the slice. Recently, I had them make my birthday cake. I was beyond pleased. They worked with me to give me just what I wanted: a cake that tasted like a giant petit four! It was beautiful and scrumptious. Please, please check them out."},{"business_id":"Hff3OTS8g2nwX7RqCgI6vA","review_id":"LfZpYD7hJRsYH6IAoWmz_w","date":"2019-04-25T20:03:58","stars":5,"text_representativeness":0.9346025586128235,"text_excerpt":"This is a hidden gem in the gentilly area! We happened upon this corner bakery and it did not disappoint. We bought a pound cake and donuts which were all fresh and so goooood! They have a nice area inside with high top seating, or you can get anything for takeout. My favorite is the blueberry glazed donut! However I think you'll see that everything is tasty in this little bakery. Also the lady who I see working is always so sweet and helpful! Nice bakery all around!"}],"visual":[{"business_id":"Hff3OTS8g2nwX7RqCgI6vA","photo_id":"fapIPX1mSPUhNiIakM2xRw","label":"food","image_url":"/photos/fapIPX1mSPUhNiIakM2xRw.jpg","visual_representativeness":1.0000001192092896}]},"notebook_case":null}
