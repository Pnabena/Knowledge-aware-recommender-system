k_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Food","historical_business_count":3},{"category":"Cajun/Creole","historical_business_count":4}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"2wyats5xMAB-f5bp1pQ8dQ","review_id":"-33NjlNDakh8P80eBFTnYw","date":"2014-07-15T20:03:42","stars":4,"text_representativeness":0.9435225129127502,"text_excerpt":"Attention everyone ever in all of the world: you can get VEGETARIAN cajun food in NOLA! I know, it's unbelievable but you can, scout's honor. I had the vegan red beans and rice which were soft and creamy and delicious. Albeit, not the best choice for the 100 degree day we were having but none the less, I was psyched. They were also offering vegetarian jambalaya too but the red beans and rice filled me up. My husband had the boudin and it's all he's been talking about for the last 3 days. It's a little counter right in the French Market so the ambiance is bare but the guy working was friendly as heck and we enjoyed chatting with him."},{"business_id":"2wyats5xMAB-f5bp1pQ8dQ","review_id":"5LA3R-MPYx8SdRVfpFSM-w","date":"2014-07-18T22:31:41","stars":5,"text_representativeness":0.9329661130905151,"text_excerpt":"You must stop by here in the French Market! If we would've found this place before our last day in New Orleans, we would have came back. My husband had the gator burger and I got the pulled pork po boy. My poy boy was seasoned so well, not drenched in sauce. There was a Cajun slaw on there as well. we ate at bar, and they gave us as many lemonade fefills as we wanted. This place is authentic and incredible!"},{"business_id":"2wyats5xMAB-f5bp1pQ8dQ","review_id":"wCabwhyPZxYo2j_N79dWyw","date":"2014-05-14T01:57:36","stars":5,"text_representativeness":0.9158201217651367,"text_excerpt":"YUM! Outstanding crawfish etouffee. Even better: catfish topped with crawfish etouffee! Surprisingly was some of our favorite foods of our trip!! Loved it and loved the owner! We enjoyed this so much we ate there twice."}],"visual":[]},"notebook_case":null}
