:0,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"American (Traditional)","historical_business_count":2},{"category":"Restaurants","historical_business_count":8},{"category":"Seafood","historical_business_count":2}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Restaurants","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"r4hLK7eQ3YPXdhuc5M2Prg","review_id":"0ZLUSig2h6ij7Pgo6NWkOg","date":"2010-01-04T23:44:30","stars":4,"text_representativeness":0.9070776104927063,"text_excerpt":"Back in the 80s (what's with me & the throwback memories today-maybe the new year has made me contemplative), my friends always wanted to go to O'Henry's for the frosty schooners of beer; as a non-beer drinker, I appreciated their full bar. The food is basic burgers, fried seafood, and plate meals and it fills a need since NOLA seriously lacks in diners. While I've never had a great meal here, I've never had a bad one either so points for that. Bonus, you can get a free steak on your birthday (with driver's license as proof, of course.)"},{"business_id":"r4hLK7eQ3YPXdhuc5M2Prg","review_id":"mT_1ZvZPWKaKrJvhVy1qng","date":"2015-06-17T03:18:11","stars":5,"text_representativeness":0.9070554375648499,"text_excerpt":"One of my favorite spots uptown. Great food-- I've been dozens of times and never tried anything that I didn't like. Great staff-- super friendly and genuinely cool people. Great happy hour!! $2 margaritas/$6 burgers on Tuesdays, every other day they've got really good margs (all different flavors-- my fav is Blackberry Moonshine) for $4 or $5. If you haven't been already, I highly recommend it!!"},{"business_id":"r4hLK7eQ3YPXdhuc5M2Prg","review_id":"NguS6T-npaNlW-bHKIAD_w","date":"2008-07-23T03:35:56","stars":4,"text_representativeness":0.905811607837677,"text_excerpt":"great place for when you want american food and camellia grill next door has a huge line. i would always get the chicken fingers but get them to coat it in hot buffalo sauce. soooooo good. according to my husband, the burgers are good. i don't eat red meat. the servers are usually pretty chill, but don't expect amazing service. not particularly cheap, but pretty dependable and convenient. and open late on weekends! (til 2am)"}],"visual":[]},"notebook_case":null}
