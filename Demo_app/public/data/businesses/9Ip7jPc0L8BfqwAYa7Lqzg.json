7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"9Ip7jPc0L8BfqwAYa7Lqzg","review_id":"wEIBxW95xpB5PcPF2KwZFw","date":"2019-03-24T13:48:30","stars":5,"text_representativeness":0.9230204820632935,"text_excerpt":"Love going to Orleans Coffee. They are conveniently located across from Touro Infirmary- easy to swing by if you're working or visiting the hospital and a great spot to grab a coffee or tea whilst walking down St. Charles. The staff is friendly. The beverages are on point. And they have fresh treats from local bakeries/vendors like bagels from Bagel Boy. The space is small and cozy. They have one tiny table inside, and few on the side walk and a small bit ledge seating by the window. So if you're looking for a spot to grab coffee on the go, read a book outside, or just chat with one friend outside this is a great spot. But definitely not a place to bring a laptop and really crank out work..."},{"business_id":"9Ip7jPc0L8BfqwAYa7Lqzg","review_id":"iiFiTQohAvKjcAPqFbtkgQ","date":"2020-11-24T03:39:00","stars":4,"text_representativeness":0.9070304036140442,"text_excerpt":"Great place for coffee and breakfast to go. The space really is just a coffee bar. The service was great. They gave me a recommendation and heated up my pastry for me. There was a good selection of pastries too. There are a few, small tables and chairs outside for you to enjoy your breakfast. I'll be coming back to enjoy this place on a nice day."},{"business_id":"9Ip7jPc0L8BfqwAYa7Lqzg","review_id":"NZygOZZdnFZ4j50jQqk-Wg","date":"2016-12-16T22:48:11","stars":4,"text_representativeness":0.898093581199646,"text_excerpt":"What a cute little addition to the Touro area! I dont know how new it actually is, but it is to me! Cute bohemian interior and a totally welcoming atmosphere. If you do not drink coffee (I certainly don't) they have a baller tea selection. They give you big cups and this place would be perfectly cozy if they had a fireplace and a puppy."}],"visual":[]},"notebook_case":null}
