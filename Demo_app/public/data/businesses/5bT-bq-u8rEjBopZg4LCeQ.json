l_business_count":0}],"history":[{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"American (Traditional), Bars, Cajun/Creole, Nightlife, Restaurants","shared_category_count":5},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"American (Traditional), Bars, Nightlife, Pubs, Restaurants","shared_category_count":5},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Bars, Nightlife, Pubs, Restaurants","shared_category_count":4},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Bars, Nightlife, Restaurants","shared_category_count":3},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"Bars, Nightlife","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"5bT-bq-u8rEjBopZg4LCeQ","review_id":"KhV_cLUM7i4LgPIeQTAUqg","date":"2010-10-11T23:02:30","stars":5,"text_representativeness":0.9405219554901123,"text_excerpt":"This was the most entertaining dining experience I had in NOLA. The bartender was very friendly and amusing and the clientele was very funny. How? Eh, just take my word for it. I was there a couple hangovers ago, so my memory isn't exactly perfect in regards to Dry Dock. I'll just say this much: the place has a very local vibe to it. Other highlights include: 1. The alligator sausage. Quite tasty, highly recommend getting for a snack or appetizer. 2. Getting a free beer sample. The bartender thought I might not like a certain beer and she turned out to be right. Saved me from paying to experiment. 3. That same bartender hooked me up with a free beer after forgetting to put in my order for..."},{"business_id":"5bT-bq-u8rEjBopZg4LCeQ","review_id":"IJBGF3DmA1PJETMOGBLPUg","date":"2021-02-22T19:42:54","stars":4,"text_representativeness":0.9361967444419861,"text_excerpt":"This is probably the first place you'll see stepping off the Canal Street - Algiers Ferry, so it gets plenty of traffic from folks coming over for the day. Dry Dock is good enough as long as you bring the right expectations. The place is half bar half cafe, and they offer what you'd expect; Various fried seafood plates, hamburgers, po-boys, etc. I had a shrimp po-boy that was tasty enough, and honestly better than my first impressions of the bar interior. Also, it's worth noting that they have fairly late hours compared to other places in the area. It's a great spot for a greasy plate, and a few cold beers"},{"business_id":"5bT-bq-u8rEjBopZg4LCeQ","review_id":"9bUlMPAh6OE8GXvERE-xIg","date":"2014-05-28T22:54:10","stars":4,"text_representativeness":0.9353145360946655,"text_excerpt":"I am not rating the food because of a short ferry schedule, but their menu has good prices and variety. Had a Sex on the Levee per the bartender suggestion. It was very fruity and tasty. BEST prices I've found in NOLA so far. Or Algeirs. Whatever.... I can see the city from here."}],"visual":[{"business_id":"5bT-bq-u8rEjBopZg4LCeQ","photo_id":"KHfGF5jWqZT_HV55oEIHtQ","label":"inside","image_url":"/photos/KHfGF5jWqZT_HV55oEIHtQ.jpg","visual_representativeness":0.8938129544258118},{"business_id":"5bT-bq-u8rEjBopZg4LCeQ","photo_id":"zZjehIS3XNHw7hrEQ70E-Q","label":"outside","image_url":"/photos/zZjehIS3XNHw7hrEQ70E-Q.jpg","visual_representativeness":0.88288