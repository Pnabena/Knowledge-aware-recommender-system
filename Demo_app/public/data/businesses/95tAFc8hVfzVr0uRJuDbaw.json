"selected_image_count":2,"label_diversity":2,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Discount Store","historical_business_count":0},{"category":"Department Stores","historical_business_count":0},{"category":"Fashion","historical_business_count":0},{"category":"Shopping","historical_business_count":0},{"category":"Grocery","historical_business_count":0},{"category":"Drugstores","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"95tAFc8hVfzVr0uRJuDbaw","review_id":"ikGydLc7GUlAb5m74tG82g","date":"2019-05-11T00:37:02","stars":4,"text_representativeness":0.9141262173652649,"text_excerpt":"I normally don't shop at Walmart because of long lines. But like this store's location. It is a very easy drive for me. It seems bigger than Tchoupitoulas store, but it is pretty much the same supercenter. You can buy groceries, clothes, cosmetics, household items, garden supplies, kitchen stuff etc- the usual. I'm lucky with my schedule I can shop at daytime on a weekday. I made a mistake of going to the store in the evening. I forgot how slow Walmart registers work.... If you can, avoid evenings and weekends. You'll spend an hour in the line."},{"business_id":"95tAFc8hVfzVr0uRJuDbaw","review_id":"VOSHx74EHYjw70JPpq7XFw","date":"2021-04-18T03:03:20","stars":5,"text_representativeness":0.908232569694519,"text_excerpt":"This is one of the smaller Walmart in the Greater New Orleans area. Some would say its in an area that is recovering. What I love is the fact that this location has security and a very large parking lot which my favorite features. If you are like me, I love to park my car away from others cause we all know that people can be made disrespectful when it comes to opening up their doors and knicking your car. Even the business itself is not that of a true Super Walmart, it still has descent amount of space. Love coming here cause they have some better desserts in the marketplace compared to other locations."},{"business_id":"95tAFc8hVfzVr0uRJuDbaw","review_id":"O4sGYGuyR8pq4RvbRy6snQ","date":"2016-09-03T06:16:31","stars":5,"text_representativeness":0.9023959636688232,"text_excerpt":"This Walmart is smaller than most but it still packs a punch, in a good way. The lines are always long but the cashiers keep them flowing. There's always someone nearby to assist when searching for items. The aisles are kept exceptionally neat. The prices are cool. The Walmart saving catcher also makes shopping really fun. My visit here was a pleasant one."}],"visual":[{"business_id":"95tAFc8hVfzVr0uRJuDbaw","photo_id":"mXz8CSpvk0VvLyr1uro3dg","label":"outside","image_url":"/photos/mXz8CSpvk0VvLyr1uro3dg.jpg","visual_representativeness":0.9102040529251099},{"business_id":"95tAFc8hVfzVr0uRJuDbaw","photo_id":"0ZcIxzqNIuGX3bEQrjlq1g","label":"inside","image_url":"/photos/0ZcIxzqNIuGX3bEQrjlq1g.jpg","visual_representativeness":0.9102038741111755}]},"notebook_case":null}
