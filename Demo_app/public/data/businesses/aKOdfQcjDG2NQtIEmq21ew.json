:1507,"business_id":"aKOdfQcjDG2NQtIEmq21ew","nv_rank":431,"mm_rank":297,"nv_score":0.5476312637329102,"mm_score":0.6259714961051941,"rank_movement":134,"has_visual_feature":true,"name":"Urban South Brewery","address":"1645 Tchoupitoulas St","city":"New Orleans","state":"LA","postal_code":"70130","stars":4.5,"review_count":186,"categories":["Breweries","Food"],"is_open":true},"evidence":{"source":"frozen-model","summary":{"business_id":"aKOdfQcjDG2NQtIEmq21ew","user_id":"D76EFdD5F7XoIIyQmWTQhA","user_row":3279,"nv_rank":431,"mm_rank":297,"target_category_support_fraction":0.5,"selected_image_count":5,"label_diversity":3,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Breweries","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food","shared_category_count":1},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Food","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"","shared_category_count":0},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"","shared_category_count":0},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"","shared_category_count":0},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"","shared_category_count":0},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"","shared_category_count":0},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"aKOdfQcjDG2NQtIEmq21ew","review_id":"jvU9W0VzkvUbBuHOYURSmA","date":"2016-05-23T19:07:13","stars":4,"text_representativeness":0.9433473944664001,"text_excerpt":"This is another awesome addition to the New Orleans beer scene. The location itself is no frills: it's basically in a warehouse. The cool thing about the place is that there is a lot of wide open space and the \"family style\" tables allow you to get to know your fellow beer lovers. My one tiny complaint about the location is that I know it is gonna be really hot in there once summer hits. They have a few big fans going, but I can imagine you are going to have to come ready to sweat once the heat kicks up. I've had a few beers here. The two times I've been I've gravitated towards the Charming Wit, only because it's not super heavy and it's nice to sip on a warm day. I am eager to go back an..."},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","review_id":"6G3eStz3bTsgzrvDNY1uJA","date":"2017-06-30T19:05:58","stars":4,"text_representativeness":0.9414916634559631,"text_excerpt":"After trying out some Urban South brews at Jax Brewhouse, we knew this was a must see (taste?) before heading home. We were also previously at NOLA Brewing down the road so it was a nice progression of day-drinking on our way to the airport. Thanks, Tchoupitoulas St.! Urban South is a big warehouse that doesn't even look like it's occupied until you get to the loading dock/entrance. Once inside, it's a pretty legit place to kick back and enjoy a beer or hang out with your friends. There's a bunch of picnic tables to sit at, some bags, a giant jenga table, some old school arcade games, a basketball game (I swear I remember that but I WAS drinking so don't take my word for it), and even som..."},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","review_id":"Ftzi9Wyozj_K86lWwlvfQw","date":"2020-06-28T22:37:41","stars":4,"text_representativeness":0.938961386680603,"text_excerpt":"Had a nice experience here this weekend there was a good selection of beer and ample space for social distancing. I'm giving it four stars because I did feel like I was in a giant garage, there wasn't a food menu and can't say it was my favorite brewery. However great beer - recommend the grapefruit IPA !"}],"visual":[{"business_id":"aKOdfQcjDG2NQtIEmq21ew","photo_id":"qyCaU4vVCnxpcqCsiQBuZw","label":"inside","image_url":"/photos/qyCaU4vVCnxpcqCsiQBuZw.jpg","visual_representativeness":0.8876456618309021},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","photo_id":"DH9XumfNMf4qTfwJ239Whg","label":"outside","image_url":"/photos/DH9XumfNMf4qTfwJ239Whg.jpg","visual_representativeness":0.8864430785179138},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","photo_id":"K-ckH8MXhwJLKCqBuKbgfQ","label":"drink","image_url":"/photos/K-ckH8MXhwJLKCqBuKbgfQ.jpg","visual_representativeness":0.8410425782203674},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","photo_id":"fHktwYPHnzScFxKBmbnJ8g","label":"inside","image_url":"/photos/fHktwYPHnzScFxKBmbnJ8g.jpg","visual_representativeness":0.8339090943336487},{"business_id":"aKOdfQcjDG2NQtIEmq21ew","photo_id":"45bluwTy3hOcx_rd_BOrRg","label":"drink","image_url":"/photos/45bluwTy3hOcx_rd_BOrRg.jpg","visual_representativeness":0.829674482345581}]},"notebook_case":null}
