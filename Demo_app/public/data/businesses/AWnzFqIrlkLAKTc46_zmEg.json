Z2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants, Seafood","shared_category_count":2},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Cajun/Creole, Restaurants","shared_category_count":2},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants, Southern","shared_category_count":2},{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"AWnzFqIrlkLAKTc46_zmEg","review_id":"KZHCYlpmF0CowLZcs44X9A","date":"2019-09-14T12:57:54","stars":4,"text_representativeness":0.9317525625228882,"text_excerpt":"I loved this place for lunch. My daughter and sister actually, came to Mena's 3 days straight for breakfast/lunch because the food was amazing! Twice, my party and I ordered the fried chicken that came with fries, red beans and/or lima beans with sausage. I couldn't tell which one I enjoyed the most, the beans or the chicken. Ther chicken was fried, seasoned perfectly, and very tender. Beautiful. We all loved and raved about it. The red beans & rice are delicious and so are the lima beans. The staff was really friendly and attentive and the service was good. We did have a fairly long wait for fresh chicken on our first visit but, it was all worth it. It's a really small establishment and ..."},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","review_id":"boHHFk-PxMTkI5s3PxG5UA","date":"2018-10-26T14:05:41","stars":4,"text_representativeness":0.9307503700256348,"text_excerpt":"First time At Mena's Palace and it's a very good breakfast spot. We had the omelette and the Cajun Hash Browns. Very good stuff."},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","review_id":"JiE2NgQlMN34rPhMu0ixRQ","date":"2016-03-19T16:13:30","stars":4,"text_representativeness":0.923906683921814,"text_excerpt":"Came here for breakfast after a night out. I had the double egg sandwich with bacon plus a side of grits. The other ladies had the veggie omelet, and western omelet. It didn't take long for the food to arrive. I enjoyed my sandwich and my side of grits were truly a side of grits. The western omelet was good. The mix is already made so don't ask for it with no tomatoes. Just pick them out. Our waitress was very pleasant and attentive. She made sure our glasses stayed full and we didn't want for anything. This place may be small, but the love is here. It seems like everybody knows everyone and they just break out in conversation. Very popular and people were flooding in and out. I would lov..."}],"visual":[{"business_id":"AWnzFqIrlkLAKTc46_zmEg","photo_id":"bVF6x9qu3nNQdwAvAvMF4g","label":"inside","image_url":"/photos/bVF6x9qu3nNQdwAvAvMF4g.jpg","visual_representativeness":0.8220343589782715},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","photo_id":"M7tqfwkeHHYuzDy9pJsOfQ","label":"food","image_url":"/photos/M7tqfwkeHHYuzDy9pJsOfQ.jpg","visual_representativeness":0.816450834274292},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","photo_id":"DWLwm0ZfQ3WhVz7BqrJlQQ","label":"inside","image_url":"/photos/DWLwm0ZfQ3WhVz7BqrJlQQ.jpg","visual_representativeness":0.7893578410148621},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","photo_id":"2iDgKYLDAcRZCZWFKDX2Bw","label":"menu","image_url":"/photos/2iDgKYLDAcRZCZWFKDX2Bw.jpg","visual_representativeness":0.7712369561195374},{"business_id":"AWnzFqIrlkLAKTc46_zmEg","photo_id":"0ktQmoWtu-oS7xUN2twDhQ","label":"outside","image_url":"/photos/0ktQmoWtu-oS7xUN2twDhQ.jpg","visual_representativeness":0.7648638486862183}]},"notebook_case":null}
