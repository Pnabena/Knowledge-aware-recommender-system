,"target_visual_score_gain":null,"target_visual_rank_gain":null,"competitive_visual_rank_effect":null},"category_overlap":[{"category":"Restaurants","historical_business_count":8},{"category":"Coffee & Tea","historical_business_count":1},{"category":"Cafes","historical_business_count":0},{"category":"Food","historical_business_count":3}],"history":[{"business_id":"kdqoDMuvyNedsouc1i33vQ","name":"Araña Taqueria y Cantina","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"pKykk7lnD6Tf9wSzJYRyJA","name":"Starbucks","shared_categories":"Coffee & Tea, Food","shared_category_count":2},{"business_id":"_Bi9kN_eR75G1eqIl7S3pA","name":"The Bulldog","shared_categories":"Food, Restaurants","shared_category_count":2},{"business_id":"TMBbCDQG6bENJoQSST0XiA","name":"Brigtsen's Restaurant","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"_C7QiQQc47AOEv4PE3Kong","name":"Commander's Palace","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"mhrW9O0O5hXGXGnEYBVoag","name":"Jacques-Imo's Cafe","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"8KnMSrMuTI2AtHZ2LOI8OQ","name":"Maurepas Foods","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"Zi-F-YvyVOK0k5QD7lrLOg","name":"Muriel's Jackson Square","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"JhpRI9m71ybWHkAqRdL0Tg","name":"The Avenue Pub","shared_categories":"Restaurants","shared_category_count":1},{"business_id":"AU-B663F3MPO7W-goWwwXA","name":"B Mac's","shared_categories":"","shared_category_count":0}],"text":[{"business_id":"IqocLKWSjSCCRakMon52dA","review_id":"75lAwLmCv9aVnHne8mpvpg","date":"2016-04-28T04:10:52","stars":5,"text_representativeness":0.9624115228652954,"text_excerpt":"I love this Starbucks. If nothing else, go here just to look at the decor. It's so cool! The look and feel is totally New Orleans. The bathroom had such amazing light fixtures. The staff was friendly and the line moved quickly. The location gets busy so be prepared for some sort of wait- it's in a high traffic area. They had a good playlist kicking too which definitely helps. If I were local this would be the only location I shop at."},{"business_id":"IqocLKWSjSCCRakMon52dA","review_id":"t_rwVztou1cBP_Vxk9ihtw","date":"2013-12-17T14:26:10","stars":4,"text_representativeness":0.932698130607605,"text_excerpt":"This Starbucks is gorgeous, the renovations in the building are fantastic. I am so happy it is opened as it is only a block from my office. Starbucks is Starbucks is Starbucks. The only thing special about this one is that it is a Starbucks reserve location and the sell the special reserve star blends. The pastry and dessert case is spectacular and the display of the food in there is quite pleasing to the eye, luckily Starbucks likes to post the calorie count on their baked goods which usually causes me to pass up those types of treats, especially when I know my delicious salted caramel mocha has about 500 calories in it. Whatevs! I need it sometimes, peppermint mocha!! Where have you bee..."},{"business_id":"IqocLKWSjSCCRakMon52dA","review_id":"IqPSMponP_bgwTv8KdRUPg","date":"2016-03-23T15:19:43","stars":5,"text_representativeness":0.9289057850837708,"text_excerpt":"This is my favorite Starbucks in town! Even though its the most crowded due to the location and tourists, my drinks are ALWAYS perfect and my breakfast sandwich is always warm throughout! Because of the crowds/line here, I prefer to submit a mobile order and they always complete it fully and quickly. I come before work around 7:30-8:00 am and park on St. Charles (its free before 8am). The music they play is always enjoyable, sometimes corny, but always makes you feel good! From Disney songs to Backstreet Boys to Elton John, you always want to sing along. Its a great way to start my day."}],"visual":[{"business_id":"IqocLKWSjSCCRakMon52dA","photo_id":"cgj2E4FaEo7bdK0V9_ePlA","label":"inside","image_url":"/photos/cgj2E4FaEo7bdK0V9_ePlA.jpg","visual_representativeness":0.9595369100570679},{"business_id":"IqocLKWSjSCCRakMon52dA","photo_id":"d-zBH1MpE1yyGt9EunYXXA","label":"inside","image_url":"/photos/d-zBH1MpE1yyGt9EunYXXA.jpg","visual_representativeness":0.9595369100570679}]},"notebook_case":null}
